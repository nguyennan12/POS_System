# ---- PostgreSQL ----
POSTGRES_DB=pos_dev
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change_me_strong_password!
POSTGRES_PORT=5432
API_PORT=5000
SCANNER_PUBLIC_BASE_URL=http://YOUR_LAN_IP:5000
REDIS_PORT=6379

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_password

# ---- JWT & Security ----
JWT_SECRET=change_me_min_32_chars_random_secret_key
PIN_LOOKUP_SECRET=change_me_min_32_chars_random_secret_key

# ---- Groq AI (API key is consumed by the backend only) ----
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Observability (Loki Logs via Grafana Alloy Collector) ----
SERILOG_LOKI_URL=http://global_alloy:3100
