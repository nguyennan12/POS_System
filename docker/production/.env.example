# ---- PostgreSQL ----
POSTGRES_DB=pos_prod
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change_me_strong_production_password!
POSTGRES_PORT=5432
SCANNER_PUBLIC_BASE_URL=https://pos.example.com

# ---- Redis ----
REDIS_PASSWORD=change_me_strong_redis_password!

# ---- JWT & Security ----
JWT_SECRET=change_me_min_32_chars_random_secret_key_production
PIN_LOOKUP_SECRET=change_me_min_32_chars_random_secret_key_production

# ---- Groq AI (set the real key in the production secret store) ----
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Observability (Loki Logs via Grafana Alloy Collector) ----
SERILOG_LOKI_URL=http://global_alloy:3100
