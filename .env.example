# ---- PostgreSQL ----
POSTGRES_DB=pos_dev
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change_me_strong_password!
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_password

# ---- JWT ----
JWT_SECRET=change_me_min_32_chars_random_secret_key

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ---- QR payments (Payments__* are native .NET environment configuration keys) ----
# SignalR browser origins: empty by default; set exact origins only when needed.
# PaymentHub__AllowedOrigins__0=https://your-client.example
# TODO T58: move non-secret settings to SystemConfigs. Set secrets via user-secrets/environment.
Payments__Qr__LifetimeMinutes=15
Payments__MoMo__ApiBaseUrl=https://test-payment.momo.vn/
Payments__MoMo__PartnerCode=
Payments__MoMo__AccessKey=
Payments__MoMo__SecretKey=
Payments__MoMo__IpnUrl=https://your-public-api.example/api/v1/payments/webhook/momo
Payments__MoMo__RedirectUrl=https://your-client.example/payment-result
Payments__MoMo__ReplayToleranceSeconds=300
Payments__VietQR__BankBin=
Payments__VietQR__AccountNo=
Payments__VietQR__AccountName=
Payments__VietQR__WebhookSecret=
Payments__VietQR__ExpectedGateway=
# Temporary VietQR callback: X-VietQR-Signature = hex(HMAC-SHA256(secret, exact raw HTTP body)).
