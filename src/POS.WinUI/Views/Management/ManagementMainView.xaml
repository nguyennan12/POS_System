<UserControl x:Class="POS.WinUI.Views.Management.ManagementMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:POS.WinUI.Views.Management.Components"
             xmlns:tabs="clr-namespace:POS.WinUI.Views.Management.Tabs"
             xmlns:dashboard="clr-namespace:POS.WinUI.Views.Dashboard"
             xmlns:dashVm="clr-namespace:POS.WinUI.ViewModels.Dashboard"
             xmlns:mgmt="clr-namespace:POS.WinUI.ViewModels.Management"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Focusable="True">

    <UserControl.Resources>
        <!-- 1. Màn hình phân hệ Dashboard chuyên biệt -->
        <DataTemplate DataType="{x:Type dashVm:DashboardViewModel}">
            <dashboard:DashboardView/>
        </DataTemplate>

        <!-- 2. Mẫu khung màn hình chung chuẩn MVVM cho tất cả các Tab còn lại -->
        <DataTemplate DataType="{x:Type mgmt:ManagementTabViewModelBase}">
            <tabs:ManagementGenericTabView/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenPosCashierCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleSidebarCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="{StaticResource InputBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Body (Sidebar + Dynamic Sub-View Content) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ 1. TOP HEADER ════════════════════ -->
        <components:ManagementHeaderBar Grid.Row="0"/>

        <!-- ════════════════════ 2. MAIN BODY ═════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột 0: Sidebar Navbar (Thu/Phóng linh hoạt) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Cột 1: Vùng làm việc chính hiển thị Sub-View -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <components:ManagementSidebar Grid.Column="0"/>

            <!-- Main Work Area -->
            <Grid Grid.Column="1" Background="{StaticResource InputBackgroundBrush}">
                <Grid.RowDefinitions>
                    <!-- Row 0: Breadcrumb -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Sub-view Container động chuyển đổi theo SelectedTab -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Breadcrumb navigation -->
                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            Margin="28,16,28,0"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Home24" 
                                   FontSize="15" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   Margin="0,0,8,0" 
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="Trang chủ" 
                               FontSize="13" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="/" 
                               FontSize="13" 
                               Foreground="{StaticResource TextPlaceholderBrush}" 
                               Margin="8,0" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveTabTitle}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Vùng hiển thị Sub-View của Tab được chọn -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentTabViewModel}" 
                                    HorizontalContentAlignment="Stretch" 
                                    VerticalContentAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ════════════════════ 3. BOTTOM FOOTER ════════════════════ -->
        <components:ManagementFooterBar Grid.Row="2"/>
    </Grid>
</UserControl>
