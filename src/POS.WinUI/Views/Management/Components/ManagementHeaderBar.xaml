<UserControl x:Class="POS.WinUI.Views.Management.Components.ManagementHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Height="64">

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,0">
        <Grid>
            <!-- ── Left: Nút thu phóng Sidebar, Chi nhánh & Ca làm việc ─────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                
                <!-- Nút Thu gọn / Mở rộng Sidebar -->
                <Button Command="{Binding ToggleSidebarCommand}"
                        Width="36" Height="36"
                        Margin="0,0,12,0"
                        Padding="0"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Thu gọn / Mở rộng Sidebar (Ctrl+B)"
                        Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HBtnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="9">
                                <ui:SymbolIcon Symbol="Navigation24" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HBtnBorder" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Badge / Selector Chi nhánh -->
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BuildingShop24" 
                                       FontSize="16" 
                                       Foreground="{StaticResource PrimaryBrush}" 
                                       Margin="0,0,8,0" 
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StoreName}" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                        <ui:SymbolIcon Symbol="ChevronDown24" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="8,0,0,0" 
                                       VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Badge Thông tin Ca làm việc -->
                <Border Background="#FEF3C7"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,7"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Clock24" 
                                       FontSize="14" 
                                       Foreground="#D97706" 
                                       Margin="0,0,6,0" 
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ShiftName}" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="#92400E" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Right: Thông báo, CTA Bán hàng & User Profile ─── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Nút Chuông Thông báo -->
                <Button Padding="0"
                        Margin="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Thông báo hệ thống">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BellBorder" 
                                    Width="38" 
                                    Height="38" 
                                    CornerRadius="10" 
                                    Background="Transparent">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Alert24" 
                                                   FontSize="20" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    <!-- Badge số thông báo chưa đọc -->
                                    <Border Width="16" 
                                            Height="16" 
                                            CornerRadius="8" 
                                            Background="{StaticResource DangerBrush}" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top" 
                                            Margin="0,-5,-5,0">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" 
                                                   FontSize="9.5" 
                                                   FontWeight="Bold" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BellBorder" Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Nút CTA Màn hình Bán hàng (Đã định dạng lại, bỏ chữ [F1]) -->
                <Button Height="40"
                        Margin="16,0,16,0"
                        Command="{Binding OpenPosCashierCommand}"
                        ToolTip="Chuyển sang màn hình bán hàng (Phím tắt F1)"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CtaBorder"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Padding="16,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                      Color="{StaticResource BrandPrimaryColor}" 
                                                      Opacity="0.3" 
                                                      ShadowDepth="2" 
                                                      Direction="270"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Cart24" 
                                                   FontSize="18" 
                                                   Foreground="White" 
                                                   Margin="0,0,8,0" 
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="Màn hình Bán hàng" 
                                               FontSize="13.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="White" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cụm Tài khoản Người dùng (Profile Pill) -->
                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="0" 
                        Cursor="Hand">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Thông tin cá nhân" Icon="{ui:SymbolIcon Symbol=Person24}"/>
                            <MenuItem Header="Đổi mật khẩu" Icon="{ui:SymbolIcon Symbol=LockClosed24}"/>
                            <Separator/>
                            <MenuItem Header="Đăng xuất" 
                                      Command="{Binding LogoutCommand}" 
                                      Icon="{ui:SymbolIcon Symbol=SignOut24}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ProfileBorder"
                                    Background="Transparent"
                                    CornerRadius="10"
                                    Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Avatar initials -->
                                    <Border Width="36" 
                                            Height="36" 
                                            CornerRadius="18" 
                                            Background="#FFEDD5"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding AvatarInitials}" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#C2410C" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Tên & Vai trò -->
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding EmployeeName}" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding RoleName}" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <!-- Mũi tên xổ xuống -->
                                    <ui:SymbolIcon Symbol="ChevronDown24" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource TextMutedBrush}" 
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ProfileBorder" Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
