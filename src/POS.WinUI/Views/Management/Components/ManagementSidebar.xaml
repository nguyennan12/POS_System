<UserControl x:Class="POS.WinUI.Views.Management.Components.ManagementSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ClipToBounds="True">

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="250"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="68" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="250" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Logo & Header Brand / Toggle -->
                <RowDefinition Height="64"/>
                <!-- Row 1: Section Header / Divider -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Navigation Tab Items -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 1. Brand Logo & Header / Nút thu gọn ──────────────────── -->
            <Border Grid.Row="0" Padding="14,12" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Chế độ Mở rộng (Expanded): Logo + Tên + Nút thu gọn -->
                    <Grid Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo -->
                        <Image Grid.Column="0"
                               Source="/Assets/logo.png" 
                               Width="36" 
                               Height="36" 
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               VerticalAlignment="Center"/>

                        <!-- Tên thương hiệu -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="OraPOS" 
                                       FontSize="17" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       LineHeight="18"/>
                            <TextBlock Text="Hệ thống Quản lý" 
                                       FontSize="11" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Nút thu gọn Sidebar -->
                        <Button Grid.Column="2"
                                Command="{Binding ToggleSidebarCommand}"
                                Width="28" Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Thu gọn thanh điều hướng (Ctrl+B)"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Chế độ Thu gọn (Collapsed): Logo có thể bấm để mở rộng -->
                    <Button Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseBoolToVis}}"
                            Command="{Binding ToggleSidebarCommand}"
                            Width="38" Height="38"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Mở rộng thanh điều hướng (Ctrl+B)"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="HoverBorder" CornerRadius="8" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <Image Source="/Assets/logo.png" Width="34" Height="34"
                                           RenderOptions.BitmapScalingMode="HighQuality" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverBorder" Property="Background" Value="#15EB7F0E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 2. Tiêu đề Phân mục ────────────────────────────── -->
            <!-- Khi Mở rộng -->
            <TextBlock Grid.Row="1" 
                       Text="KHÔNG GIAN LÀM VIỆC" 
                       FontSize="11" 
                       FontWeight="Bold" 
                       Foreground="#94A3B8" 
                       Margin="16,18,16,8"
                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>

            <!-- Khi Thu gọn (Đường phân cách mỏng) -->
            <Border Grid.Row="1" 
                    Height="1" 
                    Background="{StaticResource InputBorderBrush}" 
                    Margin="10,12,10,8" 
                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseBoolToVis}}"/>

            <!-- ── 3. Danh sách Menu Tabs Điều hướng ─────────────── -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0">
                <ItemsControl ItemsSource="{Binding NavTabs}" Margin="8,4,8,16" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="44"
                                    Margin="0,2"
                                    Padding="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="{Binding Title}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- Khung Tab: bo góc 12px (rounded-xl), KHÔNG VIỀN (BorderThickness=0) -->
                                        <Border x:Name="TabItemBorder"
                                                CornerRadius="12"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch">
                                            <Grid>
                                                <!-- Vạch cam bên trái khi được chọn -->
                                                <Border x:Name="LeftAccentBar"
                                                        Width="4"
                                                        Margin="0,8,0,8"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Stretch"
                                                        CornerRadius="0,2,2,0"
                                                        Background="Transparent"/>

                                                <!-- Nội dung Expanded: Icon + Text -->
                                                <StackPanel x:Name="ExpandedPanel"
                                                            Orientation="Horizontal" 
                                                            VerticalAlignment="Center" 
                                                            Margin="12,0,10,0">
                                                    <ui:SymbolIcon x:Name="ItemIcon"
                                                                   Symbol="{Binding Icon}"
                                                                   FontSize="19"
                                                                   Foreground="#64748B"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"/>

                                                    <TextBlock x:Name="ItemText"
                                                               Text="{Binding Title}"
                                                               FontSize="13.5"
                                                               FontWeight="Medium"
                                                               Foreground="#475569"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Nội dung Collapsed: Icon căn giữa -->
                                                <ui:SymbolIcon x:Name="ItemIconCollapsed"
                                                               Symbol="{Binding Icon}"
                                                               FontSize="20"
                                                               Foreground="#64748B"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <!-- Chế độ Collapsed: ẩn panel chữ, hiện icon giữa -->
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                <Setter TargetName="ExpandedPanel" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="ItemIconCollapsed" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                            <!-- Trạng thái Rê chuột (Hover khi chưa chọn): bg-slate-100 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabItemBorder" Property="Background" Value="#F1F5F9"/>
                                                <Setter TargetName="ItemText" Property="Foreground" Value="#0F172A"/>
                                                <Setter TargetName="ItemIcon" Property="Foreground" Value="#334155"/>
                                                <Setter TargetName="ItemIconCollapsed" Property="Foreground" Value="#334155"/>
                                            </MultiDataTrigger>

                                            <!-- Trạng thái Đang chọn (Active Tab: bg-[#FFF7ED], KHÔNG VIỀN, vạch cam #EB7F0E, chữ bold) -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="TabItemBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                <Setter TargetName="LeftAccentBar" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="ItemIcon" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="ItemIconCollapsed" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="ItemText" Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
