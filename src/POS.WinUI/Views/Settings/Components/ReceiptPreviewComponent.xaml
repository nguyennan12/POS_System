<UserControl x:Class="POS.WinUI.Views.Settings.Components.ReceiptPreviewComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="24,20">
        <StackPanel>
            <!-- Tiêu đề Xem trước & Khổ giấy -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Eye24" FontSize="16" Foreground="#2563EB" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Loc[settings.preview_title]}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <!-- Badge khổ giấy -->
                <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{Binding PrinterModel, StringFormat='{}Khổ in: {0}'}"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                </Border>
            </Grid>

            <!-- Khung cuộn chứa tờ hóa đơn nhiệt -->
            <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Width="{Binding PreviewWidth}" Background="#FFFFFF"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,20"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.08"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Biểu tượng và Tên cửa hàng -->
                        <Border Width="34" Height="34" CornerRadius="8" Background="#FFF7ED" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="BuildingShop24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding StoreName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <TextBlock Text="{Binding ReceiptHeader}" FontSize="11" Foreground="#475569"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>

                        <!-- Phân cách nét đứt -->
                        <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
                                   FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Tiêu đề hóa đơn -->
                        <TextBlock Text="{Binding Loc[settings.preview_bill_title]}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                   TextAlignment="Center" Margin="0,0,0,6"/>

                        <!-- Thông tin thời gian và số hóa đơn -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ngày: 17/09/2026 15:42" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="Số: HD-000123" FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
                                   FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" Margin="0,0,0,6"/>

                        <!-- Header bảng sản phẩm -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Grid.Column="1" Text="Tên sản phẩm" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Grid.Column="2" Text="SL" FontSize="10.5" FontWeight="Bold" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Đơn giá" FontSize="10.5" FontWeight="Bold" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="Thành tiền" FontSize="10.5" FontWeight="Bold" Foreground="#334155" TextAlignment="Right"/>
                        </Grid>

                        <!-- Dòng món 1 -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1" FontSize="10.5" Foreground="#334155"/>
                            <TextBlock Grid.Column="1" Text="Coca Cola 330ml" FontSize="10.5" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="2" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="12,000" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="24,000" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                        </Grid>

                        <!-- Dòng món 2 -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2" FontSize="10.5" Foreground="#334155"/>
                            <TextBlock Grid.Column="1" Text="Bánh Croissant" FontSize="10.5" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="1" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="15,000" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="15,000" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                        </Grid>

                        <!-- Dòng món 3 -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="3" FontSize="10.5" Foreground="#334155"/>
                            <TextBlock Grid.Column="1" Text="Pepsi 330ml" FontSize="10.5" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="1" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="11,500" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="11,500" FontSize="10.5" Foreground="#334155" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
                                   FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" Margin="0,6,0,6"/>

                        <!-- Tạm tính và Tổng cộng -->
                        <Grid Margin="0,2,0,2">
                            <TextBlock Text="Tạm tính:" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="50,500 đ" FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <TextBlock Text="Giảm giá:" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="0 đ" FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="TỔNG CỘNG:" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="50,500 đ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
                                   FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" Margin="0,4,0,8"/>

                        <!-- Tiện ích in bill: VietQR + WiFi -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Khối QR Thanh toán -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Loc[settings.vietqr_pay]}" FontSize="10" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Center"/>
                                <Border Width="56" Height="56" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,4,0,2">
                                    <ui:SymbolIcon Symbol="QrCode24" FontSize="36" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Loc[settings.vietqr_scan]}" FontSize="9" Foreground="#64748B" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Khối WiFi miễn phí -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Wifi124" FontSize="11" Foreground="#2563EB" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Loc[settings.free_wifi]}" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding WifiSsid, StringFormat='{}Tên/SSID: {0}'}" FontSize="9.5" Foreground="#475569" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding WifiPassword, StringFormat='{}Pass: {0}'}" FontSize="9.5" Foreground="#475569" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
                                   FontSize="11" Foreground="#CBD5E1" TextAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Lời cảm ơn và Chân trang -->
                        <TextBlock Text="{Binding Loc[settings.thank_you]}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ReceiptFooter}" FontSize="11" Foreground="#475569"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
