<UserControl x:Class="POS.WinUI.Views.Settings.Components.StoreInfoSettingComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel>
        <!-- ════════════════════ 1. THÔNG TIN CỬA HÀNG & DOANH NGHIỆP ════════════════════ -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,0,0,16">
            <StackPanel>
                <!-- Tiêu đề thẻ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#FFF7ED" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="BuildingShop24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[settings.store_info_title]}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding Loc[settings.store_info_subtitle]}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Grid 2 cột trường dữ liệu -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái -->
                    <StackPanel Grid.Column="0">
                        <!-- Tên cửa hàng -->
                        <TextBlock Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155">
                            <Run Text="{Binding Loc[settings.store_name], Mode=OneWay}"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0" Margin="0,0,0,16">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="BuildingShop24" FontSize="16" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding StoreName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Số điện thoại Hotline -->
                        <TextBlock Text="{Binding Loc[settings.hotline]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0" Margin="0,0,0,16">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Call24" FontSize="16" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Địa chỉ cửa hàng -->
                        <TextBlock Text="{Binding Loc[settings.store_address]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Location24" FontSize="16" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding StoreAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Cột phải -->
                    <StackPanel Grid.Column="2">
                        <!-- Mã số thuế -->
                        <TextBlock Text="{Binding Loc[settings.tax_code]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0" Margin="0,0,0,16">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DocumentText24" FontSize="16" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding TaxCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Email doanh nghiệp -->
                        <TextBlock Text="{Binding Loc[settings.email]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0" Margin="0,0,0,16">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Mail24" FontSize="16" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding BusinessEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Ngành hàng kinh doanh (Mặc định bán lẻ) -->
                        <TextBlock Text="{Binding Loc[settings.business_model]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle24" FontSize="16" Foreground="#10B981" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Loc[settings.business_model_val]}" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding Loc[settings.fixed]}" FontSize="11" FontWeight="Medium" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ════════════════════ 2. CẤU HÌNH HỆ THỐNG & TIỀN TỆ (BACKEND SUPPORTED) ════════════════════ -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="28,24">
            <StackPanel>
                <!-- Tiêu đề thẻ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#EFF6FF" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[settings.sys_config_title]}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding Loc[settings.sys_config_subtitle]}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Grid 3 cột cấu hình thực tế -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Múi giờ -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Loc[settings.timezone]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0">
                            <TextBox Text="{Binding Timezone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Asia/Ho_Chi_Minh (GMT+7)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Đơn vị tiền tệ -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Loc[settings.currency]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Height="46" Padding="12,0">
                            <TextBox Text="{Binding CurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CleanTextBoxStyle}" FontSize="13.5" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ISO-4217 (VND - ₫)" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Ngôn ngữ vận hành phần mềm (Chuyển đổi Tiếng Việt / English) -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{Binding Loc[settings.language]}" Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tiếng Việt -->
                            <Button Grid.Column="0" Command="{Binding SwitchLanguageCommand}" CommandParameter="vi"
                                    Height="46" Padding="6,0" Cursor="Hand" BorderThickness="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLanguage}" Value="vi">
                                                <Setter Property="Background" Value="#FFF7ED"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🇻🇳" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tiếng Việt" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- English -->
                            <Button Grid.Column="2" Command="{Binding SwitchLanguageCommand}" CommandParameter="en"
                                    Height="46" Padding="6,0" Cursor="Hand" BorderThickness="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedLanguage}" Value="en">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🇬🇧" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="English" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="Thay đổi ngôn ngữ hiển thị tức thì toàn bộ ứng dụng." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
