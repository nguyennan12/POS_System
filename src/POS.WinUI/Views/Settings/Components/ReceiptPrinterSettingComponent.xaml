<UserControl x:Class="POS.WinUI.Views.Settings.Components.ReceiptPrinterSettingComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel>
        <!-- ════════════════════ 1. MÁY IN HÓA ĐƠN NHIỆT ════════════════════ -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="26,22" Margin="0,0,0,16">
            <StackPanel>
                <!-- Tiêu đề thẻ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Print24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[settings.printer_title]}" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding Loc[settings.printer_subtitle]}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Khổ giấy in & Cổng kết nối -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Khổ giấy -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Loc[settings.printer_model]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding Loc[settings.printer_k80]}" IsChecked="{Binding IsK80, Mode=TwoWay}"
                                         Command="{Binding SelectK80Command}" FontSize="13" Foreground="#1E293B" Margin="0,0,18,0" Cursor="Hand"/>
                            <RadioButton Content="{Binding Loc[settings.printer_k58]}" IsChecked="{Binding IsK58, Mode=TwoWay}"
                                         Command="{Binding SelectK58Command}" FontSize="13" Foreground="#1E293B" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Cổng kết nối -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Loc[settings.printer_port]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                                      Height="42" FontSize="13" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Command="{Binding RefreshPortsCommand}"
                                    Width="42" Height="42" Margin="8,0,0,0" Padding="0"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                    ToolTip="Quét lại các cổng kết nối USB/COM" Cursor="Hand">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Foreground="#475569"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Tự động in & Số liên in -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:ToggleSwitch Grid.Column="0" IsChecked="{Binding AutoPrintReceipt, Mode=TwoWay}"
                                     Content="{Binding Loc[settings.auto_print]}"
                                     FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[settings.copies]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding AvailableCopies}"
                                  SelectedItem="{Binding PrintCopies, Mode=TwoWay}"
                                  Width="100" Height="40" FontSize="13"/>
                        <TextBlock Text="(1-3)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ════════════════════ 2. TIÊU ĐỀ & CHÂN TRANG HÓA ĐƠN ════════════════════ -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="26,20" Margin="0,0,0,16">
            <StackPanel>
                <!-- Tiêu đề Header -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Loc[settings.receipt_header]}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center">
                        <Run Text="{Binding HeaderCharCount}"/><Run Text="/300"/>
                    </TextBlock>
                </Grid>

                <TextBox Text="{Binding ReceiptHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="78"
                         FontSize="13" Padding="12,10"
                         BorderBrush="#CBD5E1" BorderThickness="1"
                         Background="#F8FAFC" Margin="0,0,0,16"/>

                <!-- Chân trang Footer -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Foreground="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Loc[settings.receipt_footer]}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center">
                        <Run Text="{Binding FooterCharCount}"/><Run Text="/300"/>
                    </TextBlock>
                </Grid>

                <TextBox Text="{Binding ReceiptFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                         FontSize="13" Padding="12,10"
                         BorderBrush="#CBD5E1" BorderThickness="1"
                         Background="#F8FAFC"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════ 3. MÃ QR WIFI TRÊN HÓA ĐƠN ════════════════════ -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="26,20">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="#EFF6FF" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[settings.wifi_qr_title]}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding Loc[settings.wifi_qr_subtitle]}" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </Grid>

                <!-- Input Tên mạng WiFi & Mật khẩu -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tên WiFi -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Loc[settings.wifi_ssid]}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="42" Padding="10,0">
                            <TextBox Text="{Binding WifiSsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CleanTextBoxStyle}" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Mật khẩu -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Loc[settings.wifi_password]}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="42" Padding="10,0">
                            <TextBox Text="{Binding WifiPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CleanTextBoxStyle}" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Nút tạo mã QR -->
                    <Button Grid.Column="4" Command="{Binding GenerateWifiQrCommand}"
                            Height="42" Padding="16,0" VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}" Background="#2563EB" BorderBrush="#1D4ED8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="QrCode24" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Loc[settings.generate_qr]}" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
