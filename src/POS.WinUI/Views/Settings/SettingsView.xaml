<UserControl x:Class="POS.WinUI.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:POS.WinUI.Views.Settings.Components"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,28">
                <!-- ════════════════════ 1. HEADER MÀN HÌNH ════════════════════ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Breadcrumb -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Home24" FontSize="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[breadcrumb.home], StringFormat='{}{0}  /  '}" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[settings.title]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Icon & Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc[settings.title]}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding Loc[settings.subtitle]}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút thao tác phía trên bên phải -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Làm mới -->
                        <Button Command="{Binding RefreshSettingsCommand}" Style="{StaticResource OutlineButtonStyle}"
                                Height="40" Padding="14,0" Margin="0,0,10,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Loc[common.refresh]}" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Lưu cài đặt -->
                        <Button Command="{Binding SaveAllSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Height="40" Padding="18,0" Cursor="Hand"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Loc[common.save_settings]}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ════════════════════ 2. SEGMENTED TAB SWITCHER ════════════════════ -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1: Thông tin cửa hàng -->
                        <RadioButton GroupName="SettingTabs" IsChecked="{Binding IsStoreTab, Mode=TwoWay}"
                                     Command="{Binding SelectStoreTabCommand}"
                                     Height="36" Padding="18,0" Cursor="Hand" VerticalContentAlignment="Center">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="BuildingShop24" FontSize="15" Foreground="#64748B" Margin="0,0,8,0" x:Name="TabIcon"/>
                                            <TextBlock Text="{Binding Loc[settings.tab_store]}" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" x:Name="TabText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="TabIcon" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 2: Thiết bị in & Mẫu hóa đơn -->
                        <RadioButton GroupName="SettingTabs" IsChecked="{Binding IsPrinterTab, Mode=TwoWay}"
                                     Command="{Binding SelectPrinterTabCommand}"
                                     Height="36" Padding="18,0" Margin="6,0,0,0" Cursor="Hand" VerticalContentAlignment="Center">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Print24" FontSize="15" Foreground="#64748B" Margin="0,0,8,0" x:Name="TabIcon"/>
                                            <TextBlock Text="{Binding Loc[settings.tab_printer]}" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" x:Name="TabText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="TabIcon" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                        <RadioButton GroupName="SettingTabs" IsChecked="{Binding IsScannerTab, Mode=TwoWay}"
                                     Command="{Binding SelectScannerTabCommand}"
                                     Content="Điện thoại quét mã" Height="36" Padding="18,0"
                                     Margin="6,0,0,0" Cursor="Hand" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ════════════════════ 3. NỘI DUNG TỪNG PHÂN TAB ════════════════════ -->
                <!-- Tab 1 Component: Thông tin cửa hàng & Giao diện -->
                <components:StoreInfoSettingComponent Visibility="{Binding IsStoreTab, Converter={StaticResource BoolToVis}}"/>

                <!-- Tab 2 Component: Thiết bị in & Mẫu xem trước hóa đơn -->
                <Grid Visibility="{Binding IsPrinterTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Cấu hình máy in & Tiêu đề chân trang hóa đơn & WiFi QR -->
                    <components:ReceiptPrinterSettingComponent Grid.Column="0"/>

                    <!-- Cột phải: Xem trước mẫu hóa đơn nhiệt trực tiếp -->
                    <components:ReceiptPreviewComponent Grid.Column="2"/>
                </Grid>

                <!-- Cấu hình cố định điện thoại với quầy; ca bán tự nhận mã khi mở. -->
                <Border Visibility="{Binding IsScannerTab, Converter={StaticResource BoolToVis}}"
                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Thiết bị quét mã cho quầy POS" FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Đăng ký một lần. Khi mở ca tại quầy, mã từ điện thoại sẽ tự vào giỏ POS của quầy đó."
                                   TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,18"/>

                        <TextBlock Text="Quầy nhận mã" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ScannerRegisters}" SelectedItem="{Binding SelectedScannerRegister}"
                                  DisplayMemberPath="Name" Height="38" Margin="0,6,0,14"/>
                        <TextBlock Text="Tên điện thoại" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                            <TextBox Text="{Binding ScannerDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="280" Height="38" VerticalContentAlignment="Center"/>
                            <Button Content="Đăng ký điện thoại" Command="{Binding CreateScannerDeviceCommand}"
                                    Margin="10,0,0,0" Padding="14,5"/>
                        </StackPanel>

                        <TextBlock Text="Thiết bị đang đăng ký" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <ListBox ItemsSource="{Binding ScannerDevices}" SelectedItem="{Binding SelectedScannerDevice}"
                                 Height="150" BorderBrush="#CBD5E1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="  •  " Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding RegisterName}" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                            <Button Content="Cấp URL mới" Command="{Binding RotateScannerDeviceCommand}" Padding="12,5"/>
                            <Button Content="Thu hồi thiết bị" Command="{Binding RevokeScannerDeviceCommand}"
                                    Margin="8,0,0,0" Padding="12,5"/>
                        </StackPanel>

                        <TextBlock Text="URL webhook để nhập vào kisledScan (POST)" FontWeight="SemiBold"/>
                        <TextBlock Text="URL chỉ hiện khi đăng ký hoặc cấp lại. Giữ bí mật và lưu trong kisledScan."
                                   TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,8"/>
                        <TextBox Text="{Binding ScannerPairingUrl}" IsReadOnly="True"
                                 Height="38" VerticalContentAlignment="Center" FontSize="11"/>
                        <Button Content="Sao chép URL" Command="{Binding CopyScannerUrlCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"/>
                        <Image Source="{Binding ScannerPairingQr}" Width="220" Height="220"
                               HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════ 4. TOAST NOTIFICATION ════════════════════ -->
        <shared:ToastNotification Message="{Binding ToastMessage}" ToastType="{Binding ToastType}"
                                  VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="2000"/>
    </Grid>
</UserControl>
