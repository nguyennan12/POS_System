<UserControl x:Class="POS.WinUI.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="28,20,28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Header -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="32,24" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}"
                                BorderThickness="1">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="28"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Cài đặt hệ thống" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ngôn ngữ giao diện -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="32,24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="20"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Ngôn ngữ giao diện" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        

                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      Width="150" Height="36" FontSize="13"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                            <Button Content="Áp dụng ngôn ngữ"
                                    Command="{Binding SwitchLanguageCommand}"
                                    Margin="12,0,0,0" Height="36" Padding="16,0"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                                    FontSize="13" FontWeight="Medium"/>
                        </StackPanel>

                        <!-- Trạng thái -->
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Cấu hình cửa hàng -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="32,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="BuildingShop24" FontSize="20"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Cấu hình cửa hàng" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Tải cấu hình SystemConfig của cửa hàng hiện tại từ server."
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Button Content="Tải cấu hình"
                                Command="{Binding LoadCommand}"
                                Height="36" Padding="16,0" Width="160"
                                HorizontalAlignment="Left"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                FontSize="13" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
