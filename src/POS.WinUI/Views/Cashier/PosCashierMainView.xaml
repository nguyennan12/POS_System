<UserControl x:Class="POS.WinUI.Views.Cashier.PosCashierMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sharedComp="clr-namespace:POS.WinUI.Views.Shared.Components"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="{StaticResource InputBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Vùng làm việc Bán hàng / Quầy Thu ngân POS -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ 1. TOP HEADER (Shared Component) ════════════════════ -->
        <sharedComp:AppHeaderBar Grid.Row="0" IsPosMode="True" ShowSidebarToggle="False"/>

        <!-- ════════════════════ 2. POS CASHIER MAIN WORKSPACE ═════════════════════ -->
        <Grid Grid.Row="1" Margin="24,18,24,20">
            <!-- Khung Card màn hình Quầy thu ngân -->
            <Border Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource InputBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Padding="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#0F172A" Opacity="0.03" ShadowDepth="3" Direction="270"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Icon giỏ hàng / quầy bán hàng -->
                    <Border Width="76" Height="76" CornerRadius="22" Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cart24" FontSize="36" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tag phân hệ -->
                    <Border Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,5" HorizontalAlignment="Center" Margin="0,20,0,10">
                        <TextBlock Text="MÀN HÌNH BÁN HÀNG &amp; THU NGÂN" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <!-- Tiêu đề -->
                    <TextBlock Text="Quầy bán lẻ trực tiếp (POS Cashier)" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"/>
                    
                    <!-- Mô tả -->
                    <TextBlock Text="Khu vực quét mã vạch sản phẩm, thêm đơn hàng vào giỏ và thanh toán trực tiếp tại quầy thu ngân." 
                               FontSize="13.5" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center"
                               MaxWidth="520"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Margin="0,8,0,0"/>

                    <!-- Ghi chú phân quyền an toàn -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,12" Margin="0,28,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Phân quyền bảo mật: Nhân viên Thu ngân chỉ hoạt động tại màn hình này và không có quyền truy cập Trang Quản lý." 
                                       FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════════════════ 3. BOTTOM FOOTER (Shared Component) ════════════════════ -->
        <sharedComp:AppFooterBar Grid.Row="2" IsPosMode="True"/>
    </Grid>
</UserControl>
