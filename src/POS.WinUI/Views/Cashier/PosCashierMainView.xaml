<UserControl x:Class="POS.WinUI.Views.Cashier.PosCashierMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared"
             xmlns:sharedComp="clr-namespace:POS.WinUI.Views.Shared.Components"
             xmlns:cashierComp="clr-namespace:POS.WinUI.Views.Cashier.Components"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CheckoutCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F6" Command="{Binding PrintBillCommand}"/>
    </UserControl.InputBindings>

    <!-- ════════════════════ MAIN SHELL ════════════════════ -->
    <Grid Background="{StaticResource InputBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: App Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Vùng làm việc chính Bán Hàng POS (2 Cột Cân Xứng) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: App Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <!-- ════════════════════ 1. TOP HEADER ════════════════════ -->
        <sharedComp:AppHeaderBar Grid.Row="0" IsPosMode="True" ShowSidebarToggle="False"/>

        <!-- ════════════════════ 2. CASHIER MAIN WORKSPACE ════════════════════ -->
        <Grid Grid.Row="1" Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
                <!-- CỘT TRÁI (LEFT): Danh mục & Lưới sản phẩm (~58%) -->
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="12"/>
                <!-- CỘT PHẢI (RIGHT): Giỏ hàng, Bàn phím & Thanh toán (~42%) -->
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>


            <!-- ── VÙNG BÊN TRÁI: SEARCH, CATEGORIES & PRODUCT GRID ── -->
            <Border Grid.Column="0" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource InputBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Padding="14,12,14,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Thanh Tìm kiếm + Nút Quét mã vạch -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Thanh Chọn Danh mục Pills -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Lưới Danh sách Thẻ Sản Phẩm -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <cashierComp:PosSearchBar Grid.Row="0" Margin="0,0,0,10"/>
                    <cashierComp:PosCategoryBar Grid.Row="1" Margin="0,0,0,12"/>
                    <cashierComp:PosProductCatalog Grid.Row="2" ProductCardClicked="OnProductCardClick"/>
                </Grid>
            </Border>

            <!-- ── VÙNG BÊN PHẢI: KHÁCH HÀNG, GIỎ HÀNG, NUMPAD & CHECKOUT ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Row 0: Khách hàng -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Giỏ hàng -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Bàn phím số Numpad & Ưu đãi / Thanh toán -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Box Khách Hàng -->
                <cashierComp:PosCustomerSelector Grid.Row="0" Margin="0,0,0,8"/>

                <!-- Box Giỏ Hàng -->
                <cashierComp:PosCartView x:Name="CartView" Grid.Row="1" Margin="0,0,0,8"/>

                <!-- Box Numpad & Thanh Toán -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- Cột Numpad cảm ứng (50%) -->
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="8"/>
                        <!-- Cột Ưu đãi & Tổng tiền (50%) -->
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <cashierComp:PosTouchNumpad Grid.Column="0"/>
                    <cashierComp:PosCheckoutPanel Grid.Column="2"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ════════════════════ 3. BOTTOM FOOTER ════════════════════ -->
        <sharedComp:AppFooterBar Grid.Row="2" IsPosMode="True"/>

        <!-- ════════════════════ TOAST NOTIFICATION OVERLAY (TOP-MOST) ════════════════════ -->
        <shared:ToastNotification Grid.Row="0" Grid.RowSpan="3"
                                  Message="{Binding ToastMessage}"
                                  ToastType="{Binding ToastType}"
                                  Panel.ZIndex="99999"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,15,0,0"/>
    </Grid>
</UserControl>
