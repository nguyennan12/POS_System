<UserControl x:Class="POS.WinUI.Views.Cashier.Components.PosSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <!-- ── THANH TÌM KIẾM & QUÉT MÃ VẠCH (BARCODE) ── -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Ô Tìm kiếm dùng chung shared:TextInputField -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <!-- Nút Quét mã vạch -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Ô tìm kiếm thông minh -->
        <shared:TextInputField Grid.Column="0"
                               Height="44"
                               CornerRadius="12"
                               Icon="Search24"
                               IconSize="17"
                               InputFontSize="13"
                               PlaceholderText="Tìm theo tên, SKU hoặc nhập mã vạch..."
                               ShowClearButton="True"
                               ClearCommand="{Binding ClearSearchCommand}"
                               Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Nút Quét mã vạch (Camera / Máy quét) -->
        <Button Grid.Column="2"
                Height="44"
                Command="{Binding ScanBarcodeCommand}"
                Cursor="Hand"
                ToolTip="Kích hoạt Camera / Máy quét mã vạch">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ScanBtnBorder"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="12"
                            Padding="16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="{StaticResource BrandPrimaryColor}" Opacity="0.3" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="QrCode24" FontSize="18" Foreground="White" Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quét mã vạch" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Camera / máy quét" FontSize="10" Foreground="#FFEDD5" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScanBtnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ScanBtnBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
