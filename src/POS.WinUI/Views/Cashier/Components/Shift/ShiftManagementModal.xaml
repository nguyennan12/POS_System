<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Shift.ShiftManagementModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- BACKDROP OVERLAY -->
    <Grid Background="#75000000">
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="540"
                MaxHeight="680"
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#0F172A" Opacity="0.25" ShadowDepth="10" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Modal Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Modal Body Content -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Error Message & Action Buttons Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════ HEADER ════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Icon -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ui:SymbolIcon FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#0F172A">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Clock24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftModalCloseMode}" Value="True">
                                            <Setter Property="Symbol" Value="MoneyHand24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Tiêu đề thay đổi theo chế độ Mở / Đóng ca -->
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Mở ca làm việc"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftModalCloseMode}" Value="True">
                                            <Setter Property="Text" Value="Kết thúc &amp; Đóng ca làm việc"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Subtitle: Chi nhánh & Quầy -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding StoreName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text=" • " FontSize="12.5" Foreground="#CBD5E1"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,1.5">
                                <TextBlock Text="{Binding RegisterName}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close (X) Button -->
                    <Button Grid.Column="2" 
                            Command="{Binding CloseShiftModalCommand}"
                            Width="36" Height="36"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderBrush}"
                                        CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ════════════════════ BODY CONTENT ════════════════════ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- ════════════ A. CHẾ ĐỘ MỞ CA (OPEN SHIFT) ════════════ -->
                        <StackPanel Visibility="{Binding IsShiftModalOpenMode, Converter={StaticResource BoolToVis}}">
                            <!-- Tiền mặt đầu ca -->
                            <TextBlock Text="Tiền mặt đầu ca (VND):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="14,8" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Money24" FontSize="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" 
                                             Style="{StaticResource CleanTextBoxStyle}"
                                             Text="{Binding OpeningCashInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="20" FontWeight="Bold" Foreground="#0F172A"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="VNĐ" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Quick Cash Pills (4 Cột Cân Xứng) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SetQuickOpeningCashCommand}" CommandParameter="0" 
                                        Height="36" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="T0" Text="0 đ" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B0" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="B0" Property="BorderBrush" Value="#93C5FD"/>
                                                    <Setter TargetName="T0" Property="Foreground" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding SetQuickOpeningCashCommand}" CommandParameter="500000" 
                                        Height="36" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="T1" Text="500,000 đ" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B1" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="B1" Property="BorderBrush" Value="#93C5FD"/>
                                                    <Setter TargetName="T1" Property="Foreground" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="4" Command="{Binding SetQuickOpeningCashCommand}" CommandParameter="1000000" 
                                        Height="36" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="T2" Text="1,000,000 đ" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B2" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="B2" Property="BorderBrush" Value="#93C5FD"/>
                                                    <Setter TargetName="T2" Property="Foreground" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="6" Command="{Binding SetQuickOpeningCashCommand}" CommandParameter="2000000" 
                                        Height="36" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        MinWidth="0" MinHeight="0" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="T3" Text="2,000,000 đ" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B3" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="B3" Property="BorderBrush" Value="#93C5FD"/>
                                                    <Setter TargetName="T3" Property="Foreground" Value="#2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Ghi chú mở ca -->
                            <TextBlock Text="Ghi chú khi mở ca (Tùy chọn):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource CleanMultilineTextBoxStyle}"
                                     Text="{Binding OpenShiftNote, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="65"
                                     FontSize="13"/>
                        </StackPanel>

                        <!-- ════════════ B. CHẾ ĐỘ ĐÓNG CA (CLOSE SHIFT) ════════════ -->
                        <StackPanel Visibility="{Binding IsShiftModalCloseMode, Converter={StaticResource BoolToVis}}">
                            <!-- Financial Overview Grid (4 Clean Minimalist Cards) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tiền đầu ca -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Tiền đầu ca" FontSize="12" FontWeight="Medium" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentShiftSummary.OpeningCash, StringFormat='{}{0:N0} đ'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Doanh thu tiền mặt -->
                                <Border Grid.Row="0" Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu Tiền mặt" FontSize="12" FontWeight="Medium" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentShiftSummary.TotalCashSales, StringFormat='{}{0:N0} đ'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Doanh thu Thẻ & QR -->
                                <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu Thẻ / QR" FontSize="12" FontWeight="Medium" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentShiftSummary.TotalQrSales, StringFormat='{}{0:N0} đ'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Số lượng đơn hàng -->
                                <Border Grid.Row="2" Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Số đơn đã bán" FontSize="12" FontWeight="Medium" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CurrentShiftSummary.OrderCount, StringFormat='{}{0} đơn'}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Tổng tiền mặt ước tính trong két -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Tiền mặt ước tính trong két" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569"/>
                                        <TextBlock Text="Tiền đầu ca + Doanh thu tiền mặt" FontSize="11.5" Foreground="#94A3B8" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ClosingExpectedCash, StringFormat='{}{0:N0} đ'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Nhập tiền mặt thực tế kiểm kê -->
                            <TextBlock Text="Tiền mặt thực tế kiểm kê trong két:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="14,8" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Money24" FontSize="18" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" 
                                             Style="{StaticResource CleanTextBoxStyle}"
                                             Text="{Binding ClosingActualCashInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="20" FontWeight="Bold" Foreground="#0F172A"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="VNĐ" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Chênh lệch kết ca -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="Chênh lệch (Thực tế - Dự kiến):" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ClosingDifference, StringFormat='{}{0:N0} đ'}" 
                                               HorizontalAlignment="Right"
                                               FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClosingDifferenceNegative}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Ghi chú đóng ca -->
                            <TextBlock Text="Ghi chú kết ca (Lý do chênh lệch nếu có):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource CleanMultilineTextBoxStyle}"
                                     Text="{Binding CloseShiftNote, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="55"
                                     FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════════════ FOOTER & ACTIONS (CÂN ĐỐI 50% - 50%) ════════════════════ -->
                <StackPanel Grid.Row="2">
                    <!-- Error Message -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding ShiftModalErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                        <TextBlock Text="{Binding ShiftModalErrorMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DC2626"/>
                    </Border>

                    <!-- Nút Hủy và Nút Xác nhận chia đều 2 cột 1:1 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button Grid.Column="0" 
                                Command="{Binding CloseShiftModalCommand}"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CancelBorder" 
                                            Background="#F1F5F9" 
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B" Margin="0,0,8,0"/>
                                            <TextBlock Text="Hủy bỏ" Foreground="#475569" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CancelBorder" Property="Background" Value="#E2E8F0"/>
                                            <Setter TargetName="CancelBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Submit Button (Mở ca) -->
                        <Button Grid.Column="2" 
                                Command="{Binding SubmitOpenShiftCommand}"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding IsShiftModalOpenMode, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SubmitOpenBorder" 
                                            Background="#16A34A" 
                                            CornerRadius="12"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#16A34A" Opacity="0.3" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="Xác nhận mở ca" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SubmitOpenBorder" Property="Background" Value="#15803D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Submit Button (Đóng ca) -->
                        <Button Grid.Column="2" 
                                Command="{Binding SubmitCloseShiftCommand}"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding IsShiftModalCloseMode, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SubmitCloseBorder" 
                                            Background="#DC2626" 
                                            CornerRadius="12"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#DC2626" Opacity="0.3" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="Xác nhận đóng ca" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SubmitCloseBorder" Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
