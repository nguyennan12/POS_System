<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Shift.ShiftManagementModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sections="clr-namespace:POS.WinUI.Views.Cashier.Components.Shift.Sections"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- BACKDROP OVERLAY -->
    <Grid Background="#75000000">
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="540"
                MaxHeight="680"
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#0F172A" Opacity="0.25" ShadowDepth="10" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Modal Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Modal Body Content -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Error Message & Action Buttons Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════ HEADER ════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Icon -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ui:SymbolIcon FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#0F172A">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Clock24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftModalCloseMode}" Value="True">
                                            <Setter Property="Symbol" Value="MoneyHand24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Tiêu đề thay đổi theo chế độ Mở / Đóng ca -->
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Mở ca làm việc"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftModalCloseMode}" Value="True">
                                            <Setter Property="Text" Value="Kết thúc &amp; Đóng ca làm việc"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Subtitle: Chi nhánh & Quầy -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding StoreName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text=" • " FontSize="12.5" Foreground="#CBD5E1"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,1.5">
                                <TextBlock Text="{Binding RegisterName}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close (X) Button -->
                    <Button Grid.Column="2" 
                            Command="{Binding CloseShiftModalCommand}"
                            Width="36" Height="36"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderBrush}"
                                        CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#64748B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ════════════════════ BODY CONTENT ════════════════════ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- A. CHẾ ĐỘ MỞ CA (OPEN SHIFT) -->
                        <sections:OpenShiftSection />

                        <!-- B. CHẾ ĐỘ ĐÓNG CA (CLOSE SHIFT) -->
                        <sections:CloseShiftSection />
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════════════ FOOTER & ACTIONS (CÂN ĐỐI 50% - 50%) ════════════════════ -->
                <StackPanel Grid.Row="2">
                    <!-- Error Message -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding ShiftModalErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                        <TextBlock Text="{Binding ShiftModalErrorMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DC2626"/>
                    </Border>

                    <!-- Nút Hủy và Nút Xác nhận chia đều 2 cột 1:1 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button -->
                        <Button Grid.Column="0" 
                                Command="{Binding CloseShiftModalCommand}"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CancelBorder" 
                                            Background="#F1F5F9" 
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B" Margin="0,0,8,0"/>
                                            <TextBlock Text="Hủy bỏ" Foreground="#475569" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CancelBorder" Property="Background" Value="#E2E8F0"/>
                                            <Setter TargetName="CancelBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Submit Button (Mở ca) -->
                        <Button Grid.Column="2" 
                                Command="{Binding SubmitOpenShiftCommand}"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding IsShiftModalOpenMode, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SubmitOpenBorder" 
                                            Background="#16A34A" 
                                            CornerRadius="12"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#16A34A" Opacity="0.3" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="Xác nhận mở ca" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SubmitOpenBorder" Property="Background" Value="#15803D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Submit Button (Đóng ca) -->
                        <Button Grid.Column="2" 
                                Command="{Binding SubmitCloseShiftCommand}"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="0" MinHeight="0" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding IsShiftModalCloseMode, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SubmitCloseBorder" 
                                            Background="#DC2626" 
                                            CornerRadius="12"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#DC2626" Opacity="0.3" ShadowDepth="3" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="Xác nhận đóng ca" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SubmitCloseBorder" Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
