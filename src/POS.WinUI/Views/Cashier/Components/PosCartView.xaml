<UserControl x:Class="POS.WinUI.Views.Cashier.Components.PosCartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:POS.WinUI.Core.Models">

    <!-- ── GIỎ HÀNG (CART ITEMS LIST) ── -->
    <Border Background="{StaticResource CardBackgroundBrush}" 
            BorderBrush="{StaticResource InputBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="14" 
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header Giỏ hàng -->
                <RowDefinition Height="Auto"/>
                <!-- Nội dung danh sách món -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Giỏ hàng -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="CartBadge" Width="26" Height="26" CornerRadius="8" Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <ui:SymbolIcon Symbol="Cart24" FontSize="14" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Giỏ hàng" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="#FFF7ED" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                            <Run Text="{Binding CartItemCount, Mode=OneWay}"/>
                            <Run Text=" sản phẩm"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Nút Xóa toàn bộ giỏ -->
                <Button HorizontalAlignment="Right"
                        Command="{Binding ClearCartCommand}"
                        Visibility="{Binding IsCartEmpty, Converter={StaticResource InverseBoolToVis}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Xóa sạch giỏ hàng">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="Xóa hết" FontSize="11.5" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Trạng thái Giỏ Hàng Rỗng -->
            <Grid Grid.Row="1" Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cart24" FontSize="26" Foreground="{StaticResource TextPlaceholderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chưa có sản phẩm trong đơn" 
                               FontSize="13.5" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,3"/>
                    <TextBlock Text="Chọn sản phẩm hoặc quét mã vạch để thêm" 
                               FontSize="11.5" 
                               Foreground="{StaticResource TextPlaceholderBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Trạng thái Có Hàng: Danh sách cuộn món hàng -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCartEmpty, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding CartItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PosCartItem}">
                            <Border Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <!-- Hiệu ứng trượt vào giỏ hàng từ bên trái -->
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="CartItemSlide" X="-50" Y="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CartItemSlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-50" To="0"
                                                                 Duration="0:0:0.25"
                                                                 DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1"
                                                                 Duration="0:0:0.2"
                                                                 DecelerationRatio="0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tên & Đơn giá -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="12.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0">
                                            <Run Text="{Binding Price, StringFormat='{}{0:N0} đ'}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Unit}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Cụm Tăng/Giảm số lượng [-] [Qty] [+] -->
                                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2" Margin="6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource QtyStepperButtonStyle}"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Subtract24" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Button>
                                            <TextBlock Text="{Binding Quantity}" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       MinWidth="24" 
                                                       TextAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource QtyStepperButtonStyle}"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Thành tiền món -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SubTotal, StringFormat='{}{0:N0} đ'}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <!-- Nút xóa món -->
                                    <Button Grid.Column="3"
                                            Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="26" Height="26"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="4,0,0,0">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="{StaticResource TextPlaceholderBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
