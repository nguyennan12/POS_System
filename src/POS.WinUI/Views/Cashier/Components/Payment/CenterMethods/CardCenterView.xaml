<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.CenterMethods.CardCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Style Card Brand Chip -->
        <Style x:Key="CardTypeChip" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="6,0">
        <Grid.RowDefinitions>
            <!-- Row 0: Chọn loại thẻ -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Thông báo tính năng sắp ra mắt -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Nhập mã chuẩn chi Trace No -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 1. CHỌN LOẠI THẺ / CỔNG THANH TOÁN (ICON TO RÕ NÉT) ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Loại thẻ / Cổng thanh toán quốc tế" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Visa -->
                <Button Grid.Column="0" Command="{Binding SelectCardTypeCommand}" CommandParameter="Visa" ToolTip="Thẻ Visa" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardTypeChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCardType}" Value="Visa">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Image Source="/Resources/Assets/ic_visa.png" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Mastercard -->
                <Button Grid.Column="1" Command="{Binding SelectCardTypeCommand}" CommandParameter="Mastercard" ToolTip="Thẻ Mastercard" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardTypeChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCardType}" Value="Mastercard">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Image Source="/Resources/Assets/ic_mastercard.png" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Apple Pay -->
                <Button Grid.Column="2" Command="{Binding SelectCardTypeCommand}" CommandParameter="ApplePay" ToolTip="Ví Apple Pay" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardTypeChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCardType}" Value="ApplePay">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Image Source="/Resources/Assets/ic_applepay.png" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- PayPal -->
                <Button Grid.Column="3" Command="{Binding SelectCardTypeCommand}" CommandParameter="PayPal" ToolTip="Cổng thanh toán PayPal">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardTypeChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCardType}" Value="PayPal">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Image Source="/Resources/Assets/ic_paypal.png" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ── 2. BOX THÔNG BÁO TÍNH NĂNG (TINH GỌN, KHÔNG CÓ ICON THẺ DƯ THỪA) ── -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <!-- Badge Sắp ra mắt -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,3" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="Sắp ra mắt" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                </Border>

                <TextBlock Text="Kết nối máy POS tự động" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Tính năng đang phát triển • Quẹt thẻ trên máy POS rời và nhập mã đối soát bên dưới" 
                           FontSize="11.5" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── 3. MÃ CHUẨN CHI (TRACE NO) ĐỐI SOÁT ── -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Mã chuẩn chi (Trace No):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="(Không bắt buộc • Xem trên hóa đơn POS)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Text="{Binding CardTraceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CleanTextBoxStyle}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Padding="10,6"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
