<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.CenterMethods.CashCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <Style x:Key="CashChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="10,0">
        <Grid.RowDefinitions>
            <!-- Row 0: Ô nhập tiền khách đưa -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Lưới phím tiền nhanh -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Banner Tiền thối cho khách -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 1. TIỀN KHÁCH ĐƯA ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Tiền khách đưa (VNĐ)" 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}" 
                       Margin="0,0,0,6"/>

            <Border Background="#FFFFFF" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="1.5" 
                    CornerRadius="10" 
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Money24" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding TenderedCashInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CleanTextBoxStyle}"
                             FontSize="24"
                             FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" 
                               Text="đ" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ── 2. LƯỚI PHÍM TIỀN NHANH ── -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Chọn nhanh mệnh giá" 
                       FontSize="12" 
                       FontWeight="Medium" 
                       Foreground="{StaticResource TextMutedBrush}" 
                       Margin="0,0,0,8"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <Button Grid.Row="0" Grid.Column="0" Content="+10k" Style="{StaticResource CashChipBtn}" Command="{Binding AddQuickCashCommand}" CommandParameter="10000" Margin="0,0,6,6"/>
                <Button Grid.Row="0" Grid.Column="1" Content="+20k" Style="{StaticResource CashChipBtn}" Command="{Binding AddQuickCashCommand}" CommandParameter="20000" Margin="0,0,6,6"/>
                <Button Grid.Row="0" Grid.Column="2" Content="+50k" Style="{StaticResource CashChipBtn}" Command="{Binding AddQuickCashCommand}" CommandParameter="50000" Margin="0,0,6,6"/>
                <Button Grid.Row="0" Grid.Column="3" Content="+100k" Style="{StaticResource CashChipBtn}" Command="{Binding AddQuickCashCommand}" CommandParameter="100000" Margin="0,0,0,6"/>

                <!-- Row 1 -->
                <Button Grid.Row="1" Grid.Column="0" Content="+200k" Style="{StaticResource CashChipBtn}" Command="{Binding AddQuickCashCommand}" CommandParameter="200000" Margin="0,0,6,0"/>
                <Button Grid.Row="1" Grid.Column="1" Content="+500k" Style="{StaticResource CashChipBtn}" Command="{Binding AddQuickCashCommand}" CommandParameter="500000" Margin="0,0,6,0"/>
                <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Đúng số tiền (Exact)" 
                        Style="{StaticResource CashChipBtn}" 
                        Background="#F8FAFC" 
                        BorderBrush="#CBD5E1" 
                        Foreground="{StaticResource TextPrimaryBrush}"
                        FontWeight="Bold"
                        Command="{Binding SetExactCashCommand}"/>
            </Grid>
        </StackPanel>

        <!-- ── 3. BANNER TIỀN THỪA ── -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Tiền thối lại cho khách" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Tự động tính theo tiền đưa" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ChangeAmount, StringFormat='{}{0:N0} đ'}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
