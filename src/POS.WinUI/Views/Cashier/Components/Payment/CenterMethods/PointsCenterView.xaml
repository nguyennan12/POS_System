<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.CenterMethods.PointsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <UserControl.Resources>
        <Style x:Key="PointChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center" Margin="10,0">
        
        <!-- ════════════════════ TRƯỜNG HỢP 1: CHƯA CÓ KHÁCH HÀNG THÀNH VIÊN ════════════════════ -->
        <Border Visibility="{Binding HasSelectedCustomer, Converter={StaticResource InverseBoolToVis}}"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,28"
                HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,14" Padding="12">
                    <ui:SymbolIcon Symbol="PersonQuestionMark24" FontSize="28" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <TextBlock Text="Chưa chọn khách hàng thành viên" 
                           FontSize="14.5" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,6"/>

                <TextBlock Text="Khách lẻ hiện tại chưa có thông tin tích lũy điểm thưởng để thanh toán." 
                           FontSize="12" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           HorizontalAlignment="Center" 
                           MaxWidth="340"
                           Margin="0,0,0,12"/>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <TextBlock Text="💡 Vui lòng chọn khách hàng thành viên trước khi dùng phương thức này." 
                               FontSize="11.5" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ════════════════════ TRƯỜNG HỢP 2: ĐÃ CÓ KHÁCH HÀNG THÀNH VIÊN ════════════════════ -->
        <Grid Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <!-- Row 0: Thẻ điểm thưởng hội viên (Gọn gàng + MemberTierBadge) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Chọn số điểm đổi -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Bảng đối soát quy đổi -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 1. THẺ ĐIỂM THƯỞNG HỘI VIÊN (TÁI SỬ DỤNG MEMBERTIERBADGE) ── -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Tên + Badge Hạng Thành Viên + Tỷ lệ -->
                        <ColumnDefinition Width="*"/>
                        <!-- Badge Điểm thưởng -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCustomerName, FallbackValue='Khách thành viên'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <shared:MemberTierBadge TierName="{Binding CustomerTierName}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Tỷ lệ: 1 điểm = 1.000 đ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="24,2,0,0"/>
                    </StackPanel>

                    <!-- Khả dụng / Badge Điểm -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Điểm khả dụng" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                        <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Star24" FontSize="12" Foreground="#EA580C" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CustomerLoyaltyPoints, StringFormat='{}{0:N0} điểm'}" FontSize="12.5" FontWeight="Bold" Foreground="#EA580C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 2. CHỌN SỐ ĐIỂM CẦN ĐỔI ── -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Số điểm muốn sử dụng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                <!-- Ô nhập điểm -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding PointsToRedeemInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Text="điểm" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Nút chọn nhanh mức điểm -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Dùng tất cả" Style="{StaticResource PointChipBtn}" Command="{Binding ApplyAllPointsCommand}" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="Dùng 50%" Style="{StaticResource PointChipBtn}" Command="{Binding ApplyHalfPointsCommand}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="+10 điểm (10k)" Style="{StaticResource PointChipBtn}" Command="{Binding ApplyPointsPresetCommand}" CommandParameter="10"/>
                </Grid>
            </StackPanel>

            <!-- ── 3. BẢNG TÍNH QUY ĐỔI ── -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Trừ vào hóa đơn:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PointsDiscountAmount, StringFormat='{}-{0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Điểm còn lại sau thanh toán:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PointsRemainingAfter, StringFormat='{}{0:N0} điểm'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
