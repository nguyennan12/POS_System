<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.CenterMethods.MoMoCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- Row 0: Chuyển đổi chế độ (Khách quét QR / Quét mã khách) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Vùng hiển thị tương tác (Standee MoMo / Quét Barcode) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Thẻ thông tin & Trạng thái Webhook -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Thanh nút thao tác -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 1. MODE TABS (Khách quét QR / Quét mã của khách) ── -->
        <Border Grid.Row="0"
                Width="320"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="3"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tab 1: Khách quét QR -->
                <Button Grid.Column="0"
                        Command="{Binding SwitchMoMoModeCommand}"
                        CommandParameter="0"
                        Height="28"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Padding="6,0">
                                <TextBlock x:Name="TabTxt" 
                                           Text="Khách quét QR" 
                                           FontSize="11.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="#64748B" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Selected Trigger -->
                                <DataTrigger Binding="{Binding MoMoMode}" Value="0">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                    <Setter TargetName="TabTxt" Property="Foreground" Value="#A50064"/>
                                    <Setter TargetName="TabTxt" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <!-- MouseOver Trigger (Chỉ khi chưa chọn) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding MoMoMode}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="TabBorder" Property="Background" Value="#FDF2F8"/>
                                    <Setter TargetName="TabTxt" Property="Foreground" Value="#A50064"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tab 2: Quét mã của khách (Sắp ra mắt) -->
                <Button Grid.Column="1"
                        Command="{Binding SwitchMoMoModeCommand}"
                        CommandParameter="1"
                        Height="28"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Padding="6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TabTxt" 
                                               Text="Quét mã khách" 
                                               FontSize="11.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="#64748B" 
                                               VerticalAlignment="Center"/>
                                    <!-- Badge Sắp ra mắt -->
                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Sắp có" FontSize="9" FontWeight="Bold" Foreground="#B45309"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Selected Trigger -->
                                <DataTrigger Binding="{Binding MoMoMode}" Value="1">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                    <Setter TargetName="TabTxt" Property="Foreground" Value="#A50064"/>
                                    <Setter TargetName="TabTxt" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <!-- MouseOver Trigger (Chỉ khi chưa chọn) -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding MoMoMode}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="TabBorder" Property="Background" Value="#FDF2F8"/>
                                    <Setter TargetName="TabTxt" Property="Foreground" Value="#A50064"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── 2. VÙNG HIỂN THỊ TƯƠNG TÁC THEO CHẾ ĐỘ ── -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            
            <!-- Mode 0: STANDEE VÍ MOMO CHÍNH HÃNG (Khách quét mã QR) -->
            <StackPanel HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MoMoMode}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Grid Width="320" Height="270" HorizontalAlignment="Center">
                    <!-- 1. Ảnh Standee MoMo gốc (Bao gồm Mascot, Banner trên và Hướng dẫn dưới) -->
                    <Border CornerRadius="16" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="4" Direction="270"/>
                        </Border.Effect>
                        <Image Source="/Resources/Assets/momo_standee_bg.png" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- 2. Khung quét QR với 4 góc bo hồng (#A50064) và mã QR động -->
                    <Border Width="144" 
                            Height="144" 
                            Background="#FFFFFF"
                            BorderBrush="#FCE7F3"
                            BorderThickness="1"
                            CornerRadius="10"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top" 
                            Margin="0,77,0,0">
                        <Grid>
                            <!-- 4 góc bo màu hồng MoMo (#A50064) -->
                            <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                    BorderBrush="#A50064" BorderThickness="2.5,2.5,0,0" CornerRadius="3,0,0,0"/>
                            <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                    BorderBrush="#A50064" BorderThickness="0,2.5,2.5,0" CornerRadius="0,3,0,0"/>
                            <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                    BorderBrush="#A50064" BorderThickness="2.5,0,0,2.5" CornerRadius="0,0,0,3"/>
                            <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                    BorderBrush="#A50064" BorderThickness="0,0,2.5,2.5" CornerRadius="0,0,3,0"/>

                            <!-- QR Code Bitmap động do hệ thống render ra -->
                            <Image Source="{Binding MoMoQrCodeImage}" 
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" 
                                   Stretch="Uniform"
                                   Margin="7"/>

                            <!-- Fallback nếu đang khởi tạo QR -->
                            <Border Background="#FDF2F8" CornerRadius="6" Margin="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MoMoQrCodeImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="QrCode24" FontSize="36" Foreground="#A50064"/>
                                    <TextBlock Text="Đang tạo mã..." FontSize="10" Foreground="#BE185D" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Mode 1: Quét mã của khách (Trạng thái Sắp ra mắt) -->
            <StackPanel HorizontalAlignment="Center" Width="320">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MoMoMode}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="270">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Icon Sắp ra mắt -->
                            <Border Width="48" Height="48" Background="#FDF2F8" BorderBrush="#FCE7F3" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="24" Foreground="#A50064"/>
                            </Border>

                            <!-- Badge -->
                            <Border Background="#FEF3C7" CornerRadius="5" Padding="7,2" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="✨ SẮP RA MẮT" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>

                            <!-- Title -->
                            <TextBlock Text="Quét mã MoMo của khách" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            
                            <!-- Subtitle ngắn gọn -->
                            <TextBlock Text="Tính năng đang được phát triển" 
                                       FontSize="11.5" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <!-- Action Button -->
                            <Button Content="Quay lại quét QR"
                                    Command="{Binding SwitchMoMoModeCommand}"
                                    CommandParameter="0"
                                    Background="#A50064"
                                    Foreground="#FFFFFF"
                                    FontWeight="SemiBold"
                                    FontSize="11.5"
                                    Height="32"
                                    Padding="16,0"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBrd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBrd" Property="Background" Value="#C2185B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── 3. THÔNG TIN CHUYỂN KHOẢN CHI TIẾT & TRẠNG THÁI WEBHOOK ── -->
        <Border Grid.Row="2"
                Width="320"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel>
                <!-- Trạng thái lắng nghe Webhook (Live Pulse Animation) -->
                <Border Background="#FDF2F8" BorderBrush="#FCE7F3" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chấm tròn nhấp nháy màu hồng MoMo -->
                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#DB2777" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <TextBlock Grid.Column="1" 
                                   Text="Đang chờ quét mã ví MoMo... " 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="#BE185D" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Grid Thông tin thanh toán MoMo -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Cổng thanh toán & SĐT Ví -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,3">
                        <TextBlock Text="Ví điện tử" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="Ví MoMo Merchant" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="4,0,0,3">
                        <TextBlock Text="Số tài khoản / SĐT" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding VietQrAccountNo, FallbackValue='0988888888'}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Row 1: Mã đơn & Số tiền -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Mã tham chiếu" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding VietQrTransferContent, FallbackValue='HD160334'}" FontWeight="Bold" FontSize="12" Foreground="#DB2777" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="4,0,0,0">
                        <TextBlock Text="Số tiền thanh toán" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="12.5" Foreground="#16A34A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── 4. NÚT THAO TÁC CÂN ĐỐI (Tạo lại mã & Đã nhận tiền) ── -->
        <Grid Grid.Row="3" Width="320">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nút 1: Tạo lại mã (Secondary) -->
            <Button Grid.Column="0"
                    Command="{Binding RefreshMoMoCommand}"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,0,5,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="Tạo lại mã" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút 2: Đã nhận tiền (Primary Pink / MoMo Brand Color) -->
            <Button Grid.Column="1"
                    Command="{Binding ConfirmMoMoPaidCommand}"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    Background="#A50064"
                    Cursor="Hand"
                    Margin="5,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="#FFFFFF" Margin="0,0,5,0"/>
                                <TextBlock Text="Đã nhận tiền" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#C2185B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
