<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.PaymentMethodSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:methods="clr-namespace:POS.WinUI.Views.Cashier.Components.Payment.Methods">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề Cột -->
        <TextBlock Grid.Row="0"
                   Text="Phương thức thanh toán"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Danh sách các phương thức thanh toán -->
        <StackPanel Grid.Row="1">
            <!-- 1. Tiền mặt (Cash) -->
            <methods:CashMethodCard />

            <!-- 2. VietQR Banking -->
            <methods:VietQrMethodCard />

            <!-- 3. Ví MoMo -->
            <methods:MoMoMethodCard />

            <!-- 4. Thẻ ngân hàng / Card -->
            <methods:CardMethodCard />
        </StackPanel>

        <!-- Thanh toán kết hợp (Split Payment Toggle) -->
        <methods:SplitPaymentToggleCard Grid.Row="2" />
    </Grid>
</UserControl>
