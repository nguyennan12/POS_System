<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.PaymentMethodSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Style Base Card Phương Thức Thanh Toán -->
        <Style x:Key="PaymentMethodCardBase" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="14,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style CheckBox Tím Chuyên Dụng Cho Split Payment -->
        <Style x:Key="PurpleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder"
                                Width="22" Height="22"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1.5">
                            <ui:SymbolIcon x:Name="CheckIcon"
                                           Symbol="Checkmark24"
                                           FontSize="13"
                                           Foreground="#FFFFFF"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BoxBorder" Property="Background" Value="#6D28D9"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#6D28D9"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="BoxBorder" Property="Background" Value="#F5F3FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề Cột -->
        <TextBlock Grid.Row="0"
                   Text="Phương thức thanh toán"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Danh sách các phương thức thanh toán -->
        <StackPanel Grid.Row="1">
            
            <!-- 1. Tiền mặt (Cash) -->
            <Button Command="{Binding SelectPaymentMethodCommand}"
                    CommandParameter="Cash"
                    ToolTip="Thanh toán trực tiếp bằng tiền mặt tại quầy">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PaymentMethodCardBase}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="Cash"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#51C81A"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#F2FBF0"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Tiền mặt (SymbolIcon Vector - Nền Trắng) -->
                    <Border Grid.Column="0" Width="38" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="#16A34A"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tiền mặt" FontSize="13.5" FontWeight="SemiBold" Foreground="#275217"/>
                        <TextBlock Text="Thanh toán tại quầy" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Indicator: Chế độ đơn (Radio) vs Chế độ Split (Thêm / Đã thêm) -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Radio Mode (Khi IsSplitPayment = False) -->
                        <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                <Condition Binding="{Binding SelectedPaymentMethod}" Value="Cash"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#51C81A"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Ellipse Width="10" Height="10" Fill="#51C81A">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="Cash"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>

                        <!-- Split Mode Badges (Khi IsSplitPayment = True) -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSplitPayment, Converter={StaticResource BoolToVis}}">
                            <!-- Đã thêm vào split -->
                            <Border Background="#DCFCE7" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddCash, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Đã chọn" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                            </Border>
                            <!-- Chưa thêm -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddCash, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="+ Thêm" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>

            <!-- 2. VietQR Banking -->
            <Button Command="{Binding SelectPaymentMethodCommand}"
                    CommandParameter="VietQR"
                    ToolTip="Quét mã VietQR chuyển khoản ngân hàng">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PaymentMethodCardBase}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="VietQR"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#F0F9FF"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon VietQR Official Logo (Box Nền Trắng) -->
                    <Border Grid.Column="0" Width="38" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="3">
                        <Image Source="/Resources/Assets/ic_vietqr.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VietQR Banking" FontSize="13.5" FontWeight="SemiBold" Foreground="#075985"/>
                        <TextBlock Text="Quét QR chuyển khoản tự động" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Indicator -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Radio Mode -->
                        <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                <Condition Binding="{Binding SelectedPaymentMethod}" Value="VietQR"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Ellipse Width="10" Height="10" Fill="#0284C7">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="VietQR"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>

                        <!-- Split Mode Badges -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSplitPayment, Converter={StaticResource BoolToVis}}">
                            <Border Background="#E0F2FE" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddVietQr, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Đã chọn" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddVietQr, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="+ Thêm" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>

            <!-- 3. Ví MoMo -->
            <Button Command="{Binding SelectPaymentMethodCommand}"
                    CommandParameter="MoMo"
                    ToolTip="Thanh toán qua ví điện tử MoMo">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PaymentMethodCardBase}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="MoMo"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#DB2777"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#FDF2F8"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon MoMo Official Logo (Box Nền Trắng) -->
                    <Border Grid.Column="0" Width="38" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="3">
                        <Image Source="/Resources/Assets/ic_momo.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Ví MoMo" FontSize="13.5" FontWeight="SemiBold" Foreground="#9D174D"/>
                        <TextBlock Text="Quét mã ví điện tử MoMo" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Indicator -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Radio Mode -->
                        <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                <Condition Binding="{Binding SelectedPaymentMethod}" Value="MoMo"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#DB2777"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Ellipse Width="10" Height="10" Fill="#DB2777">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="MoMo"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>

                        <!-- Split Mode Badges -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSplitPayment, Converter={StaticResource BoolToVis}}">
                            <Border Background="#FCE7F3" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddMoMo, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Đã chọn" FontSize="11" FontWeight="Bold" Foreground="#BE185D"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddMoMo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="+ Thêm" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>

            <!-- 4. Thẻ ngân hàng / Card -->
            <Button Command="{Binding SelectPaymentMethodCommand}"
                    CommandParameter="Card"
                    ToolTip="Thanh toán qua thẻ Mastercard / Visa / NAPAS">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PaymentMethodCardBase}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="Card"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#EA580C"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Background" Value="#FFF7ED"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Thẻ ngân hàng / Card (SymbolIcon Vector - Nền Trắng) -->
                    <Border Grid.Column="0" Width="38" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Payment24" FontSize="20" Foreground="#EA580C"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thẻ" FontSize="13.5" FontWeight="SemiBold" Foreground="#9A3412"/>
                        <TextBlock Text="Visa / Mastercard / Apple Pay" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Indicator -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Radio Mode -->
                        <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                <Condition Binding="{Binding SelectedPaymentMethod}" Value="Card"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#EA580C"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Ellipse Width="10" Height="10" Fill="#EA580C">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                                    <Condition Binding="{Binding SelectedPaymentMethod}" Value="Card"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>

                        <!-- Split Mode Badges -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSplitPayment, Converter={StaticResource BoolToVis}}">
                            <Border Background="#FFEDD5" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddCard, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Đã chọn" FontSize="11" FontWeight="Bold" Foreground="#C2410C"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddCard, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="+ Thêm" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </StackPanel>

        <!-- Thanh toán kết hợp (Split Payment Toggle) -->
        <Border Grid.Row="2"
                CornerRadius="12"
                Padding="12,10"
                Margin="0,6,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                            <Setter Property="Background" Value="#F5F3FF"/>
                            <Setter Property="BorderBrush" Value="#C4B5FD"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                    <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="17" Foreground="#7C3AED"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Thanh toán kết hợp" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Chia nhiều phương thức" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Toggle CheckBox (Màu Tím Đồng Bộ) -->
                <CheckBox Grid.Column="2"
                          IsChecked="{Binding IsSplitPayment, Mode=TwoWay}"
                          Style="{StaticResource PurpleCheckBoxStyle}"
                          VerticalAlignment="Center"
                          ToolTip="Bật/tắt chế độ thanh toán kết hợp nhiều phương thức"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
