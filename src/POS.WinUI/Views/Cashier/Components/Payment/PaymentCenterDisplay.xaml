<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.PaymentCenterDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:methods="clr-namespace:POS.WinUI.Views.Cashier.Components.Payment.CenterMethods">

    <!-- Container Center View (Nền trắng #FFFFFF) -->
    <Border Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,12">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header Badge của phương thức đang chọn -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Vùng thao tác chi tiết từng phương thức (Center Component) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 1. TOP HEADER BADGE ── -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                
                <!-- 1. Cash Badge -->
                <Border Width="36" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Cash">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="#16A34A"/>
                </Border>

                <!-- 2. VietQR Badge -->
                <Border Width="36" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" Padding="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="VietQR">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="/Resources/Assets/ic_vietqr.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                </Border>

                <!-- 3. MoMo Badge -->
                <Border Width="36" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="MoMo">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="/Resources/Assets/ic_momo.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill"/>
                </Border>

                <!-- 4. Card Badge -->
                <Border Width="36" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Card">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon Symbol="Payment24" FontSize="20" Foreground="#EA580C"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedPaymentMethodTitle, FallbackValue='Thanh toán'}" 
                               FontSize="14.5" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedPaymentMethodDescription, FallbackValue='Vui lòng làm theo hướng dẫn'}" 
                               FontSize="11.5" 
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── 2. VÙNG THAO TÁC TRUNG TÂM THEO TỪNG PHƯƠNG THỨC ── -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,4">
                
                <!-- 1. Tiền mặt (Cash Center View) -->
                <methods:CashCenterView>
                    <methods:CashCenterView.Style>
                        <Style TargetType="methods:CashCenterView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Cash">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </methods:CashCenterView.Style>
                </methods:CashCenterView>

                <!-- 2. VietQR Banking (VietQR Center View) -->
                <methods:VietQrCenterView>
                    <methods:VietQrCenterView.Style>
                        <Style TargetType="methods:VietQrCenterView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="VietQR">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </methods:VietQrCenterView.Style>
                </methods:VietQrCenterView>

                <!-- 3. Ví MoMo (MoMo Center View) -->
                <methods:MoMoCenterView>
                    <methods:MoMoCenterView.Style>
                        <Style TargetType="methods:MoMoCenterView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="MoMo">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </methods:MoMoCenterView.Style>
                </methods:MoMoCenterView>

                <!-- 4. Thẻ ngân hàng / SmartPOS (Card Center View) -->
                <methods:CardCenterView>
                    <methods:CardCenterView.Style>
                        <Style TargetType="methods:CardCenterView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="Card">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </methods:CardCenterView.Style>
                </methods:CardCenterView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
