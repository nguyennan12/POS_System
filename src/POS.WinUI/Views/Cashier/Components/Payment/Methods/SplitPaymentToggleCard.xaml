<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.Methods.SplitPaymentToggleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Style CheckBox Tím Chuyên Dụng Cho Split Payment -->
        <Style x:Key="PurpleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder"
                                Width="22" Height="22"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1.5">
                            <ui:SymbolIcon x:Name="CheckIcon"
                                           Symbol="Checkmark24"
                                           FontSize="13"
                                           Foreground="#FFFFFF"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BoxBorder" Property="Background" Value="#6D28D9"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#6D28D9"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="BoxBorder" Property="Background" Value="#F5F3FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Thanh toán kết hợp (Split Payment Toggle) -->
    <Border CornerRadius="12"
            Padding="12,10"
            Margin="0,6,0,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                        <Setter Property="Background" Value="#F5F3FF"/>
                        <Setter Property="BorderBrush" Value="#C4B5FD"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="34" Height="34" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="17" Foreground="#7C3AED"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Thanh toán kết hợp" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Chia nhiều phương thức" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <!-- Toggle CheckBox (Màu Tím Đồng Bộ) -->
            <CheckBox Grid.Column="2"
                      IsChecked="{Binding IsSplitPayment, Mode=TwoWay}"
                      Style="{StaticResource PurpleCheckBoxStyle}"
                      VerticalAlignment="Center"
                      ToolTip="Bật/tắt chế độ thanh toán kết hợp nhiều phương thức"/>
        </Grid>
    </Border>
</UserControl>
