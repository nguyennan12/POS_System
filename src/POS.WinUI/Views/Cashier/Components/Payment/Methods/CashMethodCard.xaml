<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.Methods.CashMethodCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <Style x:Key="PaymentMethodCardBase" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="14,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 1. Tiền mặt (Cash) -->
    <Button Command="{Binding SelectPaymentMethodCommand}"
            CommandParameter="Cash"
            ToolTip="Thanh toán trực tiếp bằng tiền mặt tại quầy">
        <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PaymentMethodCardBase}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                            <Condition Binding="{Binding SelectedPaymentMethod}" Value="Cash"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="#51C81A"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Background" Value="#F2FBF0"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon Tiền mặt (SymbolIcon Vector - Nền Trắng) -->
            <Border Grid.Column="0" Width="38" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
                <ui:SymbolIcon Symbol="Money24" FontSize="20" Foreground="#16A34A"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Tiền mặt" FontSize="13.5" FontWeight="SemiBold" Foreground="#275217"/>
                <TextBlock Text="Thanh toán tại quầy" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <!-- Indicator: Chế độ đơn (Radio) vs Chế độ Split (Thêm / Đã thêm) -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <!-- Radio Mode (Khi IsSplitPayment = False) -->
                <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSplitPayment}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                        <Condition Binding="{Binding SelectedPaymentMethod}" Value="Cash"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="#51C81A"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Ellipse Width="10" Height="10" Fill="#51C81A">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSplitPayment}" Value="False"/>
                                            <Condition Binding="{Binding SelectedPaymentMethod}" Value="Cash"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Border>

                <!-- Split Mode Badges (Khi IsSplitPayment = True) -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSplitPayment, Converter={StaticResource BoolToVis}}">
                    <!-- Đã thêm vào split -->
                    <Border Background="#DCFCE7" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddCash, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Đã chọn" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                    </Border>
                    <!-- Chưa thêm -->
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Visibility="{Binding CanAddCash, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="+ Thêm" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Button>
</UserControl>
