<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.PaymentSummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <UserControl.Resources>
        <!-- Style cho các nút chip điểm thưởng -->
        <Style x:Key="PointChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FCD34D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#92400E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#FEF3C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#FDE68A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút Bỏ dùng -->
        <Style x:Key="PointClearChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Khách hàng -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Dùng điểm thưởng (Card riêng biệt) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Divider -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Chi tiết tiền hàng & giảm giá -->
                <RowDefinition Height="*"/>
                <!-- Row 4: Box Tổng thanh toán -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════ 1. KHÁCH HÀNG ════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <!-- Case A: Đã chọn khách hàng (Gọn gàng + MemberTierBadge) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCustomerName, FallbackValue='Khách thành viên'}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <shared:MemberTierBadge TierName="{Binding CustomerTierName}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Điểm: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding CustomerLoyaltyPoints, StringFormat='{}{0:N0} điểm'}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="#D97706"/>
                        <TextBlock Text=" • SĐT: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding CustomerPhoneNumber, Converter={StaticResource NullOrEmptyToVis}}"/>
                        <TextBlock Text="{Binding CustomerPhoneNumber}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding CustomerPhoneNumber, Converter={StaticResource NullOrEmptyToVis}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Case B: Khách lẻ (Chưa chọn khách hàng) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            Visibility="{Binding HasSelectedCustomer, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Khách lẻ" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Chưa đăng ký thành viên" 
                               FontSize="12" 
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ════════════════════ 2. BOX DÙNG ĐIỂM TÍCH LŨY ════════════════════ -->
            <Border Grid.Row="1"
                    Background="#FFFDF5" 
                    BorderBrush="#FDE68A" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="12,10" 
                    Margin="0,0,0,12"
                    Visibility="{Binding HasCustomerPoints, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Integrated Input + Discount Badge -->
                        <RowDefinition Height="Auto"/>
                        <!-- Chips -->
                        <RowDefinition Height="Auto"/>
                        <!-- Footer balance info -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="#D97706" Margin="0,0,5,0"/>
                            <TextBlock Text="Dùng điểm tích lũy" FontSize="12.5" FontWeight="SemiBold" Foreground="#92400E"/>
                        </StackPanel>
                    </Grid>

                    <!-- Integrated Input Box & Live Deduction Badge -->
                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            BorderBrush="#FCD34D"
                            BorderThickness="1.2"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Số điểm dùng:" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="#78350F" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,6,0"/>

                            <TextBox Grid.Column="1" 
                                     Text="{Binding PointsToRedeemInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CleanTextBoxStyle}"
                                     FontSize="14" 
                                     FontWeight="Bold"
                                     Foreground="#92400E"
                                     VerticalContentAlignment="Center"/>

                            <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PointsDiscountAmount, StringFormat='- {0:N0} đ'}" 
                                           FontSize="12" 
                                           FontWeight="Bold" 
                                           Foreground="#D97706" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Nút bấm nhanh (Chips) -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
                        <Button Content="Tất cả" 
                                Command="{Binding ApplyAllPointsCommand}"
                                Style="{StaticResource PointChipButtonStyle}"
                                Margin="0,0,3,0"/>
                        <Button Content="50%" 
                                Command="{Binding ApplyHalfPointsCommand}"
                                Style="{StaticResource PointChipButtonStyle}"
                                Margin="2,0,2,0"/>
                        <Button Content="+10 điểm" 
                                Command="{Binding ApplyPointsPresetCommand}" CommandParameter="10"
                                Style="{StaticResource PointChipButtonStyle}"
                                Margin="2,0,2,0"/>
                        <Button Content="Bỏ dùng" 
                                Command="{Binding ClearPointsCommand}"
                                Style="{StaticResource PointClearChipButtonStyle}"
                                Margin="3,0,0,0"/>
                    </UniformGrid>

                    <!-- Sub-text: Khả dụng & Còn lại -->
                    <Grid Grid.Row="3" Margin="2,0,2,0">
                        <TextBlock Text="{Binding CustomerLoyaltyPoints, StringFormat='Khả dụng: {0:N0} điểm'}" 
                                   FontSize="11" 
                                   Foreground="#78350F" 
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding PointsRemainingAfter, StringFormat='Còn lại: {0:N0} điểm'}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="#92400E" 
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ════════════════════ 3. DIVIDER ════════════════════ -->
            <Separator Grid.Row="2" Background="#E2E8F0" Margin="0,0,0,12"/>

            <!-- ════════════════════ 4. TÓM TẮT HÓA ĐƠN & VOUCHER ════════════════════ -->
            <StackPanel Grid.Row="3" VerticalAlignment="Top">
                <TextBlock Text="Tóm tắt hóa đơn"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <!-- Số lượng món -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Số lượng món" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} sản phẩm'}" 
                               FontSize="12.5" 
                               FontWeight="Medium" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Tiền hàng -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Tiền hàng" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0} đ'}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Giảm giá Voucher (Chỉ hiện khi có áp dụng voucher) -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VoucherCode, Converter={StaticResource NullOrEmptyToVis}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Tag24" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Voucher (" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding VoucherCode}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text=")" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VoucherDiscount, StringFormat='-{0:N0} đ'}" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}" 
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Trừ điểm thưởng (Chỉ hiện khi có dùng điểm) -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPointsDiscount}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="#D97706" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Điểm thưởng (" FontSize="12.5" Foreground="#D97706"/>
                        <TextBlock Text="{Binding PointsToRedeem, StringFormat='{}{0:N0} điểm'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D97706"/>
                        <TextBlock Text=")" FontSize="12.5" Foreground="#D97706"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PointsDiscountAmount, StringFormat='-{0:N0} đ'}" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               Foreground="#D97706" 
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Giảm giá khuyến mãi / Chiết khấu khác -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Giảm giá khác" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalDiscount, StringFormat='-{0:N0} đ'}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource SuccessBrush}" 
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Thuế VAT -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Thuế VAT" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TaxTotal, StringFormat='{}{0:N0} đ', TargetNullValue='0 đ', FallbackValue='0 đ'}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- ════════════════════ 5. TỔNG THANH TOÁN (CARD CUỐI) ════════════════════ -->
            <Border Grid.Row="4"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Tổng cần thanh toán"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#9A3412"
                               Margin="0,0,0,3"/>

                    <TextBlock Grid.Row="1"
                               Text="{Binding GrandTotal, StringFormat='{}{0:N0} đ'}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
