<UserControl x:Class="POS.WinUI.Views.Cashier.Components.Payment.PaymentSplitItemRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Style cho Nút Bù Thiếu -->
        <Style x:Key="SplitFillRemainingButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBorder" Property="Background" Value="#FFEDD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút Tiện Ích Mini -->
        <Style x:Key="SplitMiniUtilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="UtilBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UtilBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="UtilBorder" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,12"
            Margin="0,0,0,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hàng chính: Phương thức • Ô nhập tiền • Bù thiếu • Xóa -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Cột Tên & Icon (170px) -->
                    <ColumnDefinition Width="170"/>
                    <!-- Cột Ô nhập số tiền (*) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột Nút Xóa (Auto) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Icon & Tên & % Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Padding="4">
                        <Grid>
                            <Image Source="{Binding ImagePath}" 
                                   Stretch="Uniform" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                            <ui:SymbolIcon Symbol="{Binding Icon}" 
                                           FontSize="19" 
                                           Foreground="{Binding IconColor}"
                                           Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Background="{Binding BadgeBg}" CornerRadius="4" Padding="6,1.5" Margin="0,3,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding PercentageText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Middle: Ô nhập số tiền + Nút Bù thiếu -->
                <Grid Grid.Column="1" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ô nhập số tiền lớn rõ ràng -->
                    <Border Grid.Column="0" 
                            Background="#F8FAFC" 
                            BorderBrush="#CBD5E1" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Height="40"
                            Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding AmountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CleanTextBoxStyle}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     TextAlignment="Right"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="đ"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Nút Bù thiếu (Chỉ hiện khi chưa khớp 100%) -->
                    <Button Grid.Column="1"
                            Command="{Binding DataContext.FillRemainingAmountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Gán số tiền còn thiếu vào phương thức này">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SplitFillRemainingButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSplitFullyAllocated, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,3,0"/>
                            <TextBlock Text="Bù thiếu" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right: Nút Xóa dòng (Chỉ hiện khi có từ 2 phương thức) -->
                <Button Grid.Column="2"
                        Width="34" Height="34" Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding DataContext.RemoveSplitPaymentItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        ToolTip="Xóa phương thức này">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SplitPayments.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="#94A3B8"/>
                </Button>
            </Grid>

            <!-- Hàng phụ dành riêng cho Tiền mặt: Khách đưa & Tiền thối -->
            <Border Grid.Row="1" 
                    Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}" 
                    Background="#F8FAFC" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12,8" 
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Khách đưa:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,3">
                        <TextBox Text="{Binding TenderedCashInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CleanTextBoxStyle}"
                                 FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                 TextAlignment="Right" VerticalContentAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tiền thối lại: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ChangeAmount, StringFormat='{}{0:N0} đ'}" FontSize="13.5" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hàng phụ dành riêng cho VietQR (Blue Theme) -->
            <Border Grid.Row="1" 
                    Visibility="{Binding IsVietQr, Converter={StaticResource BoolToVis}}" 
                    Background="#F0F9FF" 
                    BorderBrush="#BAE6FD" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="12,10" 
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Cột QR Image Thumbnail -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Cột Chi tiết tài khoản / Số tiền QR -->
                        <ColumnDefinition Width="*"/>
                        <!-- Cột Trạng thái / Nút Làm mới -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- QR Code Mini Thumbnail (72x72) -->
                    <Border Grid.Column="0" Width="72" Height="72" Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="8" Padding="2" Margin="0,0,12,0">
                        <Image Source="{Binding DataContext.VietQrCodeImage, RelativeSource={RelativeSource AncestorType=Window}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- Chi tiết thông tin VietQR -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                            <Border Background="#0284C7" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0">
                                <TextBlock Text="VIETQR 24/7" FontSize="10" FontWeight="Black" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding Amount, StringFormat='Số tiền: {0:N0} đ'}" FontSize="12.5" FontWeight="Bold" Foreground="#0369A1"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DataContext.VietQrAccountNo, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='STK: {0}'}" 
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock Text="{Binding DataContext.VietQrTransferContent, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Nội dung: {0}'}" 
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Status Pill & Refresh Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#0284C7" Margin="0,0,5,0"/>
                                <TextBlock Text="Chờ quét mã" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding DataContext.RefreshVietQrCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SplitMiniUtilityButtonStyle}"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="11" Foreground="#64748B" Margin="0,0,4,0"/>
                                <TextBlock Text="Làm mới QR" FontSize="10.5" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hàng phụ dành riêng cho Ví MoMo (MoMo Signature Pink Theme) -->
            <Border Grid.Row="1" 
                    Visibility="{Binding IsMoMo, Converter={StaticResource BoolToVis}}" 
                    Background="#FDF2F8" 
                    BorderBrush="#FBCFE8" 
                    BorderThickness="1.5" 
                    CornerRadius="10" 
                    Padding="12,10" 
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Cột QR Image Thumbnail -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Cột Chi tiết tài khoản / Số tiền QR -->
                        <ColumnDefinition Width="*"/>
                        <!-- Cột Trạng thái / Nút Làm mới -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- QR Code Mini Thumbnail (72x72) with MoMo Pink Frame -->
                    <Border Grid.Column="0" Width="72" Height="72" Background="#FFFFFF" BorderBrush="#F472B6" BorderThickness="1.5" CornerRadius="8" Padding="2" Margin="0,0,12,0">
                        <Image Source="{Binding DataContext.MoMoQrCodeImage, RelativeSource={RelativeSource AncestorType=Window}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- Chi tiết thông tin MoMo -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                            <Border Background="#DB2777" CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0">
                                <TextBlock Text="VÍ MOMO" FontSize="10" FontWeight="Black" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding Amount, StringFormat='Số tiền: {0:N0} đ'}" FontSize="12.5" FontWeight="Bold" Foreground="#BE185D"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DataContext.VietQrAccountNo, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='SĐT Ví: {0}'}" 
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#831843"/>
                        <TextBlock Text="{Binding DataContext.VietQrTransferContent, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Nội dung: {0}'}" 
                                   FontSize="11" Foreground="#9D174D" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Status Pill & Refresh Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#FCE7F3" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#DB2777" Margin="0,0,5,0"/>
                                <TextBlock Text="Chờ quét mã" FontSize="11" FontWeight="SemiBold" Foreground="#BE185D"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding DataContext.RefreshVietQrCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SplitMiniUtilityButtonStyle}"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="11" Foreground="#BE185D" Margin="0,0,4,0"/>
                                <TextBlock Text="Làm mới QR" FontSize="10.5" FontWeight="Medium" Foreground="#831843"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
