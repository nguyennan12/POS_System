<UserControl x:Class="POS.WinUI.Views.SmartStore.StoreMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.SmartStore"
             xmlns:models="clr-namespace:POS.WinUI.ViewModels.SmartStore.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#F8FAFC">

    <Grid x:Name="ViewportGrid" 
          ClipToBounds="True" 
          Background="#F8FAFC"
          Focusable="True"
          PreviewMouseDown="OnViewportPreviewMouseDown" 
          PreviewMouseMove="OnViewportPreviewMouseMove" 
          PreviewMouseUp="OnViewportPreviewMouseUp" 
          MouseWheel="OnViewportMouseWheel"
          LostMouseCapture="OnViewportLostMouseCapture"
          KeyDown="OnViewportKeyDown">
        <!-- ── Interactive Canvas with Zoom & Pan ── -->
        <Canvas x:Name="MapCanvas" 
                Width="{Binding CanvasWidth}" 
                Height="{Binding CanvasHeight}"
                Background="Transparent"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 1. Grid Cells Layer -->
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                        <Setter Property="Width" Value="{Binding Size}"/>
                        <Setter Property="Height" Value="{Binding Size}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CanvasCellVisual}">
                        <Border BorderBrush="#E2E8F0" BorderThickness="0.5" 
                                Background="{Binding BackgroundBrush}" 
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="OnCellClicked"
                                MouseEnter="OnCellMouseEnter"
                                ToolTip="{Binding MarkerLabel}">
                            <TextBlock Text="{Binding MarkerLabel}" 
                                       FontSize="7" FontWeight="Bold" 
                                       Foreground="#FFFFFF" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2. Zones Layer -->
            <ItemsControl ItemsSource="{Binding Zones}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                        <Setter Property="Width" Value="{Binding CanvasWidth}"/>
                        <Setter Property="Height" Value="{Binding CanvasHeight}"/>
                        <Setter Property="Panel.ZIndex" Value="3"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CanvasZoneVisual}">
                        <Border BorderBrush="{Binding ColorHex}" BorderThickness="1.5" 
                                CornerRadius="6" 
                                Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="OnZoneMouseDown"
                                PreviewMouseMove="OnZoneMouseMove"
                                PreviewMouseLeftButtonUp="OnZoneMouseUp"
                                ToolTip="Khu vực / Phân khu. Nhấp hoặc kéo để di chuyển vị trí."
                                Padding="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#2563EB" Opacity="0.08"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#F59E0B" Opacity="0.18"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ColorHex}"/>
                                        <Border Margin="5,0,0,0" Padding="3,1" CornerRadius="3" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Kéo để di chuyển" FontSize="8" FontWeight="Bold" Foreground="#D97706"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#64748B" FontWeight="Medium"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. Shelves Layer -->
            <ItemsControl ItemsSource="{Binding Shelves}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                        <Setter Property="Width" Value="{Binding CanvasWidth}"/>
                        <Setter Property="Height" Value="{Binding CanvasHeight}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CanvasShelfVisual}">
                        <Border CornerRadius="6" 
                                Background="#1E293B" 
                                BorderThickness="2"
                                Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="OnShelfMouseDown"
                                PreviewMouseMove="OnShelfMouseMove"
                                PreviewMouseLeftButtonUp="OnShelfMouseUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="Background" Value="#0F172A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.18" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>

                            <Grid Margin="4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Orientation tag -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Background="#334155" CornerRadius="3" Padding="3,1">
                                    <TextBlock Text="{Binding Orientation}" FontSize="7" Foreground="#CBD5E1"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4. Picking Route Polyline -->
            <Polyline Points="{Binding RoutePoints}" 
                      Stroke="#EF4444" 
                      StrokeThickness="3" 
                      StrokeDashArray="3 1.5" 
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      IsHitTestVisible="False"/>

            <!-- 5. Picking Route Numbered Stops -->
            <ItemsControl ItemsSource="{Binding RouteStops}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasX}"/>
                        <Setter Property="Canvas.Top" Value="{Binding CanvasY}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CanvasRouteStopVisual}">
                        <!-- Offset -13, -13 to center the 26x26 stop badge on the coordinate -->
                        <Border Width="26" Height="26" 
                                Margin="-13,-13,0,0"
                                CornerRadius="13" 
                                Background="#DC2626" 
                                BorderBrush="#FFFFFF" 
                                BorderThickness="2"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="3"/>
                            </Border.Effect>
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding StopIndex, StringFormat='Điểm dừng #{0}'}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding ProductName}" FontSize="11" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SkuCode, StringFormat='SKU: {0}'}" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat='Số lượng cần lấy: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626"/>
                                        <TextBlock Text="{Binding ShelfCode, StringFormat='Kệ: {0}'}" FontSize="10" Foreground="#475569"/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <TextBlock Text="{Binding StopIndex}" 
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="#FFFFFF" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- ── Empty State when no layout loaded ── -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Visibility="{Binding HasLayout, Converter={StaticResource InverseBoolToVis}}"
                Background="Transparent" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Map24" FontSize="56" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Chưa chọn mặt bằng nào" FontSize="16" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Vui lòng chọn một mặt bằng ở danh sách trên hoặc bấm nút '+ Tạo Bản thảo' để bắt đầu thiết kế." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Floating Zoom & Controls Toolbar -->
        <Border x:Name="ZoomToolbar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" 
                Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.12" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ZoomInCommand}" Width="32" Height="32" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Phóng to">
                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="#475569"/>
                </Button>
                <Button Command="{Binding ZoomOutCommand}" Width="32" Height="32" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Thu nhỏ">
                    <ui:SymbolIcon Symbol="Subtract24" FontSize="14" Foreground="#475569"/>
                </Button>
                <Border Width="1" Background="#E2E8F0" Margin="4,4"/>
                <Button Command="{Binding ResetZoomCommand}" Width="32" Height="32" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Tỉ lệ 100%">
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Foreground="#475569"/>
                </Button>
                <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}" 
                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B" 
                           VerticalAlignment="Center" Margin="6,0,8,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
