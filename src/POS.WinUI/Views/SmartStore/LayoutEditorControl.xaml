<UserControl x:Class="POS.WinUI.Views.SmartStore.LayoutEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.SmartStore"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="320"
             Background="{StaticResource CardBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- Header Section -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Thiết Kế Mặt Bằng" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Chỉnh sửa ô lưới, kệ hàng và khu vực" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status / Error message -->
                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- Nút Tải lại sơ đồ ngay -->
                            <Button Command="{Binding ReloadLayoutCommand}"
                                    Height="28" Padding="10,0" Cursor="Hand" Margin="0,0,8,0"
                                    Background="{StaticResource DangerTextBrush}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="12" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                                <TextBlock Text="Tải lại sơ đồ" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Nút Thu hồi thay đổi -->
                            <Button Command="{Binding DiscardChangesCommand}"
                                    Height="28" Padding="10,0" Cursor="Hand"
                                    Background="Transparent" BorderBrush="{StaticResource DangerTextBrush}" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Thu hồi thay đổi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Informational Banner when on Active Layout (Read-Only) -->
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="8" 
                        Background="{StaticResource PrimaryLightBrush}" 
                        BorderBrush="{StaticResource PrimaryBorderBrush}" 
                        BorderThickness="1"
                        Visibility="{Binding CanEdit, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="ShieldLock24" FontSize="15" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Mặt Bằng Đang Hoạt Động" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Mặt bằng này đang hoạt động chính thức nên được bảo vệ chống sửa trực tiếp. Bấm nút dưới đây để nhân bản sang bản thảo và tự do chỉnh sửa." 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Command="{Binding CloneCurrentLayoutCommand}"
                                Height="34" Padding="12,0" Cursor="Hand"
                                HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{StaticResource PrimaryBrush}" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Nhân bản thành Bản Thảo để sửa" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 1. Bút Vẽ Ô Lưới (Brushes) -->
            <TextBlock Text="BÚT VẼ Ô LƯỚI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,16"
                    IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <RadioButton GroupName="GridBrushGroup" Content="Vật cản / Tường (Blocked)" IsChecked="True"
                                 Command="{Binding SetBrushCommand}" CommandParameter="Blocked"
                                 Margin="4,4" FontSize="12" Cursor="Hand" ToolTip="Tô ô lưới làm tường chắn / không thể đi qua"/>
                    <RadioButton GroupName="GridBrushGroup" Content="Lối đi thông thoáng (Walkway)" 
                                 Command="{Binding SetBrushCommand}" CommandParameter="Walkway"
                                 Margin="4,4" FontSize="12" Cursor="Hand" ToolTip="Tô ô lưới làm lối đi (chi phí di chuyển 1)"/>
                    <RadioButton GroupName="GridBrushGroup" Content="Cửa ra vào (Entrance)" 
                                 Command="{Binding SetBrushCommand}" CommandParameter="Entrance"
                                 Margin="4,4" FontSize="12" Cursor="Hand" ToolTip="Đặt cửa ra vào xuất phát nhặt hàng"/>
                    <RadioButton GroupName="GridBrushGroup" Content="Quầy thu ngân (Checkout)" 
                                 Command="{Binding SetBrushCommand}" CommandParameter="Checkout"
                                 Margin="4,4" FontSize="12" Cursor="Hand" ToolTip="Đặt quầy thu ngân đích đến đơn hàng"/>
                    <RadioButton GroupName="GridBrushGroup" Content="Con trỏ chọn (Select)"
                                 Command="{Binding SetBrushCommand}" CommandParameter="Select"
                                 Margin="4,4" FontSize="12" Cursor="Hand" ToolTip="Nhấp để xem thông tin ô/kệ trên bản đồ"/>

                    <TextBlock Text="* Nhấp hoặc kéo chuột trái lên ô lưới bản đồ để tô màu theo loại đã chọn." 
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="4,8,4,4" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 2. Lưu, Reset & Thu Hồi Thay Đổi Ô Lưới (Lưới 2x2 Cân Đối Hoàn Toàn) -->
            <Grid Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Hàng 1, Cột 1: Nút Lưu Thay Đổi -->
                <Button Grid.Row="0" Grid.Column="0" Command="{Binding SaveCellChangesCommand}"
                        IsEnabled="{Binding IsDirty}"
                        Cursor="Hand"
                        ToolTip="Lưu các ô lưới vừa tô vào cơ sở dữ liệu">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="saveBorder" CornerRadius="6" 
                                    Background="{StaticResource PrimaryBrush}" 
                                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                    Padding="6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="saveIcon" Symbol="Save24" FontSize="13" Foreground="{StaticResource TextWhiteBrush}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="saveText" Text="Lưu thay đổi" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextWhiteBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="saveBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="saveBorder" Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                    <Setter TargetName="saveIcon" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter TargetName="saveText" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="saveBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Hàng 1, Cột 2: Nút Reset (Cùng kích thước 50%, thẳng hàng với Hủy thay đổi) -->
                <Button Grid.Row="0" Grid.Column="2" Command="{Binding ReloadLayoutCommand}"
                        Cursor="Hand"
                        ToolTip="Reset / Tải lại sơ đồ mới nhất từ máy chủ">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="resetBorder" CornerRadius="6" 
                                    Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                    Padding="6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Reset" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="resetBorder" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Hàng 2, Cột 1: Nút Hoàn Tác 1 Bước (Ctrl+Z) (Thẳng hàng với Lưu thay đổi) -->
                <Button Grid.Row="2" Grid.Column="0" Command="{Binding UndoLastStrokeCommand}"
                        IsEnabled="{Binding CanUndo}"
                        Cursor="Hand"
                        ToolTip="Hoàn tác nét vẽ vừa rồi (Ctrl+Z)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="undoBorder" CornerRadius="6" 
                                    Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                    Padding="6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Hoàn tác (Ctrl+Z)" FontWeight="Medium" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="undoBorder" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Hàng 2, Cột 2: Nút Thu Hồi / Hủy Toàn Bộ (Thẳng hàng với Reset) -->
                <Button Grid.Row="2" Grid.Column="2" Command="{Binding DiscardChangesCommand}"
                        IsEnabled="{Binding IsDirty}"
                        Cursor="Hand"
                        ToolTip="Hủy bỏ toàn bộ các ô lưới vừa tô chưa lưu">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="discardBorder" CornerRadius="6" 
                                    Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                    Padding="6,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Hủy thay đổi" FontWeight="Medium" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="discardBorder" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 3. Quản Lý Kệ Hàng & Khu Vực -->
            <TextBlock Text="KỆ HÀNG &amp; KHU VỰC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <StackPanel Margin="0,0,0,16" IsEnabled="{Binding CanEdit}">
                <Button Command="{Binding AddShelfQuickCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Height="38" Margin="0,0,0,8"
                        ToolTip="Thêm nhanh một khối kệ hàng 4x2 ô lên bản đồ">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="AddSquare24" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Thêm Kệ Hàng Nhanh" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding AddZoneQuickCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Height="38" Margin="0,0,0,8"
                        ToolTip="Thêm nhanh một khu vực chức năng lên bản đồ">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Table24" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Thêm Khu Vực Nhanh" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <!-- Shelf Selection & Movement Controls -->
                <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="10" Margin="0,4,0,8">
                    <StackPanel>
                        <TextBlock Text="DI CHUYỂN KỆ HÀNG" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        
                        <!-- Shelf Selector Dropdown -->
                        <ComboBox ItemsSource="{Binding Layout.Shelves}" 
                                  SelectedItem="{Binding SelectedShelf}"
                                  Height="32" FontSize="11.5" Margin="0,0,0,8"
                                  ToolTip="Chọn kệ hàng để di chuyển vị trí">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Controls visible when a shelf is selected -->
                        <StackPanel Visibility="{Binding HasSelectedShelf, Converter={StaticResource BoolToVis}}">
                            <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedShelf.Code, StringFormat='Mã kệ: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedShelf.PositionX, StringFormat='Tọa độ: X={0}'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedShelf.PositionY, StringFormat='Tọa độ: Y={0}'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedShelf.Width, StringFormat='Kích thước: {0}m x {0}m'}" FontSize="10" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <!-- Directional Nudge Pad (Up, Down, Left, Right) -->
                            <TextBlock Text="Bấm nút hoặc kéo thả trên bản đồ:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Grid Width="120" HorizontalAlignment="Center" Margin="0,4,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- Up -->
                                <Button Grid.Row="0" Grid.Column="1" Command="{Binding MoveSelectedShelfCommand}" CommandParameter="Up"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển kệ lên trên (Y - 1)">
                                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <!-- Left -->
                                <Button Grid.Row="1" Grid.Column="0" Command="{Binding MoveSelectedShelfCommand}" CommandParameter="Left"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển kệ sang trái (X - 1)">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <!-- Center Icon -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Margin="2">
                                    <ui:SymbolIcon Symbol="Grid24" FontSize="13" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Right -->
                                <Button Grid.Row="1" Grid.Column="2" Command="{Binding MoveSelectedShelfCommand}" CommandParameter="Right"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển kệ sang phải (X + 1)">
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <!-- Down -->
                                <Button Grid.Row="2" Grid.Column="1" Command="{Binding MoveSelectedShelfCommand}" CommandParameter="Down"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển kệ xuống dưới (Y + 1)">
                                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Command="{Binding DeselectShelfCommand}"
                                        Height="26" Padding="8,0" Cursor="Hand" Margin="0,0,6,0"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <TextBlock Text="Bỏ chọn" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Command="{Binding DeleteSelectedShelfCommand}"
                                        Height="26" Padding="8,0" Cursor="Hand"
                                        Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="Xóa kệ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="* Bạn có thể nhấn giữ và kéo trực tiếp kệ hàng trên bản đồ để di chuyển nhanh." 
                                   FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Zone Selection & Movement Controls -->
                <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="10" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="DI CHUYỂN KHU VỰC" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        
                        <!-- Zone Selector Dropdown -->
                        <ComboBox ItemsSource="{Binding Layout.Zones}" 
                                  SelectedItem="{Binding SelectedZone}"
                                  Height="32" FontSize="11.5" Margin="0,0,0,8"
                                  ToolTip="Chọn khu vực để di chuyển vị trí">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Controls visible when a zone is selected -->
                        <StackPanel Visibility="{Binding HasSelectedZone, Converter={StaticResource BoolToVis}}">
                            <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedZone.Code, StringFormat='Mã: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedZone.PositionX, StringFormat='Tọa độ: X={0}'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedZone.PositionY, StringFormat='Tọa độ: Y={0}'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedZone.Width, StringFormat='Kích thước: {0}m x {0}m'}" FontSize="10" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <!-- Directional Nudge Pad (Up, Down, Left, Right) -->
                            <TextBlock Text="Bấm nút hoặc kéo thả trên bản đồ:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Grid Width="120" HorizontalAlignment="Center" Margin="0,4,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- Up -->
                                <Button Grid.Row="0" Grid.Column="1" Command="{Binding MoveSelectedZoneCommand}" CommandParameter="Up"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển lên trên (Y - 1)">
                                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <!-- Left -->
                                <Button Grid.Row="1" Grid.Column="0" Command="{Binding MoveSelectedZoneCommand}" CommandParameter="Left"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển sang trái (X - 1)">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <!-- Center Icon -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Margin="2">
                                    <ui:SymbolIcon Symbol="Table24" FontSize="13" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Right -->
                                <Button Grid.Row="1" Grid.Column="2" Command="{Binding MoveSelectedZoneCommand}" CommandParameter="Right"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển sang phải (X + 1)">
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                                <!-- Down -->
                                <Button Grid.Row="2" Grid.Column="1" Command="{Binding MoveSelectedZoneCommand}" CommandParameter="Down"
                                        Padding="0" Cursor="Hand" ToolTip="Di chuyển xuống dưới (Y + 1)">
                                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Command="{Binding DeselectZoneCommand}"
                                        Height="26" Padding="8,0" Cursor="Hand" Margin="0,0,6,0"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <TextBlock Text="Bỏ chọn" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Command="{Binding DeleteSelectedZoneCommand}"
                                        Height="26" Padding="8,0" Cursor="Hand"
                                        Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="Xóa khu vực" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="* Bạn có thể nhấn giữ và kéo trực tiếp khung khu vực trên bản đồ để di chuyển nhanh." 
                                   FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Info card -->
            <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Mẹo thiết kế:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="1. Đảm bảo có ít nhất 1 ô Entrance và 1 ô Checkout." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Text="2. Kệ hàng cần tiếp giáp ô Walkway để robot/nhân viên có lối lấy hàng." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
