<UserControl x:Class="POS.WinUI.Views.SmartStore.Components.StoreLayoutInfoSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignWidth="310">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <!-- 1. THÔNG TIN MẶT BẰNG -->
            <TextBlock Text="THÔNG TIN MẶT BẰNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource InputBackgroundBrush}" 
                    CornerRadius="10" 
                    BorderBrush="{StaticResource InputBorderBrush}" 
                    BorderThickness="1" 
                    Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentLayout.Name, FallbackValue='(Chưa chọn mặt bằng)'}" 
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    
                    <Border CornerRadius="4" Padding="6,2" Margin="0,4,0,10" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLayout.IsActive}" Value="True">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentLayout.IsDraft}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentLayout.Status, FallbackValue='None'}" FontSize="10.5" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLayout.IsActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentLayout.IsDraft}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Stats 2x2 Grid -->
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Kích thước:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentLayout.GridWidth, StringFormat='{}{0}m'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentLayout.GridHeight, StringFormat='x {0}m'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Khu vực &amp; Kệ:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentLayout.Zones.Count, StringFormat='{}{0} Khu vực'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentLayout.Shelves.Count, StringFormat='{}{0} Kệ hàng'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Tổng ô lưới:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentLayout.Cells.Count, StringFormat='{}{0} ô'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Phiên bản:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CurrentLayout.VersionNumber, StringFormat='Version {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. CHÚ GIẢI BẢN ĐỒ (LEGEND) -->
            <TextBlock Text="CHÚ GIẢI KÝ HIỆU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource InputBackgroundBrush}" 
                    CornerRadius="10" 
                    BorderBrush="{StaticResource InputBorderBrush}" 
                    BorderThickness="1" 
                    Padding="10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#22C55E" Margin="0,0,6,0"/>
                        <TextBlock Text="Lối vào" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Thu ngân" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#1E293B" Margin="0,0,6,0"/>
                        <TextBlock Text="Kệ hàng" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#CBD5E1" Margin="0,0,6,0"/>
                        <TextBlock Text="Vật cản" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="#3B82F6" BorderThickness="1.5" Background="#153B82F6" Margin="0,0,6,0"/>
                        <TextBlock Text="Phân khu" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0.5" Margin="0,0,6,0"/>
                        <TextBlock Text="Lối đi" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. HƯỚNG DẪN ĐIỀU KHIỂN -->
            <TextBlock Text="HƯỚNG DẪN THAO TÁC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <Border Background="{StaticResource InputBackgroundBrush}" 
                    CornerRadius="10" 
                    BorderBrush="{StaticResource InputBorderBrush}" 
                    BorderThickness="1" 
                    Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Thao tác chuột &amp; Phím tắt:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="• Kéo chuột trái hoặc chuột phải để di chuyển sơ đồ." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="• Lăn bánh xe chuột (hoặc phím +/-) để phóng to / thu nhỏ." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="• Phím mũi tên (← ↑ → ↓) để dịch chuyển bản đồ." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="• Nhấp chuột trái vào kệ hàng để xem các sản phẩm đã gán." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
