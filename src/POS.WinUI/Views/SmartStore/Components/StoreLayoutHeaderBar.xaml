<UserControl x:Class="POS.WinUI.Views.SmartStore.Components.StoreLayoutHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:auth="clr-namespace:POS.WinUI.Resources.Markup"
             mc:Ignorable="d" 
             d:DesignWidth="1000">

    <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Title & Subtitle (Breadcrumb is handled by Shell) -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="12" 
                    Background="{StaticResource PrimaryLightBrush}" 
                    BorderBrush="{StaticResource PrimaryBorderBrush}" 
                    BorderThickness="1" Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="Map24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mặt bằng &amp; Kho kệ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Quản lý sơ đồ mặt bằng, phân bổ kho kệ và tối ưu lộ trình nhặt hàng" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Right: Action Buttons with RBAC and Tooltips -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 1. Create Draft Layout -->
            <Button Command="{Binding OpenCreateDialogCommand}"
                    Height="36" Padding="16,0" Cursor="Hand"
                    ToolTip="Tạo mới sơ đồ mặt bằng ở trạng thái bản thảo (Draft)"
                    Visibility="{auth:HasRole 'Owner,StoreManager'}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="8" 
                                Background="{StaticResource PrimaryBrush}" 
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="{StaticResource TextWhiteBrush}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tạo bản thảo" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 2. Clone Layout -->
            <Button Command="{Binding OpenCloneDialogCommand}"
                    Style="{StaticResource SmallOutlineButtonStyle}"
                    Height="36" Margin="8,0,0,0" Padding="12,0"
                    ToolTip="Nhân bản mặt bằng hiện tại thành bản mới"
                    Visibility="{auth:HasRole 'Owner,StoreManager'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="Nhân bản" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- 3. Publish Layout (Draft only) -->
            <Button Command="{Binding OpenPublishConfirmCommand}"
                    Height="36" Margin="8,0,0,0" Padding="12,0" Cursor="Hand"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    ToolTip="Kích hoạt mặt bằng này làm mặt bằng chính thức của cửa hàng"
                    Visibility="{Binding CanPublishCurrentLayout, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Kích hoạt" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 4. Archive Layout -->
            <Button Command="{Binding OpenArchiveConfirmCommand}"
                    Style="{StaticResource SmallOutlineButtonStyle}"
                    Height="36" Margin="8,0,0,0" Padding="12,0"
                    ToolTip="Lưu trữ mặt bằng này"
                    Visibility="{auth:HasRole 'Owner'}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Archive24" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Lưu trữ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
