<UserControl x:Class="POS.WinUI.Views.SmartStore.Components.StoreLayoutToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:POS.WinUI.ViewModels.SmartStore.Models"
             mc:Ignorable="d" 
             d:DesignWidth="1000">

    <Border Background="{StaticResource CardBackgroundBrush}" 
            CornerRadius="10" 
            BorderBrush="{StaticResource InputBorderBrush}" 
            BorderThickness="1" 
            Padding="12,6" 
            Margin="0,0,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Layout Dropdown Selector & Revision -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Mặt bằng:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                
                <ComboBox ItemsSource="{Binding Layouts}" 
                          SelectedItem="{Binding SelectedLayoutSummary}"
                          Width="250" Height="36" 
                          VerticalContentAlignment="Center" FontSize="12"
                          ToolTip="Chọn sơ đồ mặt bằng để hiển thị và thao tác">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:StoreLayoutSummaryItem}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="5,2" Margin="6,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDraft}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDraft}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Revision Tag -->
                <Border Margin="10,0,0,0" CornerRadius="6" Padding="8,4" 
                        Background="{StaticResource InputBackgroundBrush}" 
                        BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center"
                        ToolTip="Mã số phiên bản sửa đổi của mặt bằng">
                    <TextBlock Text="{Binding CurrentLayout.Revision, StringFormat='Revision #{0}'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Right: Segmented Mode Switcher (Unified 36px Height) -->
            <Border Grid.Column="2" 
                    Background="{StaticResource SegmentedBackgroundBrush}" 
                    CornerRadius="8" Padding="3"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Mode 1: View Map -->
                    <Button Command="{Binding SwitchModeCommand}" CommandParameter="Map"
                            Height="32" Padding="12,0" Cursor="Hand"
                            ToolTip="Xem bản đồ tổng quan, các khu vực và kệ hàng">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Eye24" FontSize="13" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMapMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="Xem Sơ Đồ" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMapMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Mode 2: Grid & Shelves Designer -->
                    <Button Command="{Binding SwitchModeCommand}" CommandParameter="Design"
                            Height="32" Padding="12,0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Thiết kế lưới ô, lối đi và vị trí kệ hàng (Chỉ ở trạng thái Bản thảo)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDesignMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="13" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDesignMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="Thiết Kế Lưới" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDesignMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Mode 3: SKU Placement -->
                    <Button Command="{Binding SwitchModeCommand}" CommandParameter="Placement"
                            Height="32" Padding="12,0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Gán sản phẩm SKU lên từng tầng kệ hoặc quét mã vạch">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlacementMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="13" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlacementMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="Gán Vị Trí SKU" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlacementMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Mode 4: Smart Picking -->
                    <Button Command="{Binding SwitchModeCommand}" CommandParameter="Picking"
                            Height="32" Padding="12,0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Tính toán và xem trước lộ trình nhặt hàng tối ưu cho đơn hàng">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPickingMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="13" Margin="0,0,6,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPickingMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="Smart Picking" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPickingMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
