<UserControl x:Class="POS.WinUI.Views.SmartStore.Components.CreateLayoutModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignWidth="600" d:DesignHeight="500">

    <Grid Background="#75000000" Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVis}}">
        <Border Width="460" 
                Background="{StaticResource CardBackgroundBrush}" 
                CornerRadius="16" 
                BorderBrush="{StaticResource InputBorderBrush}" 
                BorderThickness="1" 
                Padding="24" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#1E0A02" Opacity="0.25" ShadowDepth="15" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Modal Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="AddSquare24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tạo Bản Thảo Mặt Bằng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Khởi tạo sơ đồ lưới mặt bằng mới cho cửa hàng" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Command="{Binding CloseCreateDialogCommand}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>

                <!-- Input: Name -->
                <TextBlock Text="Tên mặt bằng *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewLayoutName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="44" VerticalContentAlignment="Center" FontSize="13"
                         Padding="12,0" Margin="0,0,0,14"/>

                <!-- Inputs: Dimensions (2 Columns) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Chiều rộng (m) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewLayoutWidth, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="44" VerticalContentAlignment="Center" FontSize="13" Padding="12,0"
                                 ToolTip="Số ô lưới chiều ngang (tối thiểu 4m, tối đa 100m)"/>
                        <TextBlock Text="Tối thiểu 4m, tối đa 100m" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" Margin="2,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Chiều dài (m) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewLayoutHeight, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="44" VerticalContentAlignment="Center" FontSize="13" Padding="12,0"
                                 ToolTip="Số ô lưới chiều dọc (tối thiểu 4m, tối đa 100m)"/>
                        <TextBlock Text="Tối thiểu 4m, tối đa 100m" FontSize="10" Foreground="{StaticResource TextPlaceholderBrush}" Margin="2,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Checkbox Copy Option -->
                <CheckBox IsChecked="{Binding NewLayoutCopyFromActive}" 
                          Content="Sao chép cấu trúc từ mặt bằng đang chạy (Active)" 
                          FontSize="12" Margin="0,0,0,16"/>

                <!-- Action Buttons -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding CloseCreateDialogCommand}" 
                            Style="{StaticResource OutlineButtonStyle}"
                            Height="44" Content="Hủy bỏ" FontSize="13" FontWeight="SemiBold"/>

                    <Button Grid.Column="2" Command="{Binding CreateLayoutCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44" FontSize="13" FontWeight="Bold"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Tạo Bản Thảo" Foreground="{StaticResource TextWhiteBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
