<UserControl x:Class="POS.WinUI.Views.Promotions.Components.VoucherTableComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ 1. BỘ LỌC VOUCHER ════════════════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding ClearVoucherFiltersCommand}"
                        Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="14,0" Cursor="Hand" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa bộ lọc" FontSize="12.5"/>
                    </StackPanel>
                </Button>

                <shared:TextInputField Height="40" Icon="Search24"
                                      Text="{Binding VoucherSearchCode, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="Tìm nhanh mã Voucher (ví dụ: TET2026, CHAOMUNG, VIP10)..."/>
            </DockPanel>
        </Border>

        <!-- ════════════════════ 2. BẢNG DỮ LIỆU VOUCHER ════════════════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding Vouchers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="50">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Mã Voucher -->
                            <DataGridTemplateColumn Header="MÃ VOUCHER" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" Margin="14,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="14" Foreground="#EA580C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Code}" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#C2410C" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thuộc chương trình -->
                            <DataGridTemplateColumn Header="CHƯƠNG TRÌNH KHUYẾN MÃI" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PromotionName, TargetNullValue='Chương trình liên kết'}" 
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Lượt đã dùng / Tối đa -->
                            <DataGridTemplateColumn Header="LƯỢT SỬ DỤNG" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="{Binding UsedCount}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text=" / " FontSize="12.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding MaxUses}" FontSize="12.5" Foreground="#64748B"/>
                                            <TextBlock Text=" lượt" FontSize="11.5" Foreground="#94A3B8" Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Giới hạn / Khách -->
                            <DataGridTemplateColumn Header="GIỚI HẠN / KHÁCH" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PerCustomerLimit, StringFormat='{}{0} lần/khách'}" 
                                                   FontSize="12.5" Foreground="#475569" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hạn dùng -->
                            <DataGridTemplateColumn Header="HẠN SỬ DỤNG" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="14" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ExpiresAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='Vô thời hạn'}" 
                                                       FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Setter Property="Text" Value="Hoạt động"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Tạm khóa"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Loading State -->
                <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True" 
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsVoucherEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Width="64" Height="64" CornerRadius="20" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="28" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chưa có mã Voucher nào được phát hành" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bấm '+ Phát hành Voucher' để tạo mã ưu đãi gửi tặng khách hàng" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ 3. PHÂN TRANG ════════════════════ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12.5" Foreground="#64748B">
                    <Run Text="Trang "/><Run Text="{Binding VoucherPageNumber}" FontWeight="Bold" Foreground="#0F172A"/><Run Text=" / "/><Run Text="{Binding VoucherTotalPages}"/>
                </TextBlock>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousVoucherPageCommand}" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="12,0" Margin="0,0,8,0" Cursor="Hand" Content="&lt; Trước"/>
                    <Button Command="{Binding NextVoucherPageCommand}" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="12,0" Cursor="Hand" Content="Sau &gt;"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
