<UserControl x:Class="POS.WinUI.Views.Promotions.Components.PromotionEditModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid Background="#66000000" MouseDown="OnBackdropMouseDown">
        <Border Width="680" MaxHeight="720" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                CornerRadius="18" Padding="26"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.3"/>
            </Border.Effect>

            <Grid DataContext="{Binding PromotionFormDialog}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Popup -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DialogTitle}" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding DialogSubtitle}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding DataContext.CloseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- 2. Body Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Thông báo lỗi (Error Banner) -->
                        <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Foreground="{StaticResource DangerTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tên chương trình khuyến mãi -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Tên chương trình khuyến mãi *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <shared:TextInputField Height="44" Icon="TicketDiagonal24" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: Giảm giá Tri Ân Khách Hàng Thân Thiết"/>
                        </StackPanel>

                        <!-- Loại khuyến mãi & Giá trị giảm -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hình thức ưu đãi *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <ComboBox Height="44" ItemsSource="{Binding TypeOptions}" DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedType, Mode=TwoWay}" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mức giảm giá *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <shared:TextInputField Height="44" Icon="ReceiptMoney24" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 10 (% hoặc VNĐ)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Đơn hàng tối thiểu & Mức giảm tối đa -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Đơn hàng tối thiểu (VNĐ)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <shared:TextInputField Height="44" Icon="Tag24" Text="{Binding MinOrderAmountText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mức giảm tối đa (VNĐ)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <shared:TextInputField Height="44" Icon="MoneyHand24" Text="{Binding MaxDiscountAmountText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Để trống nếu không giới hạn"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thời hạn áp dụng -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày bắt đầu hiệu lực *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <DatePicker Height="44" SelectedDate="{Binding ValidFrom, Mode=TwoWay}" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày kết thúc" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <DatePicker Height="44" SelectedDate="{Binding ValidTo, Mode=TwoWay}" FontSize="13" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Điều kiện cộng dồn & độc quyền -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsStackable, Mode=TwoWay}" Margin="0,0,0,8">
                                    <TextBlock Text="Cho phép cộng dồn với các khuyến mãi khác" FontSize="12.5" Foreground="#334155"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding IsExclusive, Mode=TwoWay}">
                                    <TextBlock Text="Khuyến mãi độc quyền (chặn mọi ưu đãi khác khi áp dụng)" FontSize="12.5" Foreground="#334155"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Footer Buttons -->
                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ"
                                Command="{Binding DataContext.CloseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource OutlineButtonStyle}" Height="42" HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="2" 
                                Command="{Binding DataContext.SavePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="42" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,8,0"
                                                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Xác nhận lưu" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
