<UserControl x:Class="POS.WinUI.Views.Promotions.Components.VoucherCreateModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid Background="#66000000" MouseDown="OnBackdropMouseDown">
        <Border Width="540" MaxHeight="600" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                CornerRadius="18" Padding="26"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.3"/>
            </Border.Effect>

            <Grid DataContext="{Binding VoucherCreateDialog}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Popup -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Phát hành mã Voucher" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Tạo mã giảm giá độc quyền áp dụng cho khách hàng" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding DataContext.CloseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- 2. Body Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Thông báo lỗi (Error Banner) -->
                        <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Foreground="{StaticResource DangerTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Thông tin chương trình liên kết -->
                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CHƯƠNG TRÌNH KHUYẾN MÃI LIÊN KẾT" FontSize="11" FontWeight="Bold" Foreground="#C2410C"/>
                                <TextBlock Text="{Binding PromotionName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Mã Voucher -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Mã ký tự Voucher * (In hoa, không dấu, không khoảng trắng)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <shared:TextInputField Height="44" Icon="Tag24" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: TET2026, VIP10, CHAOMUNG"/>
                        </StackPanel>

                        <!-- Số lượt phát hành & Giới hạn mỗi khách -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số lượt dùng tối đa *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <shared:TextInputField Height="44" Icon="NumberSymbol24" Text="{Binding MaxUsesText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới hạn / Khách hàng *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <shared:TextInputField Height="44" Icon="Person24" Text="{Binding PerCustomerLimitText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="1"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ngày hết hạn -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Ngày hết hạn của mã (để trống nếu vô thời hạn)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <DatePicker Height="44" SelectedDate="{Binding ExpiresAt, Mode=TwoWay}" FontSize="13" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Footer Buttons -->
                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ"
                                Command="{Binding DataContext.CloseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource OutlineButtonStyle}" Height="42" HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="2" 
                                Command="{Binding DataContext.SaveVoucherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="42" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,8,0"
                                                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Phát hành Voucher" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
