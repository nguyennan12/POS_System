<UserControl x:Class="POS.WinUI.Views.Promotions.Components.PromotionTableComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ 1. BỘ LỌC CHƯƠNG TRÌNH KHUYẾN MÃI ════════════════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding ClearPromoFiltersCommand}"
                        Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="14,0" Cursor="Hand" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa bộ lọc" FontSize="12.5"/>
                    </StackPanel>
                </Button>

                <shared:TextInputField Height="40" Icon="Search24"
                                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="Tìm nhanh theo tên chương trình khuyến mãi..."/>
            </DockPanel>
        </Border>

        <!-- ════════════════════ 2. BẢNG DỮ LIỆU CHƯƠNG TRÌNH ════════════════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding Promotions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="50">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Tên chương trình -->
                            <DataGridTemplateColumn Header="TÊN CHƯƠNG TRÌNH KHUYẾN MÃI" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="#FFF7ED" Margin="0,0,10,0">
                                                <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Loại khuyến mãi -->
                            <DataGridTemplateColumn Header="LOẠI HÌNH ƯU ĐÃI" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <TextBlock Text="{Binding Type}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Mức giảm -->
                            <DataGridTemplateColumn Header="MỨC GIẢM" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value, StringFormat='{}{0:G29}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thời hạn -->
                            <DataGridTemplateColumn Header="THỜI HẠN ÁP DỤNG" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="{Binding ValidFrom, StringFormat='{}Từ: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding ValidTo, StringFormat='{}Đến: {0:dd/MM/yyyy}', TargetNullValue='Đến: Vô thời hạn'}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Text" Value="Đang chạy"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                <Setter Property="Text" Value="Tạm dừng"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <!-- Sửa -->
                                            <Button Command="{Binding DataContext.OpenEditPromotionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Chỉnh sửa chương trình"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="15" Foreground="#2563EB"/>
                                            </Button>

                                            <!-- Phát hành voucher cho CT này -->
                                            <Button Command="{Binding DataContext.OpenIssueVoucherForPromoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Phát hành mã Voucher cho chương trình này"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="15" Foreground="#EA580C"/>
                                            </Button>

                                            <!-- Ngừng CT -->
                                            <Button Command="{Binding DataContext.DeletePromotionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Ngừng chương trình"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Loading State -->
                <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True" 
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsPromoEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Width="64" Height="64" CornerRadius="20" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="28" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chưa có chương trình khuyến mãi nào" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bấm '+ Tạo chương trình mới' để thiết lập ưu đãi giảm giá" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ 3. PHÂN TRANG ════════════════════ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12.5" Foreground="#64748B">
                    <Run Text="Trang "/><Run Text="{Binding PageNumber}" FontWeight="Bold" Foreground="#0F172A"/><Run Text=" / "/><Run Text="{Binding TotalPages}"/>
                </TextBlock>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousPromoPageCommand}" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="12,0" Margin="0,0,8,0" Cursor="Hand" Content="&lt; Trước"/>
                    <Button Command="{Binding NextPromoPageCommand}" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="12,0" Cursor="Hand" Content="Sau &gt;"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
