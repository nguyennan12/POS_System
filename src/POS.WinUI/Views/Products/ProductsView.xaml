<UserControl x:Class="POS.WinUI.Views.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:POS.WinUI.Views.Products"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">

    <Grid>
        <!-- Vùng nội dung trang có padding lề chuẩn -->
        <Grid Margin="28,16,28,24">
            <!-- Main Layout Rows -->
            <Grid.RowDefinitions>
            <!-- Row 0: Top Header & Metric Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Segmented Tab Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Tab Content (Products or Categories) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ ROW 0: HEADER & METRIC STATS ════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title & Global Action Buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Box24" FontSize="22" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Actions: Refresh & New Product -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LoadProductsCommand}" 
                            Height="38" Padding="14,0" Margin="0,0,10,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Làm mới danh sách sản phẩm">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportExcelCommand}" 
                            Height="38" Padding="14,0" Margin="0,0,10,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Nhập hàng loạt sản phẩm và SKU từ file Excel (.xlsx, .xls)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nhập Excel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenCreateCategoryModalCommand}" 
                            Height="38" Padding="14,0" Margin="0,0,10,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Thêm mới danh mục hàng">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="15" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm danh mục" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenCreateProductModalCommand}" 
                            Height="38" Padding="16,0" 
                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                            ToolTip="Tạo mới sản phẩm &amp; biến thể">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{StaticResource PrimaryBrush}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="#D97706" Opacity="0.22" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thêm sản phẩm mới" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Metric Cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Tổng sản phẩm -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TỔNG SẢN PHẨM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalProductsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#EFF6FF">
                            <ui:SymbolIcon Symbol="Box24" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Đang kinh doanh -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ĐANG KINH DOANH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ActiveProductsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#ECFDF5">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Biến thể SKU -->
                <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BIẾN THỂ SKU &amp; MÃ VẠCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalSkusCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#8B5CF6" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#F5F3FF">
                            <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="20" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4: Danh mục -->
                <Border Grid.Column="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DANH MỤC HÀNG HÓA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCategoriesCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#FFFBEB">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ════════════════════ ROW 1: SEGMENTED TAB SELECTOR ════════════════════ -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="12" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <!-- Tab 1: Danh sách hàng hóa -->
                <RadioButton Content="📦 Danh sách sản phẩm &amp; SKU" 
                             GroupName="ProductViewTabs"
                             IsChecked="{Binding IsProductViewMode, Mode=TwoWay}"
                             Padding="16,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="tabBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.08" ShadowDepth="1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Tab 2: Quản lý danh mục -->
                <RadioButton Content="🗂️ Quản lý cây danh mục" 
                             GroupName="ProductViewTabs"
                             IsChecked="{Binding IsCategoryViewMode, Mode=TwoWay}"
                             Padding="16,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="4,0,0,0">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="tabBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.08" ShadowDepth="1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ════════════════════ ROW 2: TAB CONTENT ════════════════════ -->
        <!-- VIEW 1: PRODUCT LIST & SKU EXPANSION -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" 
                CornerRadius="16" Padding="20"
                Visibility="{Binding IsProductViewMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Filter Toolbar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Product Table -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Pagination & Status Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FILTER TOOLBAR -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <!-- Ô tìm kiếm linh hoạt -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Lọc theo danh mục -->
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Lọc theo trạng thái -->
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <!-- Nút Lọc & Đặt lại -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource CleanTextBoxStyle}" 
                                     FontSize="13" Height="36"
                                     ToolTip="Tìm kiếm theo tên sản phẩm, mã vạch SKU...">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" 
                                    Visibility="{Binding SearchKeyword, Converter={StaticResource StringToVisibilityConverter}}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Category Filter Dropdown -->
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding CategoryFilterOptions}" 
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Height="38" FontSize="13">
                    </ComboBox>

                    <!-- Status Filter Dropdown -->
                    <ComboBox Grid.Column="4" 
                              ItemsSource="{Binding StatusFilterOptions}" 
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              Height="38" FontSize="13">
                    </ComboBox>

                    <!-- Nút thao tác bộ lọc (Đặt lại & Tìm) -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button Command="{Binding ClearSearchCommand}" 
                                Height="38" Padding="12,0" Margin="0,0,8,0"
                                Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="Xóa tất cả bộ lọc và hiển thị tất cả hàng hóa">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đặt lại" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding SearchCommand}" 
                                Height="38" Padding="14,0" 
                                Background="{StaticResource PrimaryLightBrush}" 
                                BorderBrush="{StaticResource PrimaryBorderBrush}" 
                                BorderThickness="1" Cursor="Hand" ToolTip="Tìm kiếm theo bộ lọc">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Filter24" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lọc tìm" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- PRODUCT DATA LIST & EMPTY STATE -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="850">
                        <!-- Table Column Headers (Các cột có độ rộng cố định cân đối, không bao giờ bị cắt chữ) -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>                              <!-- 0: Expand Chevron -->
                                    <ColumnDefinition Width="2*" MinWidth="180"/>              <!-- 1: Sản phẩm & Thương hiệu -->
                                    <ColumnDefinition Width="130"/>                             <!-- 2: Danh mục -->
                                    <ColumnDefinition Width="80"/>                              <!-- 3: Đơn vị tính -->
                                    <ColumnDefinition Width="110"/>                             <!-- 4: Trạng thái kinh doanh -->
                                    <ColumnDefinition Width="110"/>                             <!-- 5: Ngày tạo -->
                                    <ColumnDefinition Width="115"/>                             <!-- 6: Thao tác -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="SẢN PHẨM &amp; THƯƠNG HIỆU" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="DANH MỤC" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="ĐƠN VỊ" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="NGÀY TẠO" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="THAO TÁC" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Products Rows ItemsControl (Hiển thị khi có dữ liệu) -->
                        <ItemsControl ItemsSource="{Binding Products}" Visibility="{Binding HasProducts, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,12">
                                        <StackPanel>
                                            <!-- Main Product Row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>                              <!-- 0: Expand Chevron -->
                                                    <ColumnDefinition Width="2*" MinWidth="180"/>              <!-- 1: Sản phẩm & Thương hiệu -->
                                                    <ColumnDefinition Width="130"/>                             <!-- 2: Danh mục -->
                                                    <ColumnDefinition Width="80"/>                              <!-- 3: Đơn vị tính -->
                                                    <ColumnDefinition Width="110"/>                             <!-- 4: Trạng thái kinh doanh -->
                                                    <ColumnDefinition Width="110"/>                             <!-- 5: Ngày tạo -->
                                                    <ColumnDefinition Width="115"/>                             <!-- 6: Thao tác -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Expand Button -->
                                                <Button Grid.Column="0" 
                                                        Command="{Binding DataContext.ToggleProductExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="30" Height="30" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" ToolTip="Xem danh sách biến thể SKU">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Button>

                                                <!-- Product Name & Brand -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Brand, TargetNullValue='Thương hiệu: -'}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Category Name -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" MaxWidth="140">
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Base Unit -->
                                                <TextBlock Grid.Column="3" Text="{Binding BaseUnit}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="4" Background="{Binding StatusBadgeBackground}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForeground}"/>
                                                </Border>

                                                <!-- Created At -->
                                                <TextBlock Grid.Column="5" Text="{Binding CreatedAtFormatted}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Sửa -->
                                                    <Button Command="{Binding DataContext.OpenEditProductModalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" Background="#EFF6FF" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Chỉnh sửa sản phẩm &amp; SKU">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="#2563EB"/>
                                                    </Button>

                                                    <!-- In Barcode -->
                                                    <Button Command="{Binding DataContext.OpenBarcodeModalForProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" Background="#FFF7ED" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" ToolTip="In tem mã vạch sản phẩm">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <ui:SymbolIcon Symbol="Print24" FontSize="14" Foreground="{StaticResource PrimaryBrush}"/>
                                                    </Button>

                                                    <!-- Toggle Status -->
                                                    <Button Command="{Binding DataContext.ToggleProductStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" Background="#F8FAFC" BorderThickness="1" BorderBrush="{StaticResource InputBorderBrush}" Cursor="Hand" ToolTip="Bật / Tắt kinh doanh">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <ui:SymbolIcon Symbol="Power24" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Expanded SKU Table -->
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="46,12,0,4" Padding="14,10"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="CHI TIẾT CÁC BIẾN THỂ SKU &amp; MÃ VẠCH:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="Đang tải dữ liệu SKU..." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                                                   Visibility="{Binding IsLoadingSkus, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>

                                                    <!-- SKU Items -->
                                                    <ItemsControl ItemsSource="{Binding Skus}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="160"/>
                                                                            <ColumnDefinition Width="150"/>
                                                                            <ColumnDefinition Width="120"/>
                                                                            <ColumnDefinition Width="110"/>
                                                                            <ColumnDefinition Width="120"/>
                                                                            <ColumnDefinition Width="90"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                            <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding SkuCode}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                                        <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding AttributesDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                                                        </Border>

                                                                        <TextBlock Grid.Column="3" Text="{Binding FormattedCostPrice, StringFormat='Vốn: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                                        <TextBlock Grid.Column="4" Text="{Binding FormattedSellPrice, StringFormat='Bán: {0}'}" FontSize="12.5" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>

                                                                        <TextBlock Grid.Column="5" Text="{Binding ProfitMargin, StringFormat='Lãi: {0}'}" FontSize="11.5" Foreground="#D97706" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                                        <!-- Action In tem cho SKU này -->
                                                                        <Button Grid.Column="7" 
                                                                                Command="{Binding DataContext.OpenBarcodeModalCommand, RelativeSource={RelativeSource AncestorType=local:ProductsView}}"
                                                                                CommandParameter="{Binding}"
                                                                                Height="26" Padding="10,0"
                                                                                Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" Cursor="Hand">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="Print24" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,4,0"/>
                                                                                <TextBlock Text="In tem" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State (Hiển thị khi không có sản phẩm nào) -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="40,48" Margin="0,16,0,0"
                                Visibility="{Binding HasNoProducts, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#FFF7ED" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <ui:SymbolIcon Symbol="BoxDismiss24" FontSize="30" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Không tìm thấy sản phẩm nào" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Không có mặt hàng nào phù hợp với bộ lọc hiện tại. Hãy thử chọn danh mục khác hoặc đặt lại bộ lọc." 
                                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,20" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap"/>
                                <Button Command="{Binding ClearSearchCommand}"
                                        Height="38" Padding="18,0" HorizontalAlignment="Center"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="15" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Đặt lại bộ lọc tìm kiếm" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGINATION & STATUS FOOTER -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bên trái: Số lượng & Trạng thái -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PaginationSummary}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="#059669" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Medium" Foreground="#065F46" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bên phải: Các nút phân trang -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousPageCommand}" 
                                IsEnabled="{Binding HasPreviousPage}"
                                Height="36" Padding="14,0" Margin="0,0,8,0"
                                Style="{StaticResource SmallOutlineButtonStyle}"
                                ToolTip="Trang trước">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Trang trước" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,0" Height="36" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentPage, StringFormat='Trang {0}'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Border>

                        <Button Command="{Binding NextPageCommand}" 
                                IsEnabled="{Binding HasNextPage}"
                                Height="36" Padding="14,0" 
                                Style="{StaticResource SmallOutlineButtonStyle}"
                                ToolTip="Trang sau">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Trang sau" FontSize="12.5" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- VIEW 2: CATEGORY TREE MANAGEMENT -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" 
                CornerRadius="16" Padding="24"
                Visibility="{Binding IsCategoryViewMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CÂY PHÂN CẤP DANH MỤC HÀNG HÓA" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Quản lý các nhóm sản phẩm, hỗ trợ phân cấp cha - con để hiển thị trực quan trên POS quầy bán hàng" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" 
                            Command="{Binding OpenCreateCategoryModalCommand}"
                            Height="38" Padding="16,0" 
                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                            ToolTip="Thêm danh mục mới">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{StaticResource PrimaryBrush}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="#D97706" Opacity="0.22" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thêm danh mục mới" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Category Tree Table -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TÊN DANH MỤC PHÂN CẤP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="THỨ TỰ HIỂN THỊ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="HIỂN THỊ POS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="THAO TÁC" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CategoriesTree}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Parent Category Row -->
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,12" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Category Name & Expand Dropdown Area (Bấm vào danh mục cha để mở/đóng danh mục con) -->
                                                <Button Grid.Column="0" 
                                                        Command="{Binding DataContext.ToggleCategoryExpandCommand, RelativeSource={RelativeSource AncestorType=local:ProductsView}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        ToolTip="Nhấn để đóng / mở danh mục con">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                                                <!-- Expand / Collapse Chevron indicator (visible if has subcategories) -->
                                                                <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0"
                                                                        Background="#F1F5F9"
                                                                        Visibility="{Binding HasSubCategories, Converter={StaticResource BoolToVis}}">
                                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="13" Foreground="#64748B"
                                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVis}}"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Leaf Spacer (when no subcategories) -->
                                                                <Border Width="26" Height="26" Margin="0,0,8,0" Visibility="{Binding HasSubCategories, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Ellipse Width="5" Height="5" Fill="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="catName" Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                                                <!-- Subcategory Count Chip -->
                                                                <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                                                        Visibility="{Binding HasSubCategories, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding SubCategoriesCount, StringFormat='{}{0} danh mục con'}" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="catName" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Display Order -->
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayOrder, StringFormat='Thứ tự: {0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                <!-- Visibility -->
                                                <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="Đang hiển thị" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                                                </Border>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding DataContext.OpenEditCategoryModalCommand, RelativeSource={RelativeSource AncestorType=local:ProductsView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Sửa danh mục">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="#2563EB"/>
                                                    </Button>

                                                    <Button Command="{Binding DataContext.RequestDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=local:ProductsView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" Background="#FEF2F2" BorderThickness="0" Cursor="Hand" ToolTip="Xóa danh mục">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#DC2626"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- SubCategories Dropdown Container -->
                                        <Border Visibility="{Binding IsExpandedAndHasSubCategories, Converter={StaticResource BoolToVis}}"
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="3,0,0,0"
                                                Margin="32,2,0,6"
                                                CornerRadius="0,8,8,0">
                                            <ItemsControl ItemsSource="{Binding SubCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,9">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- SubCategory Name & Branch Tag Icon -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                    <ui:SymbolIcon Symbol="Tag24" FontSize="14" Foreground="#64748B" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>

                                                                <!-- Display Order -->
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayOrder, StringFormat='Thứ tự: {0}'}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                                <!-- Visibility -->
                                                                <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="Đang hiển thị" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981"/>
                                                                </Border>

                                                                <!-- Actions -->
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Button Command="{Binding DataContext.OpenEditCategoryModalCommand, RelativeSource={RelativeSource AncestorType=local:ProductsView}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="28" Height="28" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Sửa danh mục con">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                        <ui:SymbolIcon Symbol="Edit24" FontSize="13" Foreground="#2563EB"/>
                                                                    </Button>

                                                                    <Button Command="{Binding DataContext.RequestDeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=local:ProductsView}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="28" Height="28" Background="#FEF2F2" BorderThickness="0" Cursor="Hand" ToolTip="Xóa danh mục con">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#DC2626"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

        <!-- ════════════════════ MODAL OVERLAYS (FULL VIEW POPUP) ════════════════════ -->
        <!-- ProductEditModal và ConfirmDialog hiện được hiển thị toàn màn hình (Full Window Overlay) qua ModalWindow / ConfirmDialogService -->

        <local:CategoryManageModal Visibility="{Binding IsCategoryModalOpen, Converter={StaticResource BoolToVis}}"/>

        <local:BarcodePrintModal Visibility="{Binding IsBarcodeModalOpen, Converter={StaticResource BoolToVis}}"/>

        <!-- MODAL: KẾT QUẢ IMPORT EXCEL -->
        <Grid Visibility="{Binding IsImportResultModalOpen, Converter={StaticResource BoolToVis}}">
            <!-- Backdrop -->
            <Border Background="#66000000"/>

            <!-- Dialog Card -->
            <Border Width="560" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource InputBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#EFF6FF" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kết quả nhập sản phẩm từ Excel" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding ImportSummaryText}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseImportResultModalCommand}"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Statistics Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Tổng số dòng" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LastImportResult.TotalRows}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Thành công" FontSize="11" Foreground="#047857" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LastImportResult.SuccessCount}" FontSize="18" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Thất bại/Lỗi" FontSize="11" Foreground="#B91C1C" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LastImportResult.FailureCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Errors List (if any) -->
                    <Border Grid.Row="2" Background="#FFF5F5" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16"
                            Visibility="{Binding HasImportErrors, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <StackPanel>
                                <TextBlock Text="Chi tiết các lỗi cần điều chỉnh trong file Excel:" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding LastImportResult.Errors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="• " Foreground="#DC2626" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Close button -->
                    <Button Grid.Row="3" Command="{Binding CloseImportResultModalCommand}"
                            Height="40" Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Padding="24,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Đã hiểu &amp; Đóng" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════ TOAST NOTIFICATION (TOP-MOST) ════════════════════ -->
        <shared:ToastNotification Panel.ZIndex="999" 
                                  VerticalAlignment="Top" 
                                  HorizontalAlignment="Center" 
                                  Message="{Binding ToastMessage}" 
                                  ToastType="{Binding ToastType}"/>
    </Grid>
</UserControl>
