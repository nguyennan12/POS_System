<Window x:Class="POS.WinUI.Views.Products.ProductEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:POS.WinUI.ViewModels.Products"
        xmlns:models="clr-namespace:POS.WinUI.Models"
        Title="{Binding WindowTitle}"
        Width="920" MinWidth="820"
        Height="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ══ TITLE BAR ═════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Điền đầy đủ thông tin sản phẩm và các biến thể SKU"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══ CONTENT ═══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <!-- Loading overlay -->
                <Border Background="#BFF8FAFC" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" CornerRadius="12" Padding="24,12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Đang tải..." VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Error banner -->
                <Border Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,12"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource InverseNullOrEmptyToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}"
                                   FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Success banner -->
                <Border Background="#F0FDF4"
                        BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10"
                        Padding="16,12" Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource InverseNullOrEmptyToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 1: Thông tin cơ bản ─────────────────────────── -->
                <Border Background="White" CornerRadius="14"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Thông tin cơ bản" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tên sản phẩm -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Tên sản phẩm *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldInputStyle}"/>
                            </StackPanel>

                            <!-- Danh mục -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Danh mục *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategory}"
                                          DisplayMemberPath="Name"
                                          Height="40" FontSize="14"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Thương hiệu -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Thương hiệu" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldInputStyle}"/>
                            </StackPanel>

                            <!-- Đơn vị cơ bản -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Đơn vị cơ bản *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="UnitCombo" Height="40" FontSize="14"
                                          IsEditable="True"
                                          Text="{Binding BaseUnit, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Cái"/>
                                    <ComboBoxItem Content="Hộp"/>
                                    <ComboBoxItem Content="Lốc"/>
                                    <ComboBoxItem Content="Chai"/>
                                    <ComboBoxItem Content="Gói"/>
                                    <ComboBoxItem Content="Kg"/>
                                    <ComboBoxItem Content="Lít"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Mô tả -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="Mô tả" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Height="72" FontSize="14" Padding="12,8"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource InputBackgroundBrush}"
                                         BorderBrush="{StaticResource InputBorderBrush}"
                                         BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Trạng thái (chỉ hiện khi edit) -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Height="40" FontSize="14"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Status}">
                                <ComboBoxItem Content="Đang bán" Tag="Active"/>
                                <ComboBoxItem Content="Ngừng bán" Tag="Inactive"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 2: Biến thể SKU ─────────────────────────────── -->
                <Border Background="White" CornerRadius="14"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Biến thể SKU" Style="{StaticResource SectionHeaderStyle}"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding AddSkuRowCommand}"
                                    Height="36" Padding="14,0" Cursor="Hand"
                                    Background="{StaticResource PrimaryLightBrush}"
                                    BorderBrush="{StaticResource PrimaryBorderBrush}"
                                    BorderThickness="1" Foreground="{StaticResource PrimaryBrush}"
                                    FontWeight="SemiBold" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0"/>
                                    <TextBlock Text="Thêm biến thể"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="SkuGrid"
                                  ItemsSource="{Binding Skus}"
                                  SelectedItem="{Binding SelectedSku}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource InputBorderBrush}"
                                  RowHeight="48" FontSize="13"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource InputBorderBrush}"
                                  Background="{StaticResource InputBackgroundBrush}"
                                  MaxHeight="320">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ SKU *" Binding="{Binding SkuCode, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100"/>
                                <DataGridTextColumn Header="MÃ VẠCH *" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" MinWidth="110"/>
                                <DataGridTextColumn Header="MÀU" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="SIZE" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="GIÁ VỐN" Binding="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="GIÁ BÁN *" Binding="{Binding SellPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="THUẾ %" Binding="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" Width="70"/>

                                <!-- Barcode preview + print -->
                                <DataGridTemplateColumn Header="THAO TÁC" Width="110" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SkuEditItem}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <!-- Print label -->
                                                <Button ToolTip="In tem mã vạch" Cursor="Hand"
                                                        Width="32" Height="32" Margin="2,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.PrintBarcodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Print24" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Button>
                                                <!-- Remove row -->
                                                <Button ToolTip="Xóa biến thể" Cursor="Hand"
                                                        Width="32" Height="32" Margin="2,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveSkuRowCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Delete24" Foreground="{StaticResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Barcode preview panel (shown when SKU selected) -->
                        <Border Margin="0,16,0,0"
                                Visibility="{Binding SelectedSku, Converter={StaticResource InverseNullOrEmptyToVis}}">
                            <StackPanel>
                                <TextBlock Text="Xem trước mã vạch" Style="{StaticResource FieldLabelStyle}"/>
                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="16,12" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <Image x:Name="BarcodePreviewImage"
                                               Width="280" Height="70"
                                               Stretch="Uniform" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding SelectedSku.Barcode}"
                                                   HorizontalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Số bản in:" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding PrintCopies, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="50" Height="32" FontSize="13"
                                                     VerticalContentAlignment="Center" TextAlignment="Center"/>
                                            <Button Margin="10,0,0,0" Height="32" Padding="12,0"
                                                    Command="{Binding PrintBarcodeCommand}"
                                                    CommandParameter="{Binding SelectedSku}"
                                                    Style="{StaticResource PrimaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Print24" Margin="0,0,6,0"/>
                                                    <TextBlock Text="In tem"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ FOOTER ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Command="{Binding CancelCommand}"
                        Height="42" Width="120"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" FontSize="14" Cursor="Hand"
                        Foreground="{StaticResource TextSecondaryBrush}">
                    Hủy bỏ
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,12,0"
                                     Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="160" Height="42"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0"/>
                            <TextBlock Text="Lưu sản phẩm"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
