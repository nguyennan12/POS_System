<UserControl x:Class="POS.WinUI.Views.Products.BarcodePrintModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">

    <!-- BACKDROP -->
    <Grid Background="#75000000">
        <!-- MODAL CARD -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="660" 
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#0F172A" Opacity="0.25" ShadowDepth="10" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1">
                        <ui:SymbolIcon Symbol="Print24" FontSize="22" Foreground="{StaticResource PrimaryBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="In tem nhãn mã vạch (Barcode Label)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Xem trước tem nhãn chuẩn nhiệt và in trực tiếp ra máy in tem nhãn POS" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="36" Height="36" 
                            Command="{Binding CloseBarcodeModalCommand}"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- BODY: THIẾT LẬP VÀ XEM TRƯỚC TEM -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: THÔNG TIN SKU & TÙY CHỌN IN -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN SẢN PHẨM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <StackPanel>
                                <TextBlock Text="Tên sản phẩm:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BarcodeProductName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Mã SKU:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BarcodeSkuCode}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Biến thể:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BarcodeVariantText}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Giá niêm yết:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding BarcodeSellPriceFormatted}" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>

                            <Border Background="#E2E8F0" Height="1" Margin="0,4"/>

                            <!-- Số lượng tem cần in -->
                            <StackPanel>
                                <TextBlock Text="Số lượng tem in:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <TextBox Text="{Binding BarcodePrintQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource CleanTextBoxStyle}" FontSize="13" TextAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="con tem" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Khổ tem: 50 x 30 mm (Chuẩn máy in Xprinter, Bixolon, Godex)" 
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- CỘT PHẢI: XEM TRƯỚC TEM NHÃN IN (LABEL VISUAL) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="XEM TRƯỚC TEM NHÃN (50x30mm):" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                        <!-- KHUNG TEM NHÃN VẬT LÝ ĐỂ IN -->
                        <Border x:Name="BarcodeLabelVisual" 
                                Width="300" Height="185" 
                                Background="#FFFFFF" 
                                BorderBrush="#94A3B8" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.12" ShadowDepth="4"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Tên cửa hàng -->
                                <TextBlock Grid.Row="0" Text="{Binding BarcodeStoreName}" 
                                           FontSize="10" FontWeight="Bold" TextAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis"/>

                                <!-- Tên sản phẩm & biến thể -->
                                <TextBlock Grid.Row="1" FontSize="12" FontWeight="Bold" TextAlignment="Center" Foreground="#0F172A" Margin="0,3,0,4" TextWrapping="Wrap" MaxHeight="34">
                                    <Run Text="{Binding BarcodeProductName, Mode=OneWay}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding BarcodeVariantText, Mode=OneWay}" Foreground="#2563EB"/>
                                </TextBlock>

                                <!-- Hình ảnh Barcode Code128 -->
                                <Image Grid.Row="2" Source="{Binding BarcodeImage}" 
                                       Stretch="Fill" HorizontalAlignment="Stretch" Margin="10,2,10,2"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <!-- Mã số Barcode & SKU bên dưới -->
                                <TextBlock Grid.Row="3" FontSize="11" FontFamily="Consolas, Courier New" FontWeight="SemiBold" TextAlignment="Center" Foreground="#334155">
                                    <Run Text="{Binding BarcodeNumber, Mode=OneWay}"/>
                                    <Run Text=" (" Foreground="#64748B"/>
                                    <Run Text="{Binding BarcodeSkuCode, Mode=OneWay}" Foreground="#64748B"/>
                                    <Run Text=")" Foreground="#64748B"/>
                                </TextBlock>

                                <!-- Giá tiền in to rõ -->
                                <TextBlock Grid.Row="4" Text="{Binding BarcodeSellPriceFormatted}" 
                                           FontSize="15" FontWeight="ExtraBold" TextAlignment="Center" Foreground="#000000" Margin="0,2,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- FOOTER -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" 
                            Content="Đóng" 
                            Command="{Binding CloseBarcodeModalCommand}"
                            Width="110" Height="40"
                            Style="{StaticResource OutlineButtonStyle}"/>

                    <Button Grid.Column="3" 
                            Command="{Binding PrintBarcodeLabelsCommand}"
                            CommandParameter="{Binding ElementName=BarcodeLabelVisual}"
                            Width="170" Height="40"
                            Background="{StaticResource PrimaryBrush}" Foreground="White"
                            FontWeight="Bold" FontSize="13.5" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Print24" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="In tem nhãn" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
