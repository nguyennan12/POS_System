<UserControl x:Class="POS.WinUI.Views.Products.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.Products"
             xmlns:models="clr-namespace:POS.WinUI.Models"
             Background="#F8FAFC"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Status badge style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Filter bar -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
            <RowDefinition Height="Auto"/>   <!-- Pagination -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Quản lý sản phẩm"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,2,0,0">
                        <Run Text="{Binding TotalCount, StringFormat={}{0} sản phẩm}"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding OpenCreateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="170" Height="42">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm sản phẩm"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ FILTER BAR ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" Padding="20,10"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">

                <!-- Search box -->
                <Border CornerRadius="10"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" Width="300" Height="40" Margin="0,0,12,0">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Search24" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="14"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextChanged="OnSearchTextChanged"/>
                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1"
                                   Text="Tìm theo tên, thương hiệu..."
                                   Foreground="{StaticResource TextPlaceholderBrush}"
                                   VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource NullOrEmptyToVis}}"/>
                    </Grid>
                </Border>

                <!-- Category filter -->
                <ComboBox x:Name="CategoryCombo"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"
                          Width="200" Height="40" Margin="0,0,12,0"
                          FontSize="14" VerticalContentAlignment="Center"/>

                <!-- Status filter -->
                <ComboBox Height="40" Width="160" FontSize="14"
                          SelectedIndex="0"
                          SelectionChanged="OnStatusSelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái" Tag=""/>
                    <ComboBoxItem Content="Đang bán" Tag="Active"/>
                    <ComboBoxItem Content="Ngừng bán" Tag="Inactive"/>
                </ComboBox>

                <!-- Loading spinner -->
                <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                                 Margin="16,0,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </Border>

        <!-- ══ ERROR BANNER ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" VerticalAlignment="Top"
                Background="{StaticResource DangerBgBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding ErrorMessage, Converter={StaticResource InverseNullOrEmptyToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="13"/>
        </Border>

        <!-- ══ PRODUCT DATAGRID ═══════════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  x:Name="ProductGrid"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource InputBorderBrush}"
                  RowHeight="52"
                  FontSize="14"
                  BorderThickness="0"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFBFC"
                  ColumnHeaderHeight="44"
                  MouseDoubleClick="OnRowDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="SeparatorBrush" Value="Transparent"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <!-- Name + Category -->
                <DataGridTemplateColumn Header="SẢN PHẨM" Width="2.5*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:ProductListItem}">
                            <StackPanel Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CategoryName}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="THƯƠNG HIỆU" Binding="{Binding Brand}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Margin" Value="16,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="ĐVT" Binding="{Binding BaseUnit}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="Margin" Value="16,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- SKU count badge -->
                <DataGridTemplateColumn Header="BIẾN THỂ" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:ProductListItem}">
                            <Border Background="{StaticResource InputBackgroundBrush}"
                                    CornerRadius="6" Margin="16,0" Padding="8,4"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SkuCount}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Status badge -->
                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:ProductListItem}">
                            <Border Margin="16,0" VerticalAlignment="Center"
                                    CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                <Setter Property="Background" Value="{StaticResource InputBorderBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusBadge}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:ProductListItem}">
                            <Button Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Chỉnh sửa"
                                    Command="{Binding DataContext.OpenEditCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <ui:SymbolIcon Symbol="Edit24" Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ PAGINATION ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                    <Run Text="{Binding TotalCount, StringFormat={}{0} sản phẩm}"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PrevPageCommand}"
                            Width="36" Height="36" Margin="4,0"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1" Cursor="Hand">
                        <ui:SymbolIcon Symbol="ChevronLeft24"/>
                    </Button>

                    <Border Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,0" Height="36"
                            VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding CurrentPage}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding TotalPages}"/>
                        </TextBlock>
                    </Border>

                    <Button Command="{Binding NextPageCommand}"
                            Width="36" Height="36" Margin="4,0"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1" Cursor="Hand">
                        <ui:SymbolIcon Symbol="ChevronRight24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
