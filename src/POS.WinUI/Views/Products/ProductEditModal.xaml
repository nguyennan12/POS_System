<UserControl x:Class="POS.WinUI.Views.Products.ProductEditModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1160">

    <!-- ════════════════════ MODAL BACKDROP ════════════════════ -->
    <Grid Background="#75000000">
        <!-- ════════════════════ MODAL CARD CONTAINER ════════════════════ -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="1160" 
                MaxHeight="860"
                Margin="20,12"
                Background="#FFFFFF"
                CornerRadius="16"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                Padding="24,20,24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#0F172A" Opacity="0.25" ShadowDepth="8" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Modal Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Scrollable Body Content -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Footer Action Buttons -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════ ROW 0: HEADER ════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1">
                        <ui:SymbolIcon Symbol="Box24" FontSize="22" Foreground="{StaticResource PrimaryBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Thiết lập thông tin sản phẩm, đơn vị tính và sinh các biến thể SKU theo quy cách bán &amp; hương vị" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="36" Height="36" 
                            Command="{Binding CloseProductEditModalCommand}"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                            ToolTip="Đóng cửa sổ">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ════════════════════ ROW 1: SCROLLABLE BODY ════════════════════ -->
                <ScrollViewer x:Name="ModalScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-4,0" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- ══ BỐ CỤC 2 CỘT: TRÁI (THÔNG TIN SẢN PHẨM) | PHẢI (CÔNG CỤ SINH SKU) ══ -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <!-- Cột 1: Thông tin sản phẩm (Bên trái) -->
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="14"/>
                                <!-- Cột 2: Hộp công cụ sinh biến thể SKU (Bên phải) -->
                                <ColumnDefinition Width="1.25*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ── 1. THÔNG TIN CƠ BẢN SẢN PHẨM (BÊN TRÁI) ── -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="1. THÔNG TIN SẢN PHẨM" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                                    <!-- Tên sản phẩm -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Tên sản phẩm *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                            <TextBox x:Name="ProductNameTextBox"
                                                     Text="{Binding EditProductName, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource CleanTextBoxStyle}" FontSize="13"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Danh mục & Đơn vị tính -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Danh mục -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Danh mục hàng hóa *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding CategoryFilterOptions}" 
                                                      SelectedItem="{Binding EditSelectedCategory}"
                                                      DisplayMemberPath="DisplayName"
                                                      Height="36" FontSize="12.5"/>
                                        </StackPanel>

                                        <!-- Đơn vị cơ bản -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Đơn vị tính *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding BaseUnitOptions}" 
                                                      SelectedItem="{Binding EditBaseUnit}"
                                                      Height="36" FontSize="12.5"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Thương hiệu, Trạng thái & Ảnh -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thương hiệu -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thương hiệu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                                <TextBox Text="{Binding EditBrand, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Trạng thái -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Trạng thái" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox SelectedValue="{Binding EditStatus}" SelectedValuePath="Tag" Height="36" FontSize="12.5">
                                                <ComboBoxItem Content="Đang bán" Tag="Active" IsSelected="True"/>
                                                <ComboBoxItem Content="Ngưng bán" Tag="Inactive"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Link Ảnh -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Ảnh (URL)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                                <TextBox Text="{Binding EditImageUrl, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mô tả tóm tắt -->
                                    <StackPanel>
                                        <TextBlock Text="Mô tả tóm tắt" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource CleanMultilineTextBoxStyle}" 
                                                 Height="46" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── 2. CÔNG CỤ SINH BIẾN THỂ SKU (BÊN PHẢI) ── -->
                            <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <!-- Header + Chips gợi ý -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="2. CÔNG CỤ SINH BIẾN THỂ SKU" FontSize="12.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Quick Preset Chips -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Mẫu:" FontSize="11" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Button Command="{Binding ApplyDrinkPresetCommand}" Content="🥤 Nước" Height="24" Padding="6,0" Margin="0,0,3,0" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding ApplyNoodlePresetCommand}" Content="🍜 Mì" Height="24" Padding="6,0" Margin="0,0,3,0" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding ApplyBeerPresetCommand}" Content="🍺 Bia" Height="24" Padding="6,0" Margin="0,0,3,0" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                            <Button Command="{Binding ApplyConsumerPresetCommand}" Content="🧻 Tiêu dùng" Height="24" Padding="6,0" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Nhập Quy cách & Hương vị -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Quy cách / Đóng gói (cách bằng dấu phẩy) *" FontSize="11.5" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <TextBox Text="{Binding VariantColorInput, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Hương vị / Phân loại (cách bằng dấu phẩy)" FontSize="11.5" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <TextBox Text="{Binding VariantSizeInput, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hàng: Giá vốn, Giá bán, VAT và Nút Sinh SKU -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Giá vốn mặc định -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Giá vốn (đ)" FontSize="11.5" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                                <TextBox Text="{Binding VariantDefaultCost, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Giá bán mặc định -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Giá bán (đ)" FontSize="11.5" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="8,5">
                                                <TextBox Text="{Binding VariantDefaultSell, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Thuế VAT -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="VAT (%)" FontSize="11.5" FontWeight="SemiBold" Foreground="#78350F" Margin="0,0,0,4"/>
                                            <Border Background="#FFFFFF" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="6,5">
                                                <TextBox Text="{Binding VariantDefaultTax, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12.5" TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Nút Tự động sinh danh sách SKU -->
                                        <Button Grid.Column="6" 
                                                Content="⚡ Tự động sinh danh sách SKU" 
                                                Command="{Binding GenerateVariantsCommand}"
                                                Height="34" Padding="12,0"
                                                VerticalAlignment="Bottom"
                                                Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="12"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ── 3. DANH SÁCH BIẾN THỂ SKU (BÊN DƯỚI) ── -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="3. DANH SÁCH BIẾN THỂ SKU" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <Border Background="#EFF6FF" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding EditingSkus.Count, StringFormat={}{0} biến thể}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                                            Command="{Binding AddEmptySkuCommand}"
                                            Height="30" Padding="12,0" 
                                            Style="{StaticResource SmallOutlineButtonStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thêm dòng SKU thủ công" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Bảng danh sách các dòng SKU có ScrollViewer cuộn nội bộ -->
                                <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
                                    <StackPanel MinWidth="850">
                                        <!-- Header bảng biến thể -->
                                        <Border Background="#F1F5F9" CornerRadius="8" Padding="8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="145"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Mã SKU *" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Mã vạch (Barcode) *" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="" FontSize="11.5"/>
                                                <TextBlock Grid.Column="3" Text="Quy cách / Dung tích" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="4" Text="Hương vị / Loại" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="5" Text="Giá vốn (đ)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="Giá bán (đ) *" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="VAT %" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="" FontSize="11.5"/>
                                            </Grid>
                                        </Border>

                                        <!-- Danh sách dòng SKU -->
                                        <ItemsControl ItemsSource="{Binding EditingSkus}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="8,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="135"/>
                                                                <ColumnDefinition Width="145"/>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="105"/>
                                                                <ColumnDefinition Width="105"/>
                                                                <ColumnDefinition Width="65"/>
                                                                <ColumnDefinition Width="40"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Mã SKU -->
                                                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,0">
                                                                <TextBox Text="{Binding SkuCode, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <!-- Mã vạch (Barcode) -->
                                                            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,4,0">
                                                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12"/>
                                                            </Border>

                                                            <!-- Nút sinh barcode ngẫu nhiên -->
                                                            <Button Grid.Column="2" 
                                                                    Command="{Binding DataContext.RegenerateSkuBarcodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="26" Height="26" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" ToolTip="Sinh mã vạch ngẫu nhiên chuẩn EAN-13" Margin="0,0,6,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                            <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Quy cách / Màu -->
                                                            <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,0">
                                                                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12"/>
                                                            </Border>

                                                            <!-- Hương vị / Size -->
                                                            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,0">
                                                                <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12"/>
                                                            </Border>

                                                            <!-- Giá vốn -->
                                                            <Border Grid.Column="5" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,0">
                                                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12" TextAlignment="Right"/>
                                                            </Border>

                                                            <!-- Giá bán -->
                                                            <Border Grid.Column="6" Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,0">
                                                                <TextBox Text="{Binding SellPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextAlignment="Right"/>
                                                            </Border>

                                                            <!-- Thuế VAT -->
                                                            <Border Grid.Column="7" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,4" Margin="0,0,6,0">
                                                                <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="12" TextAlignment="Center"/>
                                                            </Border>

                                                            <!-- Nút xóa dòng SKU -->
                                                            <Button Grid.Column="8" 
                                                                    Command="{Binding DataContext.RemoveSkuCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Xóa biến thể SKU này"
                                                                    HorizontalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#EF4444"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════════════ ROW 2: FOOTER BUTTONS ════════════════════ -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" 
                            Content="Hủy bỏ" 
                            Command="{Binding CloseProductEditModalCommand}"
                            Width="120" Height="40"
                            Style="{StaticResource OutlineButtonStyle}"/>

                    <Button Grid.Column="3" 
                            Content="Lưu sản phẩm &amp; SKU" 
                            Command="{Binding SaveProductCommand}"
                            Width="190" Height="40"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
