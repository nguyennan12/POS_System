<UserControl x:Class="POS.WinUI.Views.Products.CategoryManageModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700">

    <!-- BACKDROP -->
    <Grid Background="#75000000">
        <!-- MODAL CARD -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="540" 
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#0F172A" Opacity="0.25" ShadowDepth="10" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="22" Foreground="{StaticResource PrimaryBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Phân nhóm hàng hóa giúp lọc và tìm kiếm nhanh khi bán hàng POS" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="36" Height="36" 
                            Command="{Binding CloseCategoryModalCommand}"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- BODY -->
                <StackPanel Grid.Row="1">
                    <!-- Tên danh mục -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Tên danh mục *" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <TextBox Text="{Binding CategoryEditName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource CleanTextBoxStyle}" FontSize="14"/>
                        </Border>
                    </StackPanel>

                    <!-- Danh mục cha (nếu có) -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Danh mục cha (Tùy chọn - để tạo danh mục con)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding CategoryFilterOptions}" 
                                  SelectedItem="{Binding CategoryEditSelectedParent}"
                                  DisplayMemberPath="DisplayName"
                                  Height="40" FontSize="13"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thứ tự hiển thị -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thứ tự hiển thị" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <TextBox Text="{Binding CategoryEditDisplayOrder, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource CleanTextBoxStyle}" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <!-- Hiển thị / Ẩn -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,22,0,0">
                            <CheckBox IsChecked="{Binding CategoryEditIsVisible}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock Text="Hiển thị trên POS quầy" VerticalAlignment="Center"/>
                            </CheckBox>
                        </StackPanel>
                    </Grid>

                    <!-- Lỗi nếu có -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14,10"
                            Visibility="{Binding CategoryEditErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryEditErrorMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#B91C1C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FOOTER -->
                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" 
                            Content="Hủy bỏ" 
                            Command="{Binding CloseCategoryModalCommand}"
                            Width="110" Height="40"
                            Style="{StaticResource OutlineButtonStyle}"/>

                    <Button Grid.Column="3" 
                            Content="Lưu danh mục" 
                            Command="{Binding SaveCategoryCommand}"
                            Width="150" Height="40"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
