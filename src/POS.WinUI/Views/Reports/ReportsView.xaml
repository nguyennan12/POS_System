<UserControl x:Class="POS.WinUI.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,16,28,24">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header & Tabs -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Filter Bar & Export Actions -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: KPI Metrics Summary Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Data Table Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════════════════ ROW 0: TOP HEADER & TABS ════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="DataPie24" FontSize="22" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab Switcher -->
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Báo cáo Doanh thu" 
                                     GroupName="ReportViewTabs"
                                     IsChecked="{Binding IsRevenueTab, Mode=TwoWay}"
                                     Padding="16,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="tabBorder" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.08" ShadowDepth="1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton Content="Báo cáo Tồn kho" 
                                     GroupName="ReportViewTabs"
                                     IsChecked="{Binding IsInventoryTab, Mode=TwoWay}"
                                     Padding="16,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="4,0,0,0">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="tabBorder" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.08" ShadowDepth="1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ════════════════════ ROW 1: FILTER BAR & EXCEL EXPORT ════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" 
                    CornerRadius="14" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Date Filters & Presets -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Date range picker (Revenue Tab only) -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRevenueTab, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0">
                            <TextBlock Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="12.5"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="34" Margin="0,0,12,0"/>

                            <TextBlock Text="Đến:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="12.5"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="34" Margin="0,0,12,0"/>

                            <!-- Presets -->
                            <Button Content="Hôm nay" Command="{Binding SetPresetPeriodCommand}" CommandParameter="today" Height="32" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource OutlineButtonStyle}" FontSize="12"/>
                            <Button Content="7 ngày" Command="{Binding SetPresetPeriodCommand}" CommandParameter="7days" Height="32" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource OutlineButtonStyle}" FontSize="12"/>
                            <Button Content="Tháng này" Command="{Binding SetPresetPeriodCommand}" CommandParameter="thisMonth" Height="32" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource OutlineButtonStyle}" FontSize="12"/>
                            <Button Content="30 ngày" Command="{Binding SetPresetPeriodCommand}" CommandParameter="30days" Height="32" Padding="8,0" Style="{StaticResource OutlineButtonStyle}" FontSize="12"/>
                        </StackPanel>

                        <!-- Store Selector for Owner -->
                        <ComboBox ItemsSource="{Binding Stores}"
                                  SelectedItem="{Binding SelectedStore, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText"
                                  Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"
                                  Height="34" Width="170" Margin="10,0,0,0"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Apply & Export Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding LoadCurrentReportCommand}" 
                                Height="36" Padding="14,0" Margin="0,0,10,0"
                                Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="Áp dụng bộ lọc">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Filter24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xem báo cáo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Export Excel Button -->
                        <Button Command="{Binding ExportExcelCommand}" 
                                Height="36" Padding="16,0" 
                                Cursor="Hand" BorderThickness="0" Background="#059669"
                                ToolTip="Xuất dữ liệu báo cáo ra file Excel (.xlsx)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Color="#059669" Opacity="0.25" ShadowDepth="2" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xuất Excel" FontWeight="Bold" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════ ROW 2: KPI SUMMARY METRICS ════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <!-- REVENUE TAB KPI CARDS -->
                <Grid Visibility="{Binding IsRevenueTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Tổng doanh thu" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalRevenueFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Tổng chiết khấu" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalDiscountFormatted}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Thuế GTGT (VAT)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalTaxFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Doanh thu thực thu" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding NetRevenueFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- INVENTORY TAB KPI CARDS -->
                <Grid Visibility="{Binding IsInventoryTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Tổng mặt hàng (SKU)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalSkus}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Tổng giá trị tồn kho" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalStockValueFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Hết hàng (Hết tồn)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding OutOfStockCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Sắp hết hàng" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ════════════════════ ROW 3: DATA GRID CONTENT ════════════════════ -->
            <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" 
                    CornerRadius="16" Padding="20">
                <Grid>
                    <!-- REVENUE DATA TABLE -->
                    <DataGrid ItemsSource="{Binding Periods}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42"
                              Visibility="{Binding IsRevenueTab, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian / Ngày" Binding="{Binding Period}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Tổng doanh thu" Binding="{Binding Revenue, StringFormat='{}{0:N0} đ'}" Width="160"/>
                            <DataGridTextColumn Header="Chiết khấu" Binding="{Binding Discount, StringFormat='{}{0:N0} đ'}" Width="140"/>
                            <DataGridTextColumn Header="Thuế VAT" Binding="{Binding Tax, StringFormat='{}{0:N0} đ'}" Width="140"/>
                            <DataGridTextColumn Header="Doanh thu thực" Binding="{Binding NetRevenue, StringFormat='{}{0:N0} đ'}" Width="170" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Số đơn hoàn tất" Binding="{Binding OrderCount}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- INVENTORY DATA TABLE -->
                    <DataGrid ItemsSource="{Binding InventoryItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42"
                              Visibility="{Binding IsInventoryTab, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SKU" Binding="{Binding SkuCode}" Width="140" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="260"/>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="180"/>
                            <DataGridTextColumn Header="Số lượng tồn" Binding="{Binding QtyOnHand, StringFormat='{}{0:N0}'}" Width="130"/>
                            <DataGridTextColumn Header="Giá vốn" Binding="{Binding CostPrice, StringFormat='{}{0:N0} đ'}" Width="140"/>
                            <DataGridTextColumn Header="Giá trị tồn kho" Binding="{Binding StockValue, StringFormat='{}{0:N0} đ'}" Width="*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
