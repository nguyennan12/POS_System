<UserControl x:Class="POS.WinUI.Views.Inventory.StockInModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <!-- ════════════════════ MODAL BACKDROP ════════════════════ -->
    <Grid Background="#75000000">
        <!-- ════════════════════ MODAL CARD CONTAINER (rounded-28) ════════════════════ -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="1020" 
                MaxHeight="780"
                Background="#FFFFFF"
                CornerRadius="28"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#0F172A" Opacity="0.25" ShadowDepth="12" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Header (TẠO PHIẾU NHẬP KHO + Close X) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Form Inputs (Supplier & Note) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Barcode Scanner Input -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Items Table -->
                    <RowDefinition Height="*"/>
                    <!-- Row 4: Total Summary Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 5: Footer Actions -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════ ROW 0: HEADER ════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" Foreground="#EB7F0E" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TẠO PHIẾU NHẬP KHO" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Quét mã vạch nhập hàng nhanh, quản lý số lô và hạn dùng cho từng mặt hàng" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="40" Height="40" 
                            Command="{Binding CloseStockInModalCommand}"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ════════════════════ ROW 1: SUPPLIER & NOTE INPUTS (Height 50px) ════════════════════ -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <!-- Nhà cung cấp (Bắt buộc) -->
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Ghi chú phiếu nhập -->
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chọn NCC -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Nhà cung cấp" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text=" *" FontSize="12.5" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Height="50" Padding="4">
                            <ComboBox ItemsSource="{Binding Suppliers}" 
                                      SelectedItem="{Binding SelectedSupplier}" 
                                      DisplayMemberPath="DisplayText"
                                      IsEnabled="{Binding CanEditStockIn}"
                                      BorderThickness="0" Background="Transparent"
                                      FontSize="13.5" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Ghi chú -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ghi chú phiếu nhập" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding StockInNote, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding CanEditStockIn}"
                                 Height="50" FontSize="13.5" Padding="14,0" VerticalContentAlignment="Center"
                                 Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- ════════════════════ ROW 2: BARCODE SCANNER INPUT (Height 50px) ════════════════════ -->
                <Border Grid.Row="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="BarcodeScanner24" FontSize="22" Foreground="#EB7F0E" Margin="4,0,12,0" VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1" 
                                 Text="{Binding StockInBarcodeQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding CanEditStockIn}"
                                 Height="46" FontSize="13.5" Padding="12,0" VerticalContentAlignment="Center"
                                 Background="#FFFFFF" BorderBrush="#FED7AA" BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ScanAndAddStockInLineCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2" 
                                Command="{Binding ScanAndAddStockInLineCommand}"
                                IsEnabled="{Binding CanEditStockIn}"
                                Background="#EB7F0E" Foreground="#FFFFFF"
                                Height="46" Padding="20,0" Margin="10,0,0,0" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                            <TextBlock Text="Thêm hàng (Enter)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ════════════════════ ROW 3: ITEMS TABLE ════════════════════ -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Margin="0,0,0,14" MinHeight="180">
                    <Grid>
                        <!-- Trạng thái trống -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                    Visibility="{Binding StockInLines.Count, Converter={StaticResource InverseNullOrEmptyToVis}}">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Cart24" FontSize="26" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chưa có mặt hàng nào trong phiếu nhập" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Quét mã vạch hoặc nhập mã SKU vào ô phía trên rồi nhấn Enter" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Bảng hàng hóa nhập -->
                        <DataGrid ItemsSource="{Binding StockInLines}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="48">
                            <DataGrid.Columns>
                                <!-- Cột 1: Sản phẩm -->
                                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>

                                <!-- Cột 2: SKU -->
                                <DataGridTextColumn Header="SKU" Binding="{Binding SkuCode}" Width="120" IsReadOnly="True" Foreground="#64748B"/>

                                <!-- Cột 3: Số lượng với +/- Steppers -->
                                <DataGridTemplateColumn Header="Số lượng" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Width="108" HorizontalAlignment="Left">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Command="{Binding DecreaseQtyCommand}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <TextBlock Text="−" FontSize="16" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat='{}{0:0.##}'}" 
                                                               FontSize="13" FontWeight="Bold" Foreground="#0F172A" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <Button Grid.Column="2" Command="{Binding IncreaseQtyCommand}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 4: Đơn giá nhập -->
                                <DataGridTextColumn Header="Đơn giá nhập" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0} đ'}" Width="130"/>

                                <!-- Cột 5: Thành tiền -->
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPriceFormatted}" Width="130" IsReadOnly="True" FontWeight="Bold" Foreground="#EB7F0E"/>

                                <!-- Cột 6: Số lô (Optional) -->
                                <DataGridTextColumn Header="Số lô" Binding="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" Width="110"/>

                                <!-- Cột 7: Hạn dùng (Optional) -->
                                <DataGridTemplateColumn Header="Hạn dùng" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="32" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cột 8: Nút xóa dòng -->
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveStockInLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="#DC2626"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ════════════════════ ROW 4: TOTAL AMOUNT SUMMARY BAR ════════════════════ -->
                <Border Grid.Row="4" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="14" Padding="20,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Receipt24" FontSize="18" Foreground="#EB7F0E" Margin="0,0,8,0"/>
                            <TextBlock Text="Tổng giá trị hàng nhập:" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding TotalStockInAmountFormatted}" 
                                   FontSize="22" FontWeight="Bold" Foreground="#EB7F0E" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ════════════════════ ROW 5: FOOTER ACTIONS (Button height: 48px, rounded 12px) ════════════════════ -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hủy bỏ -->
                    <Button Grid.Column="0" 
                            Command="{Binding CloseStockInModalCommand}"
                            Background="#F1F5F9" Foreground="#334155"
                            Height="48" Padding="24,0" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Hủy bỏ" FontSize="13.5" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Nút Lưu Bản Nháp & TẠO PHIẾU NHẬP KHO -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding SaveDraftStockInVoucherCommand}"
                                IsEnabled="{Binding CanEditStockIn}"
                                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#334155"
                                Height="48" Padding="20,0" Margin="0,0,12,0" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Save24" FontSize="16" Foreground="#64748B" Margin="0,0,8,0"/>
                                            <TextBlock Text="Lưu bản nháp" FontSize="13.5" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding CompleteStockInVoucherCommand}"
                                Background="#EB7F0E" Foreground="#FFFFFF"
                                Height="48" Padding="24,0" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <TextBlock Text="TẠO PHIẾU NHẬP KHO" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
