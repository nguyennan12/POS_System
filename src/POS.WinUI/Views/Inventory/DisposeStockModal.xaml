<UserControl x:Class="POS.WinUI.Views.Inventory.DisposeStockModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="650">

    <!-- ════════════════════ MODAL BACKDROP ════════════════════ -->
    <Grid Background="#75000000">
        <!-- ════════════════════ MODAL CARD CONTAINER ════════════════════ -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="560" 
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Color="#0F172A" Opacity="0.28" ShadowDepth="12" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Modal Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Form Inputs -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Actions -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════ ROW 0: HEADER ════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                        <ui:SymbolIcon Symbol="DeleteDismiss24" FontSize="22" Foreground="{StaticResource DangerBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Xuất Hủy Hàng Hóa Khỏi Kho" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Ghi giảm tồn kho cho hàng hóa bị hỏng hóc hoặc hết hạn sử dụng" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="36" Height="36" 
                            Command="{Binding CloseDisposeModalCommand}"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ════════════════════ ROW 1: FORM INPUTS ════════════════════ -->
                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                    <!-- Tên hàng hóa & Tồn hiện tại -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisposeProductName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding DisposeBarcode, StringFormat='Mã vạch: {0}'}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="Tồn hiện tại" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DisposeCurrentStock, StringFormat='{}{0:0.##}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Số lượng xuất hủy -->
                    <TextBlock Text="Số lượng xuất hủy (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DisposeQty, UpdateSourceTrigger=PropertyChanged}" 
                             Height="42" FontSize="14" FontWeight="Bold" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Lý do xuất hủy -->
                    <TextBlock Text="Lý do xuất hủy (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DisposeNote, UpdateSourceTrigger=PropertyChanged}" 
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="12,8" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- ════════════════════ ROW 2: ACTIONS ════════════════════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding CloseDisposeModalCommand}"
                            Background="#F1F5F9" Foreground="{StaticResource TextSecondaryBrush}"
                            Height="44" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,12,0">
                        <TextBlock Text="Hủy bỏ"/>
                    </Button>

                    <Button Grid.Column="1" Command="{Binding ConfirmDisposeStockCommand}"
                            Background="{StaticResource DangerBrush}" Foreground="#FFFFFF"
                            Height="44" Padding="28,0" FontWeight="Bold" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DeleteDismiss24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Xác nhận xuất hủy"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
