<UserControl x:Class="POS.WinUI.Views.Inventory.StockTakeModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1050">

    <!-- ════════════════════ MODAL BACKDROP ════════════════════ -->
    <Grid Background="#75000000">
        <!-- ════════════════════ MODAL CARD CONTAINER ════════════════════ -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="980" 
                MaxHeight="800"
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Color="#0F172A" Opacity="0.28" ShadowDepth="12" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Modal Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Barcode Fast Scan Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Items Table -->
                    <RowDefinition Height="*"/>
                    <!-- Row 3: Footer Summary & Action Buttons -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════ ROW 0: HEADER ════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                        <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="22" Foreground="#2563EB" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Phiếu Kiểm Kê Kho Thực Tế" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentStockTakeStatus}" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StockTakeNote}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Width="36" Height="36" 
                            Command="{Binding CloseStockTakeModalCommand}"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ════════════════════ ROW 1: BARCODE FAST SCANNER ════════════════════ -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quét mã vạch đếm nhanh:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBox Grid.Column="1" 
                                 Text="{Binding StockTakeBarcodeQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding CanEditStockTake}"
                                 Height="40" FontSize="13.5" Padding="12,0" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource InputBorderBrush}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ScanBarcodeInStockTakeCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2" 
                                Command="{Binding ScanBarcodeInStockTakeCommand}"
                                IsEnabled="{Binding CanEditStockTake}"
                                Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF"
                                Height="40" Padding="18,0" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                            <TextBlock Text="Đếm (+1)"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ════════════════════ ROW 2: ITEMS TABLE ════════════════════ -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Margin="0,0,0,16">
                    <Grid>
                        <DataGrid ItemsSource="{Binding StockTakeLines}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã SKU" Binding="{Binding SkuCode}" Width="120" IsReadOnly="True" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Tên hàng hóa" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tồn hệ thống" Binding="{Binding SystemQty}" Width="110" IsReadOnly="True" FontWeight="Bold"/>
                                
                                <!-- Thực tế đếm (editable TextBox) -->
                                <DataGridTemplateColumn Header="Thực tế đếm (*)" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ActualQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     IsEnabled="{Binding DataContext.CanEditStockTake, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     Height="32" Width="90" FontWeight="Bold" HorizontalAlignment="Left"
                                                     VerticalContentAlignment="Center" Padding="8,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Chênh lệch với badge màu sắc trực quan -->
                                <DataGridTemplateColumn Header="Chênh lệch" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding DiffBadgeBg}" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding DiffStatus}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding DiffBadgeFg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ghi chú -->
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ════════════════════ ROW 3: FOOTER SUMMARY & ACTIONS ════════════════════ -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <!-- Thống kê tổng số -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Spacer -->
                        <ColumnDefinition Width="*"/>
                        <!-- Nút bấm hành động -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tổng tồn HT -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,6" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Tổng tồn hệ thống" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TotalSystemQty, StringFormat='{}{0:0.##}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tổng thực tế -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,6" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Tổng đếm thực tế" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TotalActualQty, StringFormat='{}{0:0.##}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tổng lệch -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="14,6">
                            <StackPanel>
                                <TextBlock Text="Tổng chênh lệch" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TotalDiffQty, StringFormat='{}{0:0.##}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Lưu kiểm đếm -->
                        <Button Command="{Binding SaveStockTakeItemsCommand}"
                                IsEnabled="{Binding CanEditStockTake}"
                                Background="#F1F5F9" Foreground="{StaticResource TextPrimaryBrush}"
                                Height="44" Padding="16,0" Margin="0,0,8,0" FontWeight="SemiBold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Lưu kiểm đếm"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Gửi duyệt -->
                        <Button Command="{Binding SubmitStockTakeCommand}"
                                IsEnabled="{Binding CanSubmitStockTake}"
                                Background="#2563EB" Foreground="#FFFFFF"
                                Height="44" Padding="18,0" Margin="0,0,8,0" FontWeight="Bold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Send24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Gửi chờ duyệt"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Phê duyệt cân bằng kho (Chỉ Quản lý) -->
                        <Button Command="{Binding ApproveStockTakeCommand}"
                                IsEnabled="{Binding CanApproveStockTake}"
                                Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF"
                                Height="44" Padding="20,0" Margin="0,0,8,0" FontWeight="Bold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Duyệt cân bằng kho"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Đóng -->
                        <Button Command="{Binding CloseStockTakeModalCommand}"
                                Background="#E2E8F0" Foreground="{StaticResource TextSecondaryBrush}"
                                Height="44" Padding="18,0" FontWeight="SemiBold" Cursor="Hand">
                            <TextBlock Text="Đóng"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
