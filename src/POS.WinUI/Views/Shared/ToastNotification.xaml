<UserControl x:Class="POS.WinUI.Views.Shared.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Storyboard trượt lên + fade-in khi toast hiện ở góc dưới bên phải (tránh che thanh nút header) -->
        <Storyboard x:Key="EnterAnimation">
            <DoubleAnimation Storyboard.TargetName="ToastTransform"
                             Storyboard.TargetProperty="Y"
                             From="40" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Storyboard trượt xuống + fade-out khi toast ẩn -->
        <Storyboard x:Key="ExitAnimation">
            <DoubleAnimation Storyboard.TargetName="ToastTransform"
                             Storyboard.TargetProperty="Y"
                             To="40" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <!--
        Toast đặt ở góc dưới phải (Panel.ZIndex=999).
        Không che khuất thanh công cụ trên đầu màn hình (như nút Nhập Excel, Thêm sản phẩm).
    -->
    <Border x:Name="ToastBorder"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,28,28"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,10"
            Panel.ZIndex="999"
            Opacity="0"
            Cursor="Hand"
            MouseLeftButtonDown="OnToastClicked"
            IsHitTestVisible="False">

        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTransform" Y="40"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#0F172A" Opacity="0.14" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="IconBorder" Width="26" Height="26" CornerRadius="13" Background="#10B981" Margin="0,0,10,0">
                <ui:SymbolIcon x:Name="ToastIcon" Symbol="Checkmark24" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ToastText"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="#94A3B8" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
