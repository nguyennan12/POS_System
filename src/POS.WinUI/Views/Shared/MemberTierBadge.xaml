<UserControl x:Class="POS.WinUI.Views.Shared.MemberTierBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Border x:Name="BadgeBorder"
            Background="#F1F5F9"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8"
            Padding="7,2.5"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Icon Hạng -->
            <ui:SymbolIcon x:Name="TierIcon"
                           Symbol="PersonCircle24"
                           FontSize="12"
                           Foreground="#475569"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>

            <!-- Tên Hạng Thành Viên -->
            <TextBlock x:Name="TierText"
                       Text="Normal"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#475569"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
