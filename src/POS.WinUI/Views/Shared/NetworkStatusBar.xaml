<UserControl x:Class="POS.WinUI.Views.Shared.NetworkStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        Hiển thị trạng thái kết nối server: chấm màu + text + nút Thử lại.
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Chấm trạng thái: xanh = online, đỏ = offline -->
        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <!-- Mặc định: offline (đỏ) -->
                    <Setter Property="Fill" Value="#EF4444"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8" Color="#EF4444" Opacity="0.8" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="True">
                            <Setter Property="Fill" Value="#34D399"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" Color="#34D399" Opacity="0.8" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <!-- Text trạng thái -->
        <TextBlock Text="{Binding StatusText, ElementName=Root}"
                   Foreground="#E2E8F0"
                   FontSize="13"
                   FontWeight="Medium"
                   VerticalAlignment="Center"/>

        <!-- Nút Thử lại — chỉ hiện khi mất kết nối -->
        <Button Command="{Binding RetryCommand, ElementName=Root}"
                Visibility="{Binding IsConnected, ElementName=Root, Converter={StaticResource InverseBoolToVis}}"
                Background="Transparent"
                BorderThickness="0"
                Padding="6,0,0,0"
                Margin="4,0,0,0"
                Cursor="Hand"
                ToolTip="Thử kết nối lại">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="#FDE047"/>
                <TextBlock Text=" Thử lại" FontSize="12" Foreground="#FDE047"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

    </StackPanel>
</UserControl>
