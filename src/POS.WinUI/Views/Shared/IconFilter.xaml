<UserControl x:Class="POS.WinUI.Views.Shared.IconFilter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="Root">
 <ComboBox Width="44" Height="44" ItemsSource="{Binding ItemsSource, ElementName=Root}"
           DisplayMemberPath="Name" SelectedValuePath="Value"
           SelectedValue="{Binding Value, ElementName=Root, Mode=TwoWay}"
           AutomationProperties.Name="{Binding Label, ElementName=Root}"
           ToolTip="{Binding Label, ElementName=Root}"
           AutomationProperties.HelpText="Alt+Down to open; arrows to choose; Escape to close. Choose All to clear.">
  <ComboBox.Style>
   <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ComboBox">
       <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
         <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
          <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                  BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="10">
           <ui:SymbolIcon Symbol="{Binding Icon, ElementName=Root}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
          </Border>
         </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
         <Border MinWidth="220" MaxWidth="340" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,0,0">
          <ScrollViewer MaxHeight="320" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
         </Border>
        </Popup>
       </Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderBrush}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsApplied, ElementName=Root}" Value="True">
      <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderBrush}"/>
     </DataTrigger>
    </Style.Triggers>
   </Style>
  </ComboBox.Style>
  <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,8"/></Style></ComboBox.ItemContainerStyle>
 </ComboBox>
</UserControl>
