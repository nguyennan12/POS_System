<UserControl x:Class="POS.WinUI.Views.Shared.Components.AppHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:POS.WinUI.Views.Shared.Components"
             x:Name="RootHeader"
             Height="64">

    <Border Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,0">
        <Grid>
            <!-- ── Left: Nút Toggle, Logo (nếu POS), Chi nhánh & Ca làm việc ── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                
                <!-- Nút Thu gọn / Mở rộng Sidebar (Chỉ hiện trong Management Shell) -->
                <Button Command="{Binding ToggleSidebarCommand}"
                        Width="36" Height="36"
                        Margin="0,0,12,0"
                        Padding="0"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Thu gọn / Mở rộng Sidebar (Ctrl+B)"
                        Focusable="False"
                        Visibility="{Binding ElementName=RootHeader, Path=ShowSidebarToggle, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HBtnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="9">
                                <ui:SymbolIcon Symbol="Navigation24" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HBtnBorder" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Logo OraPOS nhỏ (Hiện khi ở màn hình Bán hàng POS) -->
                <StackPanel Orientation="Horizontal" 
                            Margin="0,0,14,0" 
                            VerticalAlignment="Center"
                            Visibility="{Binding ElementName=RootHeader, Path=IsPosMode, Converter={StaticResource BoolToVis}}">
                    <Image Source="/Resources/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OraPOS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ── 1. OWNER: Dropdown chọn & chuyển đổi Chi nhánh ── -->
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,4"
                        Visibility="{Binding IsOwnerRole, Converter={StaticResource BoolToVis}}">
                    <Grid VerticalAlignment="Center">
                        <!-- Trạng thái đang tải chi nhánh -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsLoadingStores, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                             Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                            <TextBlock Text="Đang tải chi nhánh..."
                                       FontSize="12.5" FontWeight="Medium"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Dropdown danh sách chi nhánh (Chỉ dành cho Owner) -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsLoadingStores, Converter={StaticResource InverseBoolToVis}}"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="BuildingShop24" 
                                           FontSize="16" 
                                           Foreground="{StaticResource PrimaryBrush}" 
                                           Margin="2,0,6,0" 
                                           VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Stores}"
                                      SelectedItem="{Binding SelectedStore}"
                                      DisplayMemberPath="Name"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      MinWidth="160"
                                      Cursor="Hand"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 2. CASHIER & STOREMANAGER: Badge thông tin 1 chi nhánh cố định (KHÔNG dropdown) ── -->
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8"
                        Visibility="{Binding IsOwnerRole, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="BuildingShop24" 
                                       FontSize="16" 
                                       Foreground="{StaticResource PrimaryBrush}" 
                                       Margin="0,0,8,0" 
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StoreName}" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Badge Thông tin Ca làm việc (Pill Bo Tròn Nhỏ Xanh Nhạt) -->
                <Border CornerRadius="14"
                        Padding="10,3.5"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Trạng thái mặc định: Chưa mở ca -->
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <!-- Trạng thái: Đang trong ca (Xanh nhạt pastel bo tròn) -->
                                <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Chấm tròn trạng thái nhỏ gọn -->
                        <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                            <!-- Chấm xám khi chưa mở ca -->
                            <Ellipse Width="6.5" Height="6.5" Fill="#94A3B8"
                                     Visibility="{Binding HasOpenShift, Converter={StaticResource InverseBoolToVis}}"/>

                            <!-- Chấm xanh lá nhấp nháy chớp tắt khi Đang trong ca -->
                            <Ellipse Width="6.5" Height="6.5" Fill="#16A34A"
                                     Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" Color="#16A34A" Opacity="0.7" ShadowDepth="0"/>
                                </Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.2" Duration="0:0:0.75"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>

                        <!-- Chữ trạng thái ca nhỏ gọn -->
                        <TextBlock Text="{Binding ShiftName}" 
                                   FontSize="11.5" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                                            <Setter Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Right: Thông báo, CTA Chuyển Màn hình & User Profile ─── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Nút Chuông Thông báo -->
                <Button Padding="0"
                        Margin="0,0,12,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Thông báo hệ thống">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BellBorder" 
                                    Width="38" 
                                    Height="38" 
                                    CornerRadius="10" 
                                    Background="Transparent">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Alert24" 
                                                    FontSize="20" 
                                                    Foreground="{StaticResource TextSecondaryBrush}" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                    <!-- Badge số thông báo chưa đọc -->
                                    <Border Width="16" 
                                            Height="16" 
                                            CornerRadius="8" 
                                            Background="{StaticResource DangerBrush}" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top" 
                                            Margin="0,-5,-5,0">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" 
                                                    FontSize="9.5" 
                                                    FontWeight="Bold" 
                                                    Foreground="White" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BellBorder" Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- NÚT 1: CTA Màn hình Bán hàng (Hiện ở Management View) -->
                <Button Height="40"
                        Margin="14,0,14,0"
                        Command="{Binding OpenPosCashierCommand}"
                        ToolTip="Chuyển sang màn hình bán hàng (Phím tắt F1)"
                        Cursor="Hand"
                        Visibility="{Binding ElementName=RootHeader, Path=IsPosMode, Converter={StaticResource InverseBoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CtaBorder"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="10"
                                    Padding="16,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                      Color="{StaticResource BrandPrimaryColor}" 
                                                      Opacity="0.3" 
                                                      ShadowDepth="2" 
                                                      Direction="270"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Cart24" 
                                                   FontSize="18" 
                                                   Foreground="White" 
                                                   Margin="0,0,8,0" 
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="Màn hình Bán hàng" 
                                               FontSize="13.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="White" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- NÚT 2: CTA Về Trang Quản Lý (Hiện ở POS View, CHỈ CHO PHÉP STOREMANAGER/OWNER) -->
                <Button Height="40"
                        Margin="14,0,14,0"
                        Command="{Binding OpenManagementCommand}"
                        ToolTip="Quay lại Trang quản trị cửa hàng"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ElementName=RootHeader, Path=IsPosMode}" Value="True"/>
                                        <Condition Binding="{Binding IsManagerRole}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MgmtBorder"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Desktop24" 
                                                   FontSize="17" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   Margin="0,0,8,0" 
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="Trang Quản lý" 
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MgmtBorder" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cụm Tài khoản Người dùng (Component độc lập) -->
                <local:UserProfileMenu/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
