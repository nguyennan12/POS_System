<UserControl x:Class="POS.WinUI.Views.Shared.Components.UserProfileMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="RootUserProfile">

    <!-- Cụm Tài khoản Người dùng (Profile Pill với Dropdown Menu) -->
    <Grid x:Name="ProfileContainer">
        <!-- Toggle Button Profile Pill -->
        <ToggleButton x:Name="ProfileToggleBtn"
                      Background="Transparent" 
                      BorderThickness="0" 
                      Padding="0" 
                      Cursor="Hand"
                      IsChecked="{Binding ElementName=ProfilePopup, Path=IsOpen, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ProfileBorder"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Avatar Initials bo tròn -->
                            <Border Width="32" 
                                    Height="32" 
                                    CornerRadius="9" 
                                    Background="{StaticResource PrimaryLightBrush}"
                                    BorderBrush="{StaticResource PrimaryBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding AvatarInitials}" 
                                           FontSize="12.5" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource PrimaryBrush}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Thông tin Tên & Vai trò -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding EmployeeName}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding RoleName}" 
                                           FontSize="11" 
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <!-- Mũi tên Dropdown -->
                            <ui:SymbolIcon x:Name="ChevronIcon"
                                           Symbol="ChevronDown24" 
                                           FontSize="12" 
                                           Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ProfileBorder" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="ProfileBorder" Property="BorderBrush" Value="#CBD5E1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ProfileBorder" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="ProfileBorder" Property="BorderBrush" Value="{StaticResource PrimaryBorderBrush}"/>
                            <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronUp24"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- Dropdown Popup Menu -->
        <Popup x:Name="ProfilePopup"
               PlacementTarget="{Binding ElementName=ProfileToggleBtn}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="8"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <!-- Khung card Dropdown tràn viền, bo góc mượt mà -->
            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="0,6"
                    MinWidth="{Binding ElementName=ProfileToggleBtn, Path=ActualWidth}"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" 
                                      Color="#0F172A" 
                                      Opacity="0.12" 
                                      ShadowDepth="6" 
                                      Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 1. Thông tin cá nhân (Tạm thời không thực hiện hành động) -->
                    <Button Click="OnMenuItemClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,11"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ItemBorder" 
                                        Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Person24" 
                                                       FontSize="18" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                                       Margin="0,0,12,0" 
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="Thông tin cá nhân" 
                                                   FontSize="13.5" 
                                                   FontWeight="Medium" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Ngôn ngữ (Language) - Space Between -->
                    <Button Command="{Binding ToggleLanguageCommand}"
                            Click="OnMenuItemClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,11"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ItemBorder" 
                                        Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <!-- Bên trái: Icon & Text Ngôn ngữ -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="LocalLanguage24" 
                                                           FontSize="18" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                                           Margin="0,0,12,0" 
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="Ngôn ngữ" 
                                                       FontSize="13.5" 
                                                       FontWeight="Medium" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Bên phải (Space-Between): Badge VI/EN -->
                                        <Border HorizontalAlignment="Right" 
                                                VerticalAlignment="Center"
                                                Background="#EFF6FF" 
                                                BorderBrush="#BFDBFE" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="7,2">
                                            <TextBlock Text="{Binding CurrentLanguage, FallbackValue='VI'}" 
                                                       FontSize="11.5" 
                                                       FontWeight="Bold" 
                                                       Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Divider -->
                    <Border Height="1" Background="#F1F5F9" Margin="0,4"/>

                    <!-- 3. Đăng xuất -->
                    <Button Command="{Binding LogoutCommand}"
                            Click="OnMenuItemClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,11"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ItemBorder" 
                                        Background="{TemplateBinding Background}" 
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="SignOut24" 
                                                       FontSize="18" 
                                                       Foreground="{StaticResource DangerBrush}" 
                                                       Margin="0,0,12,0" 
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="Đăng xuất" 
                                                   FontSize="13.5" 
                                                   FontWeight="Medium" 
                                                   Foreground="{StaticResource DangerBrush}" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FEF2F2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
