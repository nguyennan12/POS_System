<UserControl x:Class="POS.WinUI.Views.Shared.TextInputField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Style làm sạch TextBox bên trong: bỏ viền/nền mặc định của WPF-UI, thêm padding trên/dưới rộng rãi -->
        <Style x:Key="CleanInnerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,10,8,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Khung Input bo góc chuẩn 12px, chiều cao 50px -->
    <Border x:Name="ContainerBorder"
            Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="1" 
            CornerRadius="12" 
            Height="50">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- Đổi màu viền sang màu cam thương hiệu khi người dùng focus vào ô nhập -->
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon trái -->
            <ui:SymbolIcon Grid.Column="0"
                           Symbol="{Binding Icon, ElementName=Root}"
                           FontSize="18"
                           Foreground="{StaticResource TextPlaceholderBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

            <!-- TextBox + Placeholder -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="InnerTextBox"
                         Style="{StaticResource CleanInnerTextBoxStyle}"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding PlaceholderText, ElementName=Root}"
                           Foreground="{StaticResource TextPlaceholderBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Hiện placeholder khi TextBox trống -->
                                <DataTrigger Binding="{Binding Text, ElementName=InnerTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=InnerTextBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
