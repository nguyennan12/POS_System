<UserControl x:Class="POS.WinUI.Views.Shared.TextInputField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        Input text generic có icon + placeholder tái sử dụng được ở mọi màn hình (Auth, Customer, Order, Inventory...)
        DPs: Icon (SymbolRegular), PlaceholderText (string), Text (string, TwoWay).
    -->
    <Border Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="1" CornerRadius="12" Height="50">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon trái -->
            <ui:SymbolIcon Grid.Column="0"
                           Symbol="{Binding Icon, ElementName=Root}"
                           FontSize="18"
                           Foreground="{StaticResource TextPlaceholderBrush}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

            <!-- TextBox + Placeholder -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="InnerTextBox"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="6,0,0,0"
                         VerticalAlignment="Center"/>

                <TextBlock Text="{Binding PlaceholderText, ElementName=Root}"
                           Foreground="{StaticResource TextPlaceholderBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Hiện placeholder khi TextBox trống -->
                                <DataTrigger Binding="{Binding Text, ElementName=InnerTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=InnerTextBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
