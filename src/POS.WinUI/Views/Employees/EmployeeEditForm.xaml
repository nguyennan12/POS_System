<UserControl x:Class="POS.WinUI.Views.Employees.EmployeeEditForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Stretch">
        <!-- Error Message Banner -->
        <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="18" Foreground="{StaticResource DangerTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════ 1. THÔNG TIN CÁ NHÂN & LIÊN HỆ ════════════════════ -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Loc[employees.personal_amp_contact_details]}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Họ và tên -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.full_name]}" Style="{StaticResource SectionLabel}"/>
                        <shared:TextInputField Height="44" Icon="Person24" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập họ và tên đầy đủ..." AutomationProperties.Name="Full Name *"/>
                    </StackPanel>

                    <!-- Số điện thoại -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{Binding Loc[employees.phone]}" Style="{StaticResource SectionLabel}"/>
                        <shared:TextInputField Height="44" Icon="Phone24" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 0912345678" AutomationProperties.Name="Phone"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.email]}" Style="{StaticResource SectionLabel}"/>
                        <shared:TextInputField Height="44" Icon="Mail24" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: nhanvien@orapos.vn" AutomationProperties.Name="Email"/>
                    </StackPanel>

                    <!-- Số CCCD / CMND -->
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="{Binding Loc[employees.id_card_citizen_id]}" Style="{StaticResource SectionLabel}"/>
                        <shared:TextInputField Height="44" Icon="ContactCard24" Text="{Binding CitizenId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="12 chữ số căn cước" AutomationProperties.Name="ID Card / Citizen ID"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ════════════════════ 2. TÀI KHOẢN & PHÂN QUYỀN HỆ THỐNG ════════════════════ -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#FFF7ED" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Foreground="#EB7F0E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Loc[employees.account_amp_store_access]}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tên đăng nhập -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.username]}" Style="{StaticResource SectionLabel}"/>
                        <shared:TextInputField Height="44" Icon="Person24" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCreate}" PlaceholderText="Tên đăng nhập hệ thống..." AutomationProperties.Name="Username"/>
                    </StackPanel>

                    <!-- Vai trò hệ thống -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{Binding Loc[employees.system_role]}" Style="{StaticResource SectionLabel}"/>
                        <ComboBox Height="44" ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RoleId, Mode=TwoWay}" IsEnabled="{Binding CanChooseAssignment}" AutomationProperties.Name="System Role"/>
                    </StackPanel>

                    <!-- Chi nhánh làm việc -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.branch_required]}" Style="{StaticResource SectionLabel}"/>
                        <ComboBox Height="44" ItemsSource="{Binding Stores}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding StoreId, Mode=TwoWay}" IsEnabled="{Binding CanChooseAssignment}" AutomationProperties.Name="Branch"/>
                    </StackPanel>

                    <!-- Quyền quản lý toàn chuỗi -->
                    <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,18,0,0">
                        <CheckBox Content="{Binding Loc[employees.chain_owner]}" IsChecked="{Binding IsChainOwner}" IsEnabled="{Binding CanChooseChainOwner}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Mật khẩu và PIN khi tạo mới -->
                <Grid Margin="0,12,0,0" Visibility="{Binding IsCreate, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.initial_password]}" Style="{StaticResource SectionLabel}"/>
                        <PasswordBox Height="44" PasswordChanged="PasswordChanged" AutomationProperties.Name="Initial Password"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Loc[employees.pin_exactly_6_digits]}" Style="{StaticResource SectionLabel}"/>
                        <PasswordBox Height="44" MaxLength="6" PasswordChanged="PinChanged" AutomationProperties.Name="Initial PIN"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ════════════════════ 3. THÔNG TIN LÀM VIỆC & LƯƠNG ════════════════════ -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#ECFDF5" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Briefcase24" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Loc[employees.store_access_amp_work_details]}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ngày vào làm -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.hire_date]}" Style="{StaticResource SectionLabel}"/>
                        <DatePicker Height="44" SelectedDate="{Binding HireDate}" AutomationProperties.Name="Hire Date"/>
                    </StackPanel>

                    <!-- Hình thức làm việc -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{Binding Loc[employees.employment_type]}" Style="{StaticResource SectionLabel}"/>
                        <ComboBox Height="44" ItemsSource="{Binding EmploymentTypes}" SelectedItem="{Binding EmploymentType}" AutomationProperties.Name="Employment Type"/>
                    </StackPanel>

                    <!-- Lương theo giờ -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="{Binding Loc[employees.hourly_wage_vnd_hr]}" Style="{StaticResource SectionLabel}"/>
                        <shared:TextInputField Height="44" Icon="Money24" Text="{Binding HourlyWage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 25000" AutomationProperties.Name="Hourly Wage"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
