<UserControl x:Class="POS.WinUI.Views.Auth.Components.PinInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        Bàn phím nhập mã PIN 6 số gồm:
          • 6 chấm tròn indicator (hiển thị tiến trình nhập)
          • Numpad 3×4 (1-9, Xóa hết, 0, Backspace)

        DPs: PinLength (int), AddDigitCommand, BackspaceCommand, ClearCommand.
        Dùng IsEnabled trên UserControl để lock/unlock khi đang xử lý API.
    -->
    <StackPanel>

        <!-- 6 Chấm tròn PIN -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,24">
            <Border x:Name="Dot0" Style="{StaticResource PinDotStyle}"/>
            <Border x:Name="Dot1" Style="{StaticResource PinDotStyle}"/>
            <Border x:Name="Dot2" Style="{StaticResource PinDotStyle}"/>
            <Border x:Name="Dot3" Style="{StaticResource PinDotStyle}"/>
            <Border x:Name="Dot4" Style="{StaticResource PinDotStyle}"/>
            <Border x:Name="Dot5" Style="{StaticResource PinDotStyle}"/>
        </StackPanel>

        <!-- Numpad 3×4 -->
        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Hàng 1 -->
            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="1" Margin="3"/>
            <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="2" Margin="3"/>
            <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="3" Margin="3"/>

            <!-- Hàng 2 -->
            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="4" Margin="3"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="5" Margin="3"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="6" Margin="3"/>

            <!-- Hàng 3 -->
            <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="7" Margin="3"/>
            <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="8" Margin="3"/>
            <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="9" Margin="3"/>

            <!-- Hàng 4 -->
            <Button Grid.Row="3" Grid.Column="0" Content="Xóa hết" FontSize="13"
                    Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding ClearCommand, ElementName=Root}" Margin="3"/>
            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding AddDigitCommand, ElementName=Root}" CommandParameter="0" Margin="3"/>
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource NumpadButtonStyle}"
                    Command="{Binding BackspaceCommand, ElementName=Root}" Margin="3">
                <ui:SymbolIcon Symbol="Backspace24" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Button>
        </Grid>

    </StackPanel>
</UserControl>
