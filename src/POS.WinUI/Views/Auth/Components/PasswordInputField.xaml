<UserControl x:Class="POS.WinUI.Views.Auth.Components.PasswordInputField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!--
        Input mật khẩu dành riêng cho Auth/Login:
          • Icon khoá ở trái
          • Placeholder text khi trống
          • PasswordBox / TextBox toggle (show/hide) — state quản lý nội bộ
          • Nút mắt ở phải
    -->
    <Border Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="1" CornerRadius="12" Height="50">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon khoá -->
            <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24" FontSize="18"
                           Foreground="{StaticResource TextPlaceholderBrush}"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>

            <!-- PasswordBox / TextBox + placeholder -->
            <Grid Grid.Column="1" VerticalAlignment="Center">

                <!-- PasswordBox — hiển thị khi chưa show password -->
                <PasswordBox x:Name="PwdBox"
                             PasswordChar="●"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             Padding="6,0,0,0"
                             VerticalAlignment="Center"
                             PasswordChanged="PwdBox_PasswordChanged"/>

                <!-- TextBox — hiển thị khi show password -->
                <TextBox x:Name="TxtPassword"
                         Text="{Binding Password, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="6,0,0,0"
                         VerticalAlignment="Center"/>

                <!-- Placeholder — hiện khi Password rỗng -->
                <TextBlock x:Name="Placeholder"
                           Text="{Binding PlaceholderText, ElementName=Root}"
                           Foreground="{StaticResource TextPlaceholderBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Margin="8,0,0,0"
                           Visibility="Visible"/>
            </Grid>

            <!-- Nút ẩn/hiện mật khẩu -->
            <Button Grid.Column="2"
                    Click="TogglePasswordVisibility_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="4">
                <ui:SymbolIcon x:Name="EyeIcon" Symbol="Eye24" FontSize="18"
                               Foreground="{StaticResource TextPlaceholderBrush}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
