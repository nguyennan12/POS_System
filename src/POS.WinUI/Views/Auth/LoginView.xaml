<UserControl x:Class="POS.WinUI.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:POS.WinUI.Converters"
             xmlns:viewModels="clr-namespace:POS.WinUI.ViewModels.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1180">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="InverseNullOrEmptyToVis" Invert="True" />
    </UserControl.Resources>

    <!-- NỀN GRADIENT ẢNH TỔNG THỂ -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/login_bg.jpg" Stretch="UniformToFill" />
        </Grid.Background>

        <!-- Lớp phủ ánh sáng Glass overlay -->
        <Rectangle Fill="#10FFFFFF"/>

        <!-- ===== FLOATING SUCCESS TOAST NOTIFICATION (HIỆU ỨNG TRƯỢT XUỐNG + FADE IN) ===== -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,24,0,0"
                Background="White" 
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="16" 
                Padding="16,10" 
                Panel.ZIndex="999">
            <Border.RenderTransform>
                <TranslateTransform Y="-40"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.14" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVis}}" Value="Visible">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Hiệu ứng trượt xuống từ trên xuống Y: -40 -> 0 -->
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-40" To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Hiệu ứng mờ dần hiện rõ (Fade In) -->
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Hiệu ứng trượt ngược lên nhẹ khi biến mất -->
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-30" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Hiệu ứng mờ dần biến mất (Fade Out) -->
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="#10B981" Margin="0,0,10,0">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Đăng nhập thành công!" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="14" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- BỐ CỤC 2 CỘT CHÍNH -->
        <Grid Margin="48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <!-- ===== CỘT TRÁI (Thương hiệu OraPOS & Giới thiệu) ===== -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Logo & Badge RETAIL OPERATIONS -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Width="56" Height="56" CornerRadius="16" 
                            Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1">
                        <ui:SymbolIcon Symbol="BuildingShop24" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RETAIL OPERATIONS" 
                               Foreground="#E2E8F0" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" 
                               Margin="16,0,0,0"/>
                </StackPanel>

                <!-- 2. Hero Text & Badges -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="OraPOS" 
                               FontSize="82" 
                               FontWeight="Black" 
                               Foreground="White"/>

                    <TextBlock Text="Hệ thống quản lý bán hàng chuyên nghiệp." 
                               FontSize="20" 
                               FontWeight="Medium" 
                               Foreground="#F1F5F9" 
                               Margin="0,8,0,24"/>

                    <!-- Feature Badges -->
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="16" Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#FDE047" Margin="0,0,6,0"/>
                                <TextBlock Text="Nhanh chóng" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="#FDE047" Margin="0,0,6,0"/>
                                <TextBlock Text="Thông minh" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="#86EFAC" Margin="0,0,6,0"/>
                                <TextBlock Text="Tin cậy" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Footer phiên bản & Trạng thái Cloud -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Phiên bản v1.0.0" Foreground="#E2E8F0" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="•" Foreground="#94A3B8" FontSize="13" Margin="12,0"/>
                    
                    <!-- Status Dot (Xanh lá khi đã kết nối, Đỏ khi mất kết nối) -->
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" Color="#EF4444" Opacity="0.8" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                        <Setter Property="Fill" Value="#34D399"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="8" Color="#34D399" Opacity="0.8" ShadowDepth="0"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding ServerStatusText}" Foreground="#E2E8F0" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>

                    <!-- Nút Thử lại khi mất kết nối -->
                    <Button Command="{Binding CheckConnectionAndLoadStoresCommand}"
                            Visibility="{Binding IsServerConnected, Converter={StaticResource InverseBoolToVis}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,0,0,0"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            ToolTip="Thử kết nối lại">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="#FDE047"/>
                            <TextBlock Text=" Thử lại" FontSize="12" Foreground="#FDE047" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== CỘT PHẢI (Card Đăng nhập Trắng Bo Góc) ===== -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="28" 
                    Padding="36,46" 
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#1E0A02" Opacity="0.25" ShadowDepth="15" Direction="270"/>
                </Border.Effect>

                <StackPanel>
                    <!-- 1. Dropdown chọn Chi nhánh (Góc trên bên phải) -->
                    <Border HorizontalAlignment="Right" 
                            Background="{StaticResource InputBackgroundBrush}" 
                            BorderBrush="{StaticResource InputBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="12,6" 
                            Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BuildingShop24" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Stores}" 
                                      SelectedItem="{Binding SelectedStore}" 
                                      DisplayMemberPath="DisplayText"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      MinWidth="200"
                                      Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Tiêu đề Card -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Wifi124" FontSize="14" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="STAFF ACCESS" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Chào mừng trở lại" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Đăng nhập để bắt đầu ca làm việc của bạn." 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 3. Thanh chuyển Tab (Segmented Control: Mật khẩu / Mã PIN) -->
                    <Border Background="{StaticResource SegmentedBackgroundBrush}" CornerRadius="14" Padding="4" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tab Mật khẩu -->
                            <Button Grid.Column="0" 
                                    Content="Mật khẩu"
                                    Command="{Binding SwitchToPasswordCommand}"
                                    Height="44" 
                                    FontSize="15" 
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinMode}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" Color="{StaticResource BrandPrimaryColor}" Opacity="0.35" ShadowDepth="2" Direction="270"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab Mã PIN -->
                            <Button Grid.Column="1" 
                                    Content="Mã PIN"
                                    Command="{Binding SwitchToPinCommand}"
                                    Height="44" 
                                    FontSize="15" 
                                    FontWeight="Bold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" Color="{StaticResource BrandPrimaryColor}" Opacity="0.35" ShadowDepth="2" Direction="270"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 4. Thông báo lỗi (Error Banner) -->
                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"
                            Background="{StaticResource DangerBgBrush}" 
                            BorderBrush="{StaticResource DangerBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="14,10" 
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ErrorCircle24" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" 
                                       Foreground="{StaticResource DangerTextBrush}" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center" 
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- ===== TAB 1: FORM MẬT KHẨU ===== -->
                    <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource InverseBoolToVis}}">
                        <!-- Tên đăng nhập -->
                        <TextBlock Text="Tên đăng nhập" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Height="50" Margin="0,0,0,16">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Person24" FontSize="18" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtUsername"
                                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             FontSize="14" 
                                             Padding="6,0,0,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Nhập tên đăng nhập" 
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtUsername}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtUsername}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Mật khẩu -->
                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Height="50" Margin="0,0,0,16">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24" FontSize="18" Foreground="{StaticResource TextPlaceholderBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Password Input (Hiển thị hoặc Ẩn) -->
                                    <PasswordBox x:Name="PwdBox"
                                                 Visibility="{Binding IsPasswordShown, Converter={StaticResource InverseBoolToVis}}"
                                                 PasswordChar="●"
                                                 Background="Transparent" 
                                                 BorderThickness="0" 
                                                 FontSize="14" 
                                                 Padding="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 PasswordChanged="PwdBox_PasswordChanged"/>

                                    <TextBox x:Name="TxtPassword"
                                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsPasswordShown, Converter={StaticResource BoolToVis}}"
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             FontSize="14" 
                                             Padding="6,0,0,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Nhập mật khẩu" 
                                               Foreground="{StaticResource TextPlaceholderBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Password}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Password}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Nút Ẩn/Hiện mật khẩu -->
                                <Button Grid.Column="2" 
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Padding="4">
                                    <ui:SymbolIcon FontSize="18" Foreground="{StaticResource TextPlaceholderBrush}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="Eye24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordShown}" Value="True">
                                                        <Setter Property="Symbol" Value="EyeOff24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Ghi nhớ & Quên mật khẩu -->
                        <Grid Margin="0,0,0,22">
                            <CheckBox Content="Ghi nhớ đăng nhập" 
                                      IsChecked="{Binding RememberMe}"
                                      FontSize="13" 
                                      Foreground="{StaticResource TextMutedBrush}" 
                                      VerticalAlignment="Center"/>

                            <Button Content="Quên mật khẩu?" 
                                     HorizontalAlignment="Right"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource PrimaryBrush}" 
                                     FontSize="13" 
                                     FontWeight="SemiBold"
                                     Cursor="Hand"/>
                        </Grid>

                        <!-- Nút Đăng nhập -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"
                                Command="{Binding LoginPasswordCommand}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="ĐĂNG NHẬP" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="ĐANG XỬ LÝ..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- ===== TAB 2: FORM MÃ PIN ===== -->
                    <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource BoolToVis}}">
                        <!-- 6 Chấm tròn PIN Indicators -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,24">
                            <Border Style="{StaticResource PinDotStyle}" Tag="{Binding PinDot0}"/>
                            <Border Style="{StaticResource PinDotStyle}" Tag="{Binding PinDot1}"/>
                            <Border Style="{StaticResource PinDotStyle}" Tag="{Binding PinDot2}"/>
                            <Border Style="{StaticResource PinDotStyle}" Tag="{Binding PinDot3}"/>
                            <Border Style="{StaticResource PinDotStyle}" Tag="{Binding PinDot4}"/>
                            <Border Style="{StaticResource PinDotStyle}" Tag="{Binding PinDot5}"/>
                        </StackPanel>

                        <!-- Bàn phím số Numpad 3x4 (Tạm khóa khi đang xử lý API) -->
                        <Grid Margin="0,0,0,16" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hàng 1: 1, 2, 3 -->
                            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="1" Margin="3"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="2" Margin="3"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="3" Margin="3"/>

                            <!-- Hàng 2: 4, 5, 6 -->
                            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="4" Margin="3"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="5" Margin="3"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="6" Margin="3"/>

                            <!-- Hàng 3: 7, 8, 9 -->
                            <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="7" Margin="3"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="8" Margin="3"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="9" Margin="3"/>

                            <!-- Hàng 4: Xóa hết, 0, Backspace -->
                            <Button Grid.Row="3" Grid.Column="0" Content="Xóa hết" Style="{StaticResource NumpadButtonStyle}" FontSize="13" Command="{Binding ClearPinCommand}" Margin="3"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumpadButtonStyle}" Command="{Binding AddPinCommand}" CommandParameter="0" Margin="3"/>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource NumpadButtonStyle}" Command="{Binding BackspacePinCommand}" Margin="3">
                                <ui:SymbolIcon Symbol="Backspace24" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Nút Vào ca bằng PIN -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                IsEnabled="{Binding CanSubmitPin}"
                                Command="{Binding LoginPinCommand}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="VÀO CA BẰNG MÃ PIN" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="ĐANG XÁC THỰC..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 5. Chân trang ghi chú -->
                    <TextBlock Text="Cần hỗ trợ? Vui lòng liên hệ quản lý cửa hàng." 
                               FontSize="12" 
                               Foreground="{StaticResource TextPlaceholderBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
