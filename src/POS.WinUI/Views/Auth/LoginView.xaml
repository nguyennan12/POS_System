<UserControl x:Class="POS.WinUI.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared"
             xmlns:authComp="clr-namespace:POS.WinUI.Views.Auth.Components"
             xmlns:viewModels="clr-namespace:POS.WinUI.ViewModels.Auth"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1180">

    <!-- NỀN GRADIENT ẢNH TỔNG THỂ -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/login_bg.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Lớp phủ ánh sáng Glass overlay -->
        <Rectangle Fill="#10FFFFFF"/>

        <!-- ===== TOAST THÀNH CÔNG (Shared UI generic) ===== -->
        <shared:ToastNotification Message="{Binding SuccessMessage}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  Panel.ZIndex="999"/>

        <!-- BỐ CỤC 2 CỘT CHÍNH -->
        <Grid Margin="48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <!-- ===== CỘT TRÁI (Thương hiệu OraPOS & Giới thiệu) ===== -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Logo & Badge RETAIL OPERATIONS -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Grid Width="56" Height="56" VerticalAlignment="Center">
                        <!-- Vùng sáng Ambient Glow ấm áp phía sau logo -->
                        <Ellipse Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#60ED7A1C" Offset="0.0"/>
                                    <GradientStop Color="#20ED7A1C" Offset="0.55"/>
                                    <GradientStop Color="#00ED7A1C" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Logo chính -->
                        <Image Source="/Assets/logo.png" Width="52" Height="52"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="RETAIL OPERATIONS" Foreground="#E2E8F0"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- 2. Hero Text & Badges -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="OraPOS" FontSize="100" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="Hệ thống quản lý bán hàng chuyên nghiệp."
                               FontSize="20" FontWeight="Medium" Foreground="#F1F5F9"
                               Margin="0,8,0,24"/>

                    <!-- Feature Badges -->
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="16" Background="{StaticResource BadgeBackgroundBrush}"
                                BorderBrush="{StaticResource BadgeBorderBrush}" BorderThickness="1"
                                Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="16"
                                               Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Nhanh chóng" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Background="{StaticResource BadgeBackgroundBrush}"
                                BorderBrush="{StaticResource BadgeBorderBrush}" BorderThickness="1"
                                Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="16"
                                               Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Thông minh" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Background="{StaticResource BadgeBackgroundBrush}"
                                BorderBrush="{StaticResource BadgeBorderBrush}" BorderThickness="1"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16"
                                               Foreground="#86EFAC" Margin="0,0,6,0"/>
                                <TextBlock Text="Tin cậy" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Footer phiên bản & Trạng thái Network (Shared UI generic) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Phiên bản v1.0.0" Foreground="#E2E8F0" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="•" Foreground="#94A3B8" FontSize="13" Margin="12,0"/>
                    <shared:NetworkStatusBar
                        IsConnected="{Binding IsServerConnected}"
                        StatusText="{Binding ServerStatusText}"
                        RetryCommand="{Binding CheckConnectionAndLoadStoresCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ===== CỘT PHẢI (Card Đăng nhập) ===== -->
            <Border Grid.Column="1"
                    Background="White" CornerRadius="28" Padding="36,26,36,36"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#1E0A02" Opacity="0.25" ShadowDepth="15" Direction="270"/>
                </Border.Effect>

                <StackPanel>
                    <!-- 1. Header Card: STAFF ACCESS (Trái) & Dropdown Chi nhánh (Phải) -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bên trái: STAFF ACCESS -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wifi124" FontSize="14"
                                           Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="STAFF ACCESS" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryAccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Bên phải: Dropdown chọn Chi nhánh kèm trạng thái Loading -->
                        <Border Grid.Column="2"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12,6">
                            <Grid>
                                <!-- Trạng thái đang tải chi nhánh -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsLoadingStores, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                                     Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                                    <TextBlock Text="Đang tải..."
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" MinWidth="130"/>
                                </StackPanel>

                                <!-- Trạng thái hiển thị danh sách chi nhánh -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsLoadingStores, Converter={StaticResource InverseBoolToVis}}"
                                            VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="BuildingShop24" FontSize="16"
                                                   Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Stores}"
                                              SelectedItem="{Binding SelectedStore}"
                                              DisplayMemberPath="DisplayText"
                                              Background="Transparent" BorderThickness="0"
                                              FontSize="13" FontWeight="SemiBold"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              MinWidth="170" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 2. Tiêu đề Card -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="Chào mừng trở lại" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Đăng nhập để bắt đầu ca làm việc của bạn."
                                   FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 3. Segmented Control: Mật khẩu / Mã PIN -->
                    <Border Background="{StaticResource SegmentedBackgroundBrush}"
                            CornerRadius="14" Padding="4" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tab Mật khẩu: active khi IsPinMode=False -->
                            <Button Grid.Column="0" Content="Mật khẩu"
                                    Command="{Binding SwitchToPasswordCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinMode}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" Color="{StaticResource BrandPrimaryColor}"
                                                                          Opacity="0.35" ShadowDepth="2" Direction="270"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab Mã PIN: active khi IsPinMode=True -->
                            <Button Grid.Column="1" Content="Mã PIN"
                                    Command="{Binding SwitchToPinCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" Color="{StaticResource BrandPrimaryColor}"
                                                                          Opacity="0.35" ShadowDepth="2" Direction="270"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 4. Error Banner -->
                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"
                            Background="{StaticResource DangerBgBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ErrorCircle24" FontSize="18"
                                           Foreground="{StaticResource DangerBrush}"
                                           Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource DangerTextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- ===== TAB 1: FORM MẬT KHẨU ===== -->
                    <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource InverseBoolToVis}}">

                        <!-- Username -->
                        <TextBlock Text="Tên đăng nhập" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <shared:TextInputField
                            Icon="Person24"
                            PlaceholderText="Nhập tên đăng nhập"
                            Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,16"/>

                        <!-- Password -->
                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <authComp:PasswordInputField
                            PlaceholderText="Nhập mật khẩu"
                            Password="{Binding Password, Mode=TwoWay}"
                            Margin="0,0,0,16"/>

                        <!-- Ghi nhớ & Quên mật khẩu -->
                        <Grid Margin="0,0,0,22">
                            <CheckBox Content="Ghi nhớ đăng nhập"
                                      IsChecked="{Binding RememberMe}"
                                      FontSize="13"
                                      Foreground="{StaticResource TextMutedBrush}"
                                      VerticalAlignment="Center"/>
                            <Button Content="Quên mật khẩu?" HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>

                        <!-- Nút Đăng nhập -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"
                                Command="{Binding LoginPasswordCommand}">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="ĐĂNG NHẬP" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                                     Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="ĐANG XỬ LÝ..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- ===== TAB 2: FORM MÃ PIN ===== -->
                    <StackPanel Visibility="{Binding IsPinMode, Converter={StaticResource BoolToVis}}">

                        <!-- PinInput: dots + numpad (thuộc Auth Components) -->
                        <authComp:PinInput
                            PinLength="{Binding PinLength}"
                            AddDigitCommand="{Binding AddPinCommand}"
                            BackspaceCommand="{Binding BackspacePinCommand}"
                            ClearCommand="{Binding ClearPinCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Nút Vào ca bằng PIN -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                IsEnabled="{Binding CanSubmitPin}"
                                Command="{Binding LoginPinCommand}">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="VÀO CA BẰNG MÃ PIN" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                                     Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="ĐANG XÁC THỰC..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 5. Chân trang -->
                    <TextBlock Text="Cần hỗ trợ? Vui lòng liên hệ quản lý cửa hàng."
                               FontSize="12" Foreground="{StaticResource TextPlaceholderBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
