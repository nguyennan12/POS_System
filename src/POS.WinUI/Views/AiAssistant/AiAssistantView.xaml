<UserControl x:Class="POS.WinUI.Views.AiAssistant.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180">
    <Grid>
        <!-- Khung hội thoại nổi phía trên nút chatbot -->
        <Border x:Name="ChatPanel"
                Width="370" Height="510"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="18,0,0,122"
                Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1"
                CornerRadius="18" Padding="0"
                Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Color="#FF0F172A" Opacity="0.16" ShadowDepth="5" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,14,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="13" Background="#FFFFF7ED" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Chat24" FontSize="21" Foreground="#FFEA580C"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Trợ lý AI" FontSize="15" FontWeight="Bold" Foreground="#FF0F172A"/>
                            <TextBlock Text="Hỏi đáp nhanh" FontSize="11" Foreground="#FF64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Mới" Command="{Binding ClearConversationCommand}"
                            Padding="9,6" Margin="4,0" VerticalAlignment="Center"
                            FontSize="11" ToolTip="Bắt đầu cuộc trò chuyện mới"/>
                    <Button Grid.Column="2" Content="×" Command="{Binding CloseChatCommand}"
                            Width="32" Height="32" Margin="3,0,0,0" VerticalAlignment="Center"
                            FontSize="20" Padding="0" ToolTip="Đóng chat"/>
                </Grid>

                <Border Grid.Row="1" Background="#FFFFF7ED" BorderBrush="#FFFED7AA"
                        BorderThickness="0,1,0,1" Padding="13,9">
                    <TextBlock Text="Đang hỗ trợ kiến thức chung. Tra cứu và thao tác POS chưa bật; không gửi mật khẩu, mã PIN hoặc dữ liệu nhạy cảm."
                               FontSize="11" Foreground="#FF9A3412" TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="2" Margin="12,12,8,8"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="MessageBubble" HorizontalAlignment="Left"
                                            MaxWidth="300" Background="#FFF1F5F9" CornerRadius="13"
                                            Padding="12,9" Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                       FontSize="13" Foreground="#FF0F172A"/>
                                            <TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right"
                                                       FontSize="10" Foreground="#FF64748B" Margin="0,5,0,0"/>
                                            <Button Content="Thử lại"
                                                    Command="{Binding DataContext.RetryMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0"
                                                    FontSize="11" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="MessageBubble" Property="Background" Value="#FFFFEDD5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="MessageBubble" Property="Background" Value="#FFFEF2F2"/>
                                            <Setter TargetName="MessageBubble" Property="BorderBrush" Value="#FFFECACA"/>
                                            <Setter TargetName="MessageBubble" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#FFF8FAFC" CornerRadius="12" Padding="10,8"
                                HorizontalAlignment="Left" Margin="0,0,0,8"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ProgressBar Width="28" Height="4" IsIndeterminate="True" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="Trợ lý đang trả lời..." FontSize="11" Foreground="#FF64748B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="12,4,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding MessageDraft, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="MessageInput"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             MinHeight="44" MaxHeight="86" Padding="11,8"
                             VerticalContentAlignment="Center" FontSize="13"
                             PreviewKeyDown="OnMessageInputPreviewKeyDown"
                             ToolTip="Enter để gửi, Shift+Enter để xuống dòng"/>
                    <Button Grid.Column="1" Content="Gửi" Command="{Binding SendMessageCommand}"
                            MinWidth="58" Height="44" Margin="8,0,0,0" VerticalAlignment="Bottom"
                            FontSize="12"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Nút tròn luôn hiển thị ở góc dưới bên trái -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,48"
                Width="58" Height="58" Padding="0" BorderThickness="0"
                Background="#FFEA580C" Foreground="White"
                Command="{Binding ToggleChatCommand}" ToolTip="Chat với trợ lý AI">
            <Button.Effect>
                <DropShadowEffect BlurRadius="14" Color="#FF9A3412" Opacity="0.3" ShadowDepth="3"/>
            </Button.Effect>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="FabBorder" Background="{TemplateBinding Background}"
                            CornerRadius="29" Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FabBorder" Property="Background" Value="#FFC2410C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="FabBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <ui:SymbolIcon Symbol="Chat24" FontSize="25" Foreground="White"/>
        </Button>
    </Grid>
</UserControl>
