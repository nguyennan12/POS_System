<UserControl x:Class="POS.WinUI.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:POS.WinUI.Views.Customers.Components"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid>
        <!-- Giao diện chính phân trang -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,28">
                <!-- ════════════════════ 1. HEADER MÀN HÌNH ════════════════════ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Home24" FontSize="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[breadcrumb.home], StringFormat='{}{0}  /  '}" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[customers.title]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="People24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc[customers.title]}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nút thao tác phía trên bên phải -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="14,0" Margin="0,0,10,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Loc[common.refresh]}" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenCreateCustomerCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="16,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PersonAdd24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Loc[customers.add_new]}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ════════════════════ 2. DÃY 4 THẺ CHỈ SỐ KPI ════════════════════ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tổng khách hàng -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="People24" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc[customers.kpi_total]}" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalCustomersCount, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Khách hàng mới trong tháng -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="10" Background="#ECFDF5" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="PersonAdd24" FontSize="18" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc[customers.kpi_new]}" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding NewCustomersThisMonth, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Điểm thưởng khả dụng -->
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="10" Background="#FFF7ED" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="RibbonStar24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc[customers.kpi_points]}" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalLoyaltyPoints, StringFormat='{}{0:N0} đ'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tỷ lệ tài khoản hoạt động -->
                    <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="10" Background="#F8FAFC" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc[customers.kpi_active_rate]}" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ActiveCustomersRate}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ════════════════════ 3. THANH TAB CON ĐIỀU HƯỚNG ════════════════════ -->
                <Border Background="#F1F5F9" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 1: Danh sách khách hàng -->
                        <RadioButton GroupName="CustomerTabs" IsChecked="{Binding IsCustomerListTab, Mode=TwoWay}"
                                     Height="34" Padding="16,0" Cursor="Hand" VerticalContentAlignment="Center">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="People24" FontSize="14" Foreground="#64748B" Margin="0,0,6,0" x:Name="TabIcon"/>
                                            <TextBlock Text="{Binding Loc[customers.tab_list]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" x:Name="TabText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="TabIcon" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 2: Hạng thành viên & Chính sách -->
                        <RadioButton GroupName="CustomerTabs" IsChecked="{Binding IsTiersTab, Mode=TwoWay}"
                                     Height="34" Padding="16,0" Margin="4,0,0,0" Cursor="Hand" VerticalContentAlignment="Center">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="RibbonStar24" FontSize="14" Foreground="#64748B" Margin="0,0,6,0" x:Name="TabIcon"/>
                                            <TextBlock Text="{Binding Loc[customers.tab_tiers]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" x:Name="TabText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="TabIcon" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 3: Nhật ký biến động điểm -->
                        <RadioButton GroupName="CustomerTabs" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"
                                     Height="34" Padding="16,0" Margin="4,0,0,0" Cursor="Hand" VerticalContentAlignment="Center">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="#64748B" Margin="0,0,6,0" x:Name="TabIcon"/>
                                            <TextBlock Text="{Binding Loc[customers.tab_history]}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" x:Name="TabText" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter TargetName="TabIcon" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- ════════════════════ 4. NỘI DUNG TỪNG PHÂN TAB ════════════════════ -->
                <!-- Tab 1 Component -->
                <components:CustomerTableComponent Visibility="{Binding IsCustomerListTab, Converter={StaticResource BoolToVis}}"/>

                <!-- Tab 2 Component -->
                <components:MemberTierGridComponent Visibility="{Binding IsTiersTab, Converter={StaticResource BoolToVis}}"/>

                <!-- Tab 3 Component -->
                <components:LoyaltyHistoryTableComponent Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════ 5. MODAL OVERLAYS & TOAST ════════════════════ -->
        <!-- Popup Thêm/Sửa khách hàng -->
        <components:CustomerEditModal Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000"/>

        <!-- Popup Điều chỉnh điểm -->
        <components:PointAdjustModal Visibility="{Binding IsPointModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000"/>

        <!-- Popup Cấu hình hạng thẻ -->
        <components:TierEditModal Visibility="{Binding IsTierModalOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000"/>

        <!-- Toast thông báo kết quả -->
        <shared:ToastNotification Message="{Binding ToastMessage}" ToastType="{Binding ToastType}" VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="2000"/>
    </Grid>
</UserControl>
