<UserControl x:Class="POS.WinUI.Views.Customers.Components.MemberTierGridComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner giải thích chính sách -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,18">
            <DockPanel VerticalAlignment="Center">
                <Border DockPanel.Dock="Right" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="#059669" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Loc[customers.tier_auto_applied]}" FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#FFF7ED" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="RibbonStar24" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[customers.tier_policy_title]}" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding Loc[customers.tier_policy_sub]}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lưới 4 thẻ Hạng thành viên -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MemberTiers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Thẻ chính có màu viền và hiệu ứng bóng theo từng hạng -->
                        <Border CornerRadius="18" Padding="20" Margin="0,0,16,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.04"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="VIP">
                                            <Setter Property="BorderBrush" Value="#C084FC"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#FAF5FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#7E22CE" Opacity="0.12"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                            <Setter Property="BorderBrush" Value="#C084FC"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#FAF5FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#7E22CE" Opacity="0.12"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Gold">
                                            <Setter Property="BorderBrush" Value="#FBBF24"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#FFFBEB" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#D97706" Opacity="0.12"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="Silver">
                                            <Setter Property="BorderBrush" Value="#7DD3FC"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#F0F9FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#0284C7" Opacity="0.10"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header thẻ: Header background, Icon, Tier Name, Badge -->
                                <Border Grid.Row="0" CornerRadius="12" Padding="12,10" Margin="0,0,0,16" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FAF5FF" Offset="0"/>
                                                                <GradientStop Color="#E9D5FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#C084FC"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FAF5FF" Offset="0"/>
                                                                <GradientStop Color="#E9D5FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#C084FC"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FFFBEB" Offset="0"/>
                                                                <GradientStop Color="#FEF08A" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#FBBF24"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#F0F9FF" Offset="0"/>
                                                                <GradientStop Color="#E0F2FE" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel VerticalAlignment="Center">
                                        <!-- Chip nhãn hạng đặc biệt -->
                                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,2.5" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                            <Setter Property="Background" Value="#7E22CE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                            <Setter Property="Background" Value="#7E22CE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                            <Setter Property="Background" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="TIÊU CHUẨN"/>
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                                <Setter Property="Text" Value="VIP"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                                <Setter Property="Text" Value="KIM CƯƠNG"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                                <Setter Property="Text" Value="HOÀNG KIM"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                                <Setter Property="Text" Value="BẠC"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Biểu tượng và Tên hạng -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="PersonCircle24"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                                <Setter Property="Symbol" Value="Premium24"/>
                                                                <Setter Property="Foreground" Value="#7E22CE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                                <Setter Property="Symbol" Value="Premium24"/>
                                                                <Setter Property="Foreground" Value="#7E22CE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                                <Setter Property="Symbol" Value="Trophy24"/>
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                                <Setter Property="Symbol" Value="RibbonStar24"/>
                                                                <Setter Property="Foreground" Value="#0284C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#334155"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                                <Setter Property="Foreground" Value="#6B21A8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                                <Setter Property="Foreground" Value="#6B21A8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                                <Setter Property="Foreground" Value="#854D0E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Ngưỡng chi tiêu thăng hạng -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding DataContext.Loc[customers.min_spend], RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11.5" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding MinSpending, StringFormat='{}{0:N0} đ'}" FontSize="17" FontWeight="Bold" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                        <Setter Property="Foreground" Value="#6B21A8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                        <Setter Property="Foreground" Value="#6B21A8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                        <Setter Property="Foreground" Value="#0369A1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Quyền lợi hạng thẻ (Hộp quyền lợi có viền màu sang trọng) -->
                                <Border Grid.Row="2" CornerRadius="12" Padding="14,12" Margin="0,0,0,16" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="VIP">
                                                    <Setter Property="Background" Value="#FAF5FF"/>
                                                    <Setter Property="BorderBrush" Value="#E9D5FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Diamond">
                                                    <Setter Property="Background" Value="#FAF5FF"/>
                                                    <Setter Property="BorderBrush" Value="#E9D5FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Gold">
                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                    <Setter Property="BorderBrush" Value="#FEF08A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Silver">
                                                    <Setter Property="Background" Value="#F0F9FF"/>
                                                    <Setter Property="BorderBrush" Value="#E0F2FE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Tích điểm đơn hàng -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DataContext.Loc[customers.rate_point], RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="#475569"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PointRate, StringFormat='{}{0:G29}%'}" FontSize="12.5" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <!-- Tỷ lệ chiết khấu giảm giá -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DataContext.Loc[customers.rate_discount], RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="#475569"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountRate, StringFormat='{}{0:G29}%'}" FontSize="12.5" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <!-- Quy đổi điểm -->
                                        <DockPanel>
                                            <TextBlock Text="{Binding DataContext.Loc[customers.point_exchange], RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="#475569"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PointRedemptionRate, StringFormat='{}1 đ = {0:N0}đ'}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Nút chỉnh sửa chính sách (Dành cho Owner) -->
                                <Button Grid.Row="3" 
                                        Command="{Binding DataContext.OpenEditTierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource OutlineButtonStyle}" 
                                        Height="38" 
                                        HorizontalAlignment="Stretch" 
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DataContext.Loc[customers.edit_policy], RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
