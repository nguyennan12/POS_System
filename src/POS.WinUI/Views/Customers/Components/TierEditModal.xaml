<UserControl x:Class="POS.WinUI.Views.Customers.Components.TierEditModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid Background="#66000000" MouseDown="OnBackdropMouseDown">
        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                CornerRadius="18" Padding="26"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="RibbonStar24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Chính sách hạng " FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding EditingTier.Name}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Cấu hình hạn mức thăng hạng và tỷ lệ ưu đãi" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CloseTierModalCommand}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- Body -->
                <StackPanel Grid.Row="1">
                    <!-- Lỗi nhập liệu -->
                    <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding TierErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                        <TextBlock Text="{Binding TierErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Chi tiêu tối thiểu -->
                    <TextBlock Text="Hạn mức chi tiêu tối thiểu (VNĐ) *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <shared:TextInputField Height="44" Icon="Money24" Text="{Binding TierMinSpendingText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 5,000,000" Margin="0,0,0,14"/>

                    <!-- Tỷ lệ tích điểm % -->
                    <TextBlock Text="Tỷ lệ tích điểm đơn hàng (%) *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <shared:TextInputField Height="44" Icon="Receipt24" Text="{Binding TierPointRateText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 1.5 (Tương đương 1.5% giá trị đơn)" Margin="0,0,0,14"/>

                    <!-- Tỷ lệ chiết khấu giảm giá % -->
                    <TextBlock Text="Tỷ lệ giảm giá trực tiếp (%) *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <shared:TextInputField Height="44" Icon="Tag24" Text="{Binding TierDiscountRateText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 5 (Giảm 5% hóa đơn)"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ" Command="{Binding CloseTierModalCommand}"
                                Style="{StaticResource OutlineButtonStyle}" Height="42" HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="2" Content="Lưu chính sách" Command="{Binding SaveTierPolicyCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="42" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
