<UserControl x:Class="POS.WinUI.Views.Customers.Components.PointAdjustModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid Background="#66000000" MouseDown="OnBackdropMouseDown">
        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                CornerRadius="18" Padding="26"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.3"/>
            </Border.Effect>

            <Grid DataContext="{Binding PointAdjustDialog}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FFF7ED" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="RibbonStar24" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Điều chỉnh điểm thưởng" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Cộng hoặc trừ điểm tích lũy cho khách hàng" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding DataContext.CloseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- 2. Body -->
                <StackPanel Grid.Row="1">
                    <!-- Thông tin khách hàng & số dư hiện có -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentBalance, StringFormat='{}{0:N0} đ'}" FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                            <StackPanel>
                                <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Số dư điểm tích lũy hiện có" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Lỗi nhập liệu -->
                    <Border Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="15" Foreground="{StaticResource DangerTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Loại điều chỉnh (Cộng / Trừ) -->
                    <TextBlock Text="Loại điều chỉnh" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Content="Cộng thêm điểm (+)" IsChecked="{Binding IsAccrue, Mode=TwoWay}" FontSize="12.5" Cursor="Hand"/>
                        <RadioButton Grid.Column="2" Content="Trừ bớt điểm (-)" IsChecked="{Binding IsAccrue, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" FontSize="12.5" Cursor="Hand"/>
                    </Grid>

                    <!-- Số điểm điều chỉnh -->
                    <TextBlock Text="Số điểm điều chỉnh *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <shared:TextInputField Height="44" Icon="NumberSymbol24" Text="{Binding PointsText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: 50" Margin="0,0,0,14"/>

                    <!-- Lý do điều chỉnh -->
                    <TextBlock Text="Lý do điều chỉnh (bắt buộc) *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <shared:TextInputField Height="44" Icon="Note24" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ví dụ: Bù điểm sự cố hệ thống / Quà sinh nhật..."/>
                </StackPanel>

                <!-- 3. Footer -->
                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ"
                                Command="{Binding DataContext.CloseModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource OutlineButtonStyle}" Height="42" HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="2" 
                                Command="{Binding DataContext.SubmitAdjustPointsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="42" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,8,0"
                                                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Xác nhận" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
