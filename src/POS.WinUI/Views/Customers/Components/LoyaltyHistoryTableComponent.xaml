<UserControl x:Class="POS.WinUI.Views.Customers.Components.LoyaltyHistoryTableComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Khách hàng đang chọn tra cứu -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButtonStyle}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Tải lại nhật ký" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#EFF6FF" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nhật ký biến động điểm:" FontSize="13.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding HistorySelectedCustomer.Name, TargetNullValue='Tất cả giao dịch gần đây'}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <TextBlock Text="Theo dõi các giao dịch tích điểm từ hóa đơn, đổi điểm thanh toán và điều chỉnh từ quản trị viên" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bảng danh sách giao dịch điểm -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding PointTransactions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="46">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Thời gian -->
                            <DataGridTemplateColumn Header="THỜI GIAN" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Loại giao dịch -->
                            <DataGridTemplateColumn Header="LOẠI GIAO DỊCH" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Accrue">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Redeem">
                                                            <Setter Property="Background" Value="#FFF7ED"/>
                                                            <Setter Property="BorderBrush" Value="#FED7AA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Type}" FontSize="11.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Accrue">
                                                                <Setter Property="Text" Value="Tích điểm POS (+)"/>
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Redeem">
                                                                <Setter Property="Text" Value="Đổi điểm (-)"/>
                                                                <Setter Property="Foreground" Value="#EA580C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Adjust">
                                                                <Setter Property="Text" Value="Điều chỉnh thủ công"/>
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Số điểm biến động -->
                            <DataGridTemplateColumn Header="SỐ ĐIỂM" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Points, StringFormat='{}{0:+0;-0;0} đ'}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Redeem">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ghi chú / Lý do -->
                            <DataGridTemplateColumn Header="GHI CHÚ / LÝ DO" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note, TargetNullValue='—'}" FontSize="12.5" Foreground="#334155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="18" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="History24" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chưa có nhật ký giao dịch điểm nào" FontSize="13.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Các giao dịch tích điểm và đổi điểm tại quầy sẽ được lưu tại đây" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
