<UserControl x:Class="POS.WinUI.Views.Customers.Components.CustomerTableComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ 1. THANH TÌM KIẾM & BỘ LỌC ════════════════════ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <!-- Nút Xóa lọc bên phải -->
                <Button DockPanel.Dock="Right" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource OutlineButtonStyle}" Height="40" Padding="14,0" Cursor="Hand" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa bộ lọc" FontSize="12.5"/>
                    </StackPanel>
                </Button>

                <!-- Dropdown lọc theo Hạng thành viên -->
                <ComboBox DockPanel.Dock="Right" 
                          ItemsSource="{Binding TiersFilterList}" 
                          SelectedItem="{Binding SelectedTierFilter}"
                          DisplayMemberPath="Name"
                          Width="180" Height="40" Margin="10,0,0,0" Cursor="Hand"/>

                <!-- Ô tìm kiếm theo Tên hoặc Số điện thoại -->
                <shared:TextInputField Height="40" Icon="Search24" 
                                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                      PlaceholderText="Tìm nhanh theo họ tên, số điện thoại hoặc mã vạch..."/>
            </DockPanel>
        </Border>

        <!-- ════════════════════ 2. BẢNG DỮ LIỆU KHÁCH HÀNG ════════════════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding Customers}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="48">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Mã / Barcode -->
                            <DataGridTemplateColumn Header="MÃ KH" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Barcode, TargetNullValue='—'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Họ và tên -->
                            <DataGridTemplateColumn Header="HỌ VÀ TÊN" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#EFF6FF" Margin="0,0,10,0">
                                                <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Số điện thoại -->
                            <DataGridTemplateColumn Header="SỐ ĐIỆN THOẠI" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Phone}" FontSize="12.5" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hạng thẻ -->
                            <DataGridTemplateColumn Header="HẠNG THÀNH VIÊN" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <shared:MemberTierBadge TierName="{Binding MemberTierName}" Margin="14,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Điểm tích lũy -->
                            <DataGridTemplateColumn Header="ĐIỂM TÍCH LŨY" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PointsBalance, StringFormat='{}{0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tổng chi tiêu -->
                            <DataGridTemplateColumn Header="TỔNG CHI TIÊU" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalSpending, StringFormat='{}{0:N0} đ'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="14,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Hoạt động"/>
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Tạm dừng"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác hành động -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                            <!-- Chỉnh sửa -->
                                            <Button Command="{Binding DataContext.OpenEditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Chỉnh sửa thông tin khách hàng"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="15" Foreground="#2563EB"/>
                                            </Button>

                                            <!-- Điều chỉnh điểm thưởng -->
                                            <Button Command="{Binding DataContext.OpenAdjustPointsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Cộng hoặc trừ điểm thưởng thủ công"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="RibbonStar24" FontSize="15" Foreground="#EA580C"/>
                                            </Button>

                                            <!-- Xem lịch sử điểm -->
                                            <Button Command="{Binding DataContext.ViewCustomerHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Tra cứu biến động điểm"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="History24" FontSize="15" Foreground="#64748B"/>
                                            </Button>

                                            <!-- Ngừng hoạt động / Xóa -->
                                            <Button Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Tạm ngừng hoạt động"
                                                    Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>

                <!-- Loading State -->
                <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True" 
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Width="64" Height="64" CornerRadius="20" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="People24" FontSize="28" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chưa có khách hàng nào phù hợp" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thử tìm kiếm với số điện thoại hoặc tiêu chí khác" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ 3. THANH ĐIỀU HƯỚNG PHÂN TRANG ════════════════════ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12.5" Foreground="#64748B">
                    <Run Text="Trang "/><Run Text="{Binding PageNumber}" FontWeight="Bold" Foreground="#0F172A"/><Run Text=" / "/><Run Text="{Binding TotalPages}"/><Run Text=" (Tổng cộng "/><Run Text="{Binding TotalCustomersCount}" FontWeight="Bold" Foreground="#0F172A"/><Run Text=" khách hàng)"/>
                </TextBlock>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="12,0" Margin="0,0,8,0" Cursor="Hand" Content="&lt; Trước"/>
                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource OutlineButtonStyle}" Height="34" Padding="12,0" Cursor="Hand" Content="Sau &gt;"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
