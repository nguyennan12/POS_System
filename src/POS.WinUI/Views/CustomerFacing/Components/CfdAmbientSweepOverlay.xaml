<UserControl x:Class="POS.WinUI.Views.CustomerFacing.Components.CfdAmbientSweepOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             IsHitTestVisible="False">

    <Canvas IsHitTestVisible="False" 
            ClipToBounds="True">
        <Rectangle Width="260" Height="1400"
                   Canvas.Left="0" Canvas.Top="-150"
                   IsHitTestVisible="False"
                   Opacity="0.55">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="20" CenterX="130" CenterY="700"/>
                    <TranslateTransform x:Name="SweepTranslate" X="-600" Y="0"/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#26FFFFFF" Offset="0.35"/>
                    <GradientStop Color="#80FFFFFF" Offset="0.50"/>
                    <GradientStop Color="#26FFFFFF" Offset="0.65"/>
                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <!-- Chu kỳ tổng cộng 11 giây: lướt êm ái trong 1.8s từ trái sang phải, lập tức biến mất và nghỉ ~8.7s -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepTranslate"
                                                           Storyboard.TargetProperty="X">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="-600"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="-600"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:2.3" Value="2400">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.35" Value="-600"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:11.0" Value="-600"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>
    </Canvas>
</UserControl>
