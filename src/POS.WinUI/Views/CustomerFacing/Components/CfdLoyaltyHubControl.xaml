<UserControl x:Class="POS.WinUI.Views.CustomerFacing.Components.CfdLoyaltyHubControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.CustomerFacing"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:CfdStandbyViewModel}">

    <!-- Content Container -->
    <Border Padding="16,20,24,20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Brand Bar & Clock -->
                <RowDefinition Height="Auto"/>
                <!-- Main Centered Orange QR Panel & Loyalty Badges -->
                <RowDefinition Height="*"/>
                <!-- Bottom Wi-Fi & Hotline -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Brand & Clock (Evenly Balanced Header Bar) -->
            <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
                <!-- Brand & Store with Image Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="11" Background="White" BorderBrush="#FED7AA" BorderThickness="1" Margin="0,0,10,0" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.12" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Resources/Assets/logo.png" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OraPOS" FontSize="16.5" FontWeight="Black" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" Color="#4D0F172A" Opacity="0.4" ShadowDepth="1" Direction="270"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding StoreBranchName}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFE4D6" TextTrimming="CharacterEllipsis" MaxWidth="190" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Glass Capsule (No clock counter) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Background="#4D0F172A" BorderBrush="#4DFFFFFF" BorderThickness="1" 
                        CornerRadius="12" Padding="12,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#34D399" Opacity="0.9" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding WelcomeStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#ECFDF5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Centered Section: Large QR Hub & Relevant Perk Badges -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Welcome Pill -->
                <Border HorizontalAlignment="Center" 
                        Background="#33FFFFFF" 
                        BorderBrush="#66FFFFFF" 
                        BorderThickness="1.5" 
                        CornerRadius="22" 
                        Padding="16,5" 
                        Margin="0,0,0,10">
                    <TextBlock Text="✨ KÍNH CHÀO QUÝ KHÁCH" FontSize="11.5" FontWeight="Black" Foreground="White"/>
                </Border>

                <!-- Headline -->
                <TextBlock Text="Thanh Toán &amp; Tích Điểm" 
                           FontSize="24" 
                           FontWeight="Black" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" Color="#4D000000" Opacity="0.45" ShadowDepth="2" Direction="270"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Subtitle -->
                <TextBlock Text="Quét mã nhận ngay đặc quyền VIP OraClub" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="#FFFFFFFF" 
                           Opacity="0.95"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,4,0,16">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" Color="#33000000" Opacity="0.3" ShadowDepth="1" Direction="270"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Prominent Large QR Code White Box with 4 Orange Scanner Corner Accents -->
                <Border Background="White" 
                        CornerRadius="24" 
                        Padding="14" 
                        Margin="0,0,0,16" 
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" Color="#000000" Opacity="0.25" ShadowDepth="8" Direction="270"/>
                    </Border.Effect>

                    <Grid Width="200" Height="200">
                        <!-- 4 Orange Scanner Corner Brackets -->
                        <!-- Top-Left Corner -->
                        <Border Width="28" Height="28" 
                                BorderBrush="#EA580C" BorderThickness="3.5,3.5,0,0" 
                                CornerRadius="10,0,0,0" 
                                HorizontalAlignment="Left" VerticalAlignment="Top" 
                                Margin="-2,-2,0,0"/>

                        <!-- Top-Right Corner -->
                        <Border Width="28" Height="28" 
                                BorderBrush="#EA580C" BorderThickness="0,3.5,3.5,0" 
                                CornerRadius="0,10,0,0" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Margin="0,-2,-2,0"/>

                        <!-- Bottom-Left Corner -->
                        <Border Width="28" Height="28" 
                                BorderBrush="#EA580C" BorderThickness="3.5,0,0,3.5" 
                                CornerRadius="0,0,0,10" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                                Margin="-2,0,0,-2"/>

                        <!-- Bottom-Right Corner -->
                        <Border Width="28" Height="28" 
                                BorderBrush="#EA580C" BorderThickness="0,0,3.5,3.5" 
                                CornerRadius="0,0,10,0" 
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                Margin="0,0,-2,-2"/>

                        <!-- Official Membership QR Code Image -->
                        <Image Source="pack://application:,,,/Resources/Assets/qr_membership.png" 
                               Width="184" 
                               Height="184" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- Caption Below QR -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="👑" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Quét mã OraClub" FontSize="15.5" FontWeight="Black" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" Color="#4D000000" Opacity="0.35" ShadowDepth="1" Direction="270"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Tặng voucher 50.000đ cho thành viên mới" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#FEF08A" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Color="#4D000000" Opacity="0.35" ShadowDepth="1" Direction="270"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- 3 Relevant Member Benefit Badges in Sleek Glass Capsules -->
                <Grid Width="375" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Tích điểm 5% -->
                    <Border Grid.Column="0" Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="8,7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="12" Foreground="#FDE047" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tích điểm 5%" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Voucher 50K -->
                    <Border Grid.Column="2" Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="8,7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎁" FontSize="12" Foreground="#FDE047" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voucher 50K" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Đặc quyền VIP -->
                    <Border Grid.Column="4" Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="20" Padding="8,7">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👑" FontSize="12" Foreground="#34D399" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Đặc quyền VIP" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>

            <!-- 3. Bottom Wi-Fi & Hotline (Glass Capsule) -->
            <Border Grid.Row="2" Background="#4D0F172A" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="11" Foreground="#FDBA74" Margin="0,0,4,0"/>
                        <TextBlock Text="Wi-Fi: " FontSize="9.5" Foreground="#FFEDD5"/>
                        <TextBlock Text="{Binding WifiInfo}" FontSize="9.5" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="Hotline: 1900 8888" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
