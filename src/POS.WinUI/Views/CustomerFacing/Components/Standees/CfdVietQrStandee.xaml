<UserControl x:Class="POS.WinUI.Views.CustomerFacing.Components.Standees.CfdVietQrStandee"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.CustomerFacing"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:CfdLiveCartViewModel}">
    <!-- ════════════════════ METHOD 1: VIETQR (BANK TRANSFER 24/7) ════════════════════ -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding ShowSingleVietQr, Converter={StaticResource BoolToVis}}">
        
        <!-- Method Pill -->
        <Border HorizontalAlignment="Center" 
                Background="#33FFFFFF" 
                BorderBrush="#66FFFFFF" 
                BorderThickness="1.5" 
                CornerRadius="22" 
                Padding="18,6" 
                Margin="0,0,0,8">
            <TextBlock Text="THANH TOÁN VIETQR 24/7" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Standee VietQR Napas 247 Chính Hãng -->
        <Border Width="340"
                BorderBrush="#FED7AA"
                BorderThickness="1.5"
                CornerRadius="20"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Padding="14,12"
                ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="/Resources/Assets/vietqr_standee_bg.png" Stretch="UniformToFill"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <!-- Header: VIETQR & NAPAS 247 Logos trong Badge Trắng bo góc -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Image Source="/Resources/Assets/vietqr_header.png"
                           Height="28"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Scanner Frame with Blue Corner Brackets & Dynamic QR -->
                <Border Width="200"
                        Height="200"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <!-- 4 Blue Corner Brackets -->
                        <Border Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                BorderBrush="#2563EB" BorderThickness="3.5,3.5,0,0" CornerRadius="5,0,0,0"/>
                        <Border Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                BorderBrush="#2563EB" BorderThickness="0,3.5,3.5,0" CornerRadius="0,5,0,0"/>
                        <Border Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"
                                BorderBrush="#2563EB" BorderThickness="3.5,0,0,3.5" CornerRadius="0,0,0,5"/>
                        <Border Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                BorderBrush="#2563EB" BorderThickness="0,0,3.5,3.5" CornerRadius="0,0,5,0"/>

                        <!-- QR Code Bitmap động -->
                        <Image Source="{Binding PaymentQrImage}" 
                               RenderOptions.BitmapScalingMode="NearestNeighbor" 
                               Stretch="Uniform" 
                               Margin="9"/>

                        <!-- Fallback nếu đang khởi tạo QR -->
                        <Border Background="#F8FAFC" CornerRadius="10" Margin="8"
                                Visibility="{Binding PaymentQrImage, Converter={StaticResource InverseNullOrEmptyToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="44" Foreground="#64748B"/>
                                <TextBlock Text="Đang tạo mã VietQR..." FontSize="11.5" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer: Bank Logos trong Badge Trắng -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="12,4" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Image Source="/Resources/Assets/vietqr_banks_footer.png"
                           Height="20"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 👑 VIP POINTS DEDUCTION BADGE (Dưới ảnh QR VietQR) -->
        <Border Width="340"
                Background="#FFFFFF" 
                BorderBrush="#FDE68A" 
                BorderThickness="1.5" 
                CornerRadius="14" 
                Padding="14,8" 
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👑" FontSize="12.5" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding PointsUsed, StringFormat='Đã trừ {0:#,##0.##} điểm OraClub'}" FontSize="12" FontWeight="Black" Foreground="#92400E"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PointsBalanceRemaining, StringFormat='Điểm còn lại: {0:#,##0.##} điểm'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309" Margin="18,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="15" FontWeight="Black" Foreground="#EA580C" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bank Transfer Details Card (White Card) -->
        <Border Width="340"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="14,10"
                Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Chủ tài khoản & Số tài khoản -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Chủ tài khoản" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding PaymentAccountName, FallbackValue='TNHH OraPos', TargetNullValue='TNHH OraPos'}" FontWeight="Black" FontSize="13" Foreground="#0F172A" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Số tài khoản" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding PaymentAccountNumber}" FontWeight="Black" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Nội dung CK & Số tiền chuyển -->
                <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nội dung chuyển khoản" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding PaymentTransferContent}" FontWeight="Black" FontSize="13" Foreground="#005BAA" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Số tiền cần chuyển" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding PaymentGrandTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Black" FontSize="15" Foreground="#16A34A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Pulsing Live Webhook Status -->
        <Border Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,5" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="{Binding PaymentStatusText}" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
