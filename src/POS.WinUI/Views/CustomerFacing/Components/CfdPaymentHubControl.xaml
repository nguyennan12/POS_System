<UserControl x:Class="POS.WinUI.Views.CustomerFacing.Components.CfdPaymentHubControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.CustomerFacing"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:CfdLiveCartViewModel}">

    <!-- Content Container -->
    <Border Padding="16,20,24,20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Brand Bar & Payment Mode Badge -->
                <RowDefinition Height="Auto"/>
                <!-- Main Centered Section: Payment Method Hub OR Payment Success View -->
                <RowDefinition Height="*"/>
                <!-- Bottom Wi-Fi & Hotline -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Brand & Payment Mode Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
                <!-- Brand & Store with Image Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="11" Background="White" BorderBrush="#FED7AA" BorderThickness="1" Margin="0,0,10,0" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.12" ShadowDepth="2" Direction="270"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Resources/Assets/logo.png" 
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OraPOS" FontSize="16.5" FontWeight="Black" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" Color="#4D0F172A" Opacity="0.4" ShadowDepth="1" Direction="270"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding StoreBranchName}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFE4D6" TextTrimming="CharacterEllipsis" MaxWidth="190" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Glass Capsule (Đang thanh toán / Hoàn tất) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Background="#4D0F172A" BorderBrush="#4DFFFFFF" BorderThickness="1" 
                        CornerRadius="12" Padding="12,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#34D399" Opacity="0.9" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding PaymentStatusText}" FontSize="11.5" FontWeight="Bold" Foreground="#ECFDF5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Centered Section: Payment Success Screen OR Active Payment Methods -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- ════════════════════ VIEW A: PAYMENT COMPLETED SUCCESS SCREEN (IsPaymentCompleted == TRUE) ════════════════════ -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsPaymentCompleted, Converter={StaticResource BoolToVis}}">
                    
                    <!-- Success Pill -->
                    <Border HorizontalAlignment="Center" 
                            Background="#16A34A" 
                            BorderBrush="#86EFAC" 
                            BorderThickness="1.5" 
                            CornerRadius="22" 
                            Padding="18,6" 
                            Margin="0,0,0,12">
                        <TextBlock Text="GIAO DỊCH HOÀN TẤT" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Success Receipt Box (White Card) -->
                    <Border Width="360"
                            Background="#FFFFFF"
                            BorderBrush="#86EFAC"
                            BorderThickness="2"
                            CornerRadius="22"
                            Padding="22,18"
                            Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" Color="#16A34A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
                        </Border.Effect>

                        <StackPanel HorizontalAlignment="Center">
                            <!-- Glowing Checkmark Icon -->
                            <Border Width="58" Height="58" 
                                    Background="#DCFCE7" 
                                    BorderBrush="#86EFAC" 
                                    BorderThickness="2" 
                                    CornerRadius="29" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="30" Foreground="#16A34A"/>
                            </Border>

                            <!-- Success Headline -->
                            <TextBlock Text="THANH TOÁN THÀNH CÔNG!" FontSize="16" FontWeight="Black" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding PaymentSuccessTime, StringFormat='Thời gian: {0}'}" FontSize="11" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                            <!-- Paid Amount Banner -->
                            <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="ĐÃ THANH TOÁN" FontSize="10" FontWeight="Black" Foreground="#166534"/>
                                        <TextBlock Text="{Binding PaymentMethodBadgeTitle}" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PaymentGrandTotal, StringFormat='{}{0:N0} đ'}" FontSize="24" FontWeight="Black" Foreground="#16A34A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Breakdown Rows -->
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Mã đơn hàng -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Mã tham chiếu / Đơn:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PaymentOrderCode, TargetNullValue='HD_POS'}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Row 1: Tiền thối lại (if Cash & ChangeAmount > 0) -->
                                <Grid Grid.Row="1" Margin="0,0,0,6" Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Tiền thối lại cho khách:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PaymentChangeAmount, StringFormat='{}{0:N0} đ'}" FontSize="12.5" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Row 2: Điểm đã dùng (if any) -->
                                <Grid Grid.Row="2" Margin="0,0,0,6" Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Khấu trừ điểm OraClub:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="12" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Row 3: Điểm tích lũy cộng đơn này (if member & PointsEarned > 0) -->
                                <Grid Grid.Row="3" Margin="0,0,0,0" Visibility="{Binding HasCustomerInfo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Điểm tích lũy đơn này:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding PointsEarned, StringFormat='+{0:#,##0.##} điểm'}" FontSize="12" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <!-- Receipt Saved Note -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                <TextBlock Text="✨ Hóa đơn đã được lưu và gửi đến hệ thống" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Warm Greeting Capsule -->
                    <Border Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,7" HorizontalAlignment="Center">
                        <TextBlock Text="OraPOS xin chân thành cảm ơn Quý khách!" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- ════════════════════ VIEW B: ACTIVE PAYMENT METHODS (IsPaymentCompleted == FALSE) ════════════════════ -->
                <Grid Visibility="{Binding IsPaymentCompleted, Converter={StaticResource InverseBoolToVis}}">

                    <!-- ════════════════════ METHOD 1: VIETQR (BANK TRANSFER 24/7) ════════════════════ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowSingleVietQr, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Method Pill -->
                        <Border HorizontalAlignment="Center" 
                                Background="#33FFFFFF" 
                                BorderBrush="#66FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="22" 
                                Padding="18,6" 
                                Margin="0,0,0,8">
                            <TextBlock Text="THANH TOÁN VIETQR 24/7" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Standee VietQR Napas 247 Chính Hãng -->
                        <Border Width="340"
                                BorderBrush="#FED7AA"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"
                                Padding="14,12"
                                ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="/Resources/Assets/vietqr_standee_bg.png" Stretch="UniformToFill"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
                            </Border.Effect>

                            <StackPanel HorizontalAlignment="Center">
                                <!-- Header: VIETQR & NAPAS 247 Logos trong Badge Trắng bo góc -->
                                <Border Background="#FFFFFF" CornerRadius="10" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Image Source="/Resources/Assets/vietqr_header.png"
                                           Height="28"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Scanner Frame with Blue Corner Brackets & Dynamic QR -->
                                <Border Width="200"
                                        Height="200"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <!-- 4 Blue Corner Brackets -->
                                        <Border Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                                BorderBrush="#2563EB" BorderThickness="3.5,3.5,0,0" CornerRadius="5,0,0,0"/>
                                        <Border Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                                BorderBrush="#2563EB" BorderThickness="0,3.5,3.5,0" CornerRadius="0,5,0,0"/>
                                        <Border Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"
                                                BorderBrush="#2563EB" BorderThickness="3.5,0,0,3.5" CornerRadius="0,0,0,5"/>
                                        <Border Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                                BorderBrush="#2563EB" BorderThickness="0,0,3.5,3.5" CornerRadius="0,0,5,0"/>

                                        <!-- QR Code Bitmap động -->
                                        <Image Source="{Binding PaymentQrImage}" 
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" 
                                               Stretch="Uniform" 
                                               Margin="9"/>

                                        <!-- Fallback nếu đang khởi tạo QR -->
                                        <Border Background="#F8FAFC" CornerRadius="10" Margin="8"
                                                Visibility="{Binding PaymentQrImage, Converter={StaticResource InverseNullOrEmptyToVis}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="QrCode24" FontSize="44" Foreground="#64748B"/>
                                                <TextBlock Text="Đang tạo mã VietQR..." FontSize="11.5" Foreground="#64748B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Footer: Bank Logos trong Badge Trắng -->
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="12,4" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Image Source="/Resources/Assets/vietqr_banks_footer.png"
                                           Height="20"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 👑 VIP POINTS DEDUCTION BADGE (Dưới ảnh QR VietQR) -->
                        <Border Width="340"
                                Background="#FFFFFF" 
                                BorderBrush="#FDE68A" 
                                BorderThickness="1.5" 
                                CornerRadius="14" 
                                Padding="14,8" 
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👑" FontSize="12.5" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PointsUsed, StringFormat='Đã trừ {0:#,##0.##} điểm OraClub'}" FontSize="12" FontWeight="Black" Foreground="#92400E"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PointsBalanceRemaining, StringFormat='Điểm còn lại: {0:#,##0.##} điểm'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309" Margin="18,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="15" FontWeight="Black" Foreground="#EA580C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Bank Transfer Details Card (White Card) -->
                        <Border Width="340"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Chủ tài khoản & Số tài khoản -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chủ tài khoản" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding PaymentAccountName, FallbackValue='TNHH OraPos', TargetNullValue='TNHH OraPos'}" FontWeight="Black" FontSize="13" Foreground="#0F172A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Số tài khoản" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PaymentAccountNumber}" FontWeight="Black" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Nội dung CK & Số tiền chuyển -->
                                <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Nội dung chuyển khoản" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                            <TextBlock Text="{Binding PaymentTransferContent}" FontWeight="Black" FontSize="13" Foreground="#005BAA" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Số tiền cần chuyển" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PaymentGrandTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Black" FontSize="15" Foreground="#16A34A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pulsing Live Webhook Status -->
                        <Border Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,5" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{Binding PaymentStatusText}" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════ METHOD 2: MOMO (E-WALLET) ════════════════════ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowSingleMoMo, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Method Pill -->
                        <Border HorizontalAlignment="Center" 
                                Background="#33FFFFFF" 
                                BorderBrush="#66FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="22" 
                                Padding="18,6" 
                                Margin="0,0,0,8">
                            <TextBlock Text="THANH TOÁN VÍ MOMO" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Standee MoMo Chính Hãng -->
                        <Grid Width="340" Height="280" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Border CornerRadius="20" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
                                </Border.Effect>
                                <Image Source="/Resources/Assets/momo_standee_bg.png" 
                                       Stretch="Uniform" 
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Scanner Frame MoMo Pink -->
                            <Border Width="150" 
                                    Height="150" 
                                    Background="#FFFFFF"
                                    BorderBrush="#FCE7F3"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Top" 
                                    Margin="0,80,0,0">
                                <Grid>
                                    <!-- 4 Corner Brackets Pink (#A50064) -->
                                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                            BorderBrush="#A50064" BorderThickness="3,3,0,0" CornerRadius="4,0,0,0"/>
                                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                            BorderBrush="#A50064" BorderThickness="0,3,3,0" CornerRadius="0,4,0,0"/>
                                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                            BorderBrush="#A50064" BorderThickness="3,0,0,3" CornerRadius="0,0,0,4"/>
                                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                            BorderBrush="#A50064" BorderThickness="0,0,3,3" CornerRadius="0,0,4,0"/>

                                    <!-- QR Code Bitmap động -->
                                    <Image Source="{Binding PaymentQrImage}" 
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" 
                                           Stretch="Uniform"
                                           Margin="7"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 👑 VIP POINTS DEDUCTION BADGE (Dưới ảnh QR MoMo) -->
                        <Border Width="340"
                                Background="#FFFFFF" 
                                BorderBrush="#FDE68A" 
                                BorderThickness="1.5" 
                                CornerRadius="14" 
                                Padding="14,8" 
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👑" FontSize="12.5" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PointsUsed, StringFormat='Đã trừ {0:#,##0.##} điểm OraClub'}" FontSize="12" FontWeight="Black" Foreground="#92400E"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PointsBalanceRemaining, StringFormat='Điểm còn lại: {0:#,##0.##} điểm'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309" Margin="18,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="15" FontWeight="Black" Foreground="#EA580C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- MoMo Details Card (White Card) -->
                        <Border Width="340"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cổng thanh toán" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="Ví MoMo Merchant" FontWeight="Black" FontSize="12.5" Foreground="#A50064" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Số điện thoại ví" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PaymentAccountNumber}" FontWeight="Black" FontSize="12.5" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#FDF2F8" CornerRadius="8" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mã đơn hàng" FontSize="10" FontWeight="Bold" Foreground="#BE185D"/>
                                            <TextBlock Text="{Binding PaymentTransferContent}" FontWeight="Black" FontSize="13" Foreground="#A50064" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Số tiền thanh toán" FontSize="10" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PaymentGrandTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Black" FontSize="15" Foreground="#16A34A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pulsing Live Webhook Status -->
                        <Border Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,5" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#F472B6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{Binding PaymentStatusText}" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════ METHOD 3: CASH (TIỀN MẶT & TIỀN THỐI) ════════════════════ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowSingleCash, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Method Pill -->
                        <Border HorizontalAlignment="Center" 
                                Background="#33FFFFFF" 
                                BorderBrush="#66FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="22" 
                                Padding="18,6" 
                                Margin="0,0,0,12">
                            <TextBlock Text="THANH TOÁN TIỀN MẶT TẠI QUẦY" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- 1. Card: Tiền Khách Đưa -->
                        <Border Width="360"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="18"
                                Padding="20,13"
                                Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Color="#0F172A" Opacity="0.12" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="TIỀN KHÁCH ĐƯA" FontSize="11" FontWeight="Black" Foreground="#64748B"/>
                                    <TextBlock Text="Tiền mặt thu ngân đã nhận" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding PaymentTenderedCash, StringFormat='{}{0:N0} đ'}" 
                                           FontSize="24" 
                                           FontWeight="Black" 
                                           Foreground="#2563EB" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 👑 VIP POINTS DEDUCTION BADGE (Dưới Tiền Khách Đưa) -->
                        <Border Width="360"
                                Background="#FFFFFF" 
                                BorderBrush="#FDE68A" 
                                BorderThickness="1.5" 
                                CornerRadius="16" 
                                Padding="16,10" 
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👑" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PointsUsed, StringFormat='Đã trừ {0:#,##0.##} điểm OraClub'}" FontSize="12.5" FontWeight="Black" Foreground="#92400E"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PointsBalanceRemaining, StringFormat='Điểm còn lại: {0:#,##0.##} điểm'}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" Margin="19,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="16" FontWeight="Black" Foreground="#EA580C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 2. Giant Highlight Card: TIỀN THỐI LẠI (TIỀN THỪA) -->
                        <Border Width="360"
                                Background="#F0FDF4"
                                BorderBrush="#86EFAC"
                                BorderThickness="2"
                                CornerRadius="20"
                                Padding="20,16"
                                Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Color="#16A34A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#DCFCE7" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="✨ TIỀN THỐI LẠI CHO QUÝ KHÁCH" FontSize="11" FontWeight="Black" Foreground="#15803D"/>
                                </Border>
                                <TextBlock Text="{Binding PaymentChangeAmount, StringFormat='{}{0:N0} đ'}" 
                                           FontSize="34" 
                                           FontWeight="Black" 
                                           Foreground="#16A34A" 
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,4"/>
                                <TextBlock Text="Quý khách vui lòng kiểm tra tiền trước khi rời quầy" FontSize="11" FontWeight="SemiBold" Foreground="#166534" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Store Thank You Capsule -->
                        <Border Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,7" HorizontalAlignment="Center">
                            <TextBlock Text="Cảm ơn Quý khách đã mua sắm tại OraPOS!" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════ METHOD 4: CARD (THẺ NGÂN HÀNG / POS - SẮP RA MẮT) ════════════════════ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowSingleCard, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Method Pill -->
                        <Border HorizontalAlignment="Center" 
                                Background="#33FFFFFF" 
                                BorderBrush="#66FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="22" 
                                Padding="18,6" 
                                Margin="0,0,0,12">
                            <TextBlock Text="THANH TOÁN THẺ NGÂN HÀNG / POS" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Coming Soon Card (White Card) -->
                        <Border Width="360"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="22"
                                Padding="22,20"
                                Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.18" ShadowDepth="6" Direction="270"/>
                            </Border.Effect>

                            <StackPanel HorizontalAlignment="Center">
                                <!-- Icon & Sparkle -->
                                <Border Width="56" Height="56" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1.5" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="28" Foreground="#2563EB"/>
                                </Border>

                                <!-- Badge Sắp Ra Mắt -->
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,3.5" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="✨ TÍNH NĂNG SẮP RA MẮT" FontSize="11" FontWeight="Black" Foreground="#B45309"/>
                                </Border>

                                <TextBlock Text="Kết nối thiết bị POS tự động" FontSize="15" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Cổng thanh toán thẻ đang được nâng cấp tích hợp trực tiếp" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,14"/>

                                <!-- Supported Card Logos -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Hỗ trợ sắp có trên toàn hệ thống:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <Grid Width="260" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="/Resources/Assets/ic_visa.png" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Image Grid.Column="1" Source="/Resources/Assets/ic_mastercard.png" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Image Grid.Column="2" Source="/Resources/Assets/ic_applepay.png" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Image Grid.Column="3" Source="/Resources/Assets/ic_paypal.png" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Grand Total -->
                                <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tổng tiền đơn hàng" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PaymentGrandTotal, StringFormat='{}{0:N0} đ'}" FontSize="16" FontWeight="Black" Foreground="#16A34A" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Suggestion Pill -->
                        <Border Background="#2EFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,7" HorizontalAlignment="Center">
                            <TextBlock Text="Quý khách vui lòng chọn VietQR, Ví MoMo hoặc Tiền mặt" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════ METHOD 5: POINTS / ĐIỂM THƯỞNG ════════════════════ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsPoints, Converter={StaticResource BoolToVis}}">
                        
                        <Border HorizontalAlignment="Center" 
                                Background="#33FFFFFF" 
                                BorderBrush="#66FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="22" 
                                Padding="18,6" 
                                Margin="0,0,0,14">
                            <TextBlock Text="THANH TOÁN BẰNG ĐIỂM ORACLUB" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <Border Width="360"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="22"
                                Padding="22,20"
                                Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.2" ShadowDepth="6" Direction="270"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Khấu trừ điểm tích lũy thành công" FontSize="15" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding PaymentGrandTotal, StringFormat='Số tiền còn lại: {0:N0} đ'}" FontSize="18" FontWeight="Black" Foreground="#EA580C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════ METHOD 6: SPLIT PAYMENT (THANH TOÁN KẾT HỢP) ════════════════════ -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowSplitPayment, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Split Mode Top Pill -->
                        <Border HorizontalAlignment="Center" 
                                Background="#33FFFFFF" 
                                BorderBrush="#66FFFFFF" 
                                BorderThickness="1.5" 
                                CornerRadius="22" 
                                Padding="18,6" 
                                Margin="0,0,0,8">
                            <TextBlock Text="THANH TOÁN KẾT HỢP" FontSize="11" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Split Payment Breakdown List (Pills showing each allocated method) -->
                        <Border Width="340" Background="#26FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding SplitItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BadgeBg, TargetNullValue='#FFFFFF'}" CornerRadius="8" Padding="8,4" Margin="3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeFg, TargetNullValue='#1E293B'}"/>
                                                <TextBlock Text=": " FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeFg, TargetNullValue='#1E293B'}"/>
                                                <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} đ'}" FontSize="11.5" FontWeight="Black" Foreground="{Binding BadgeFg, TargetNullValue='#1E293B'}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- A1. If VietQR is in Split -> Display VietQR Standee + Separate Bank Details Card -->
                        <StackPanel Visibility="{Binding IsSplitVietQr, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                            <!-- Standee VietQR Napas 247 Chính Hãng -->
                            <Border Width="340"
                                    BorderBrush="#FED7AA"
                                    BorderThickness="1.5"
                                    CornerRadius="18"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/Assets/vietqr_standee_bg.png" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26" Color="#0F172A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
                                </Border.Effect>

                                <StackPanel HorizontalAlignment="Center">
                                    <!-- QR Header Logo -->
                                    <Border Background="#FFFFFF" CornerRadius="8" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Image Source="/Resources/Assets/vietqr_header.png"
                                               Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Scanner Frame with Dynamic QR -->
                                    <Border Width="170"
                                            Height="170"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                    BorderBrush="#2563EB" BorderThickness="3,3,0,0" CornerRadius="4,0,0,0"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    BorderBrush="#2563EB" BorderThickness="0,3,3,0" CornerRadius="0,4,0,0"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                                    BorderBrush="#2563EB" BorderThickness="3,0,0,3" CornerRadius="0,0,0,4"/>
                                            <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                                    BorderBrush="#2563EB" BorderThickness="0,0,3,3" CornerRadius="0,0,4,0"/>

                                            <Image Source="{Binding PaymentQrImage}" 
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" 
                                                   Stretch="Uniform" 
                                                   Margin="7"/>
                                        </Grid>
                                    </Border>

                                    <!-- Footer: Bank Logos trong Badge Trắng -->
                                    <Border Background="#FFFFFF" CornerRadius="6" Padding="10,3" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Image Source="/Resources/Assets/vietqr_banks_footer.png"
                                               Height="16"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Bank Transfer Details Card (Dedicated White Box Below QR) -->
                            <Border Width="340"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="14"
                                    Padding="12,9"
                                    Margin="0,0,0,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Chủ tài khoản & Số tài khoản -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chủ tài khoản" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding PaymentAccountName, FallbackValue='TNHH OraPos', TargetNullValue='TNHH OraPos'}" FontWeight="Black" FontSize="12" Foreground="#0F172A" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Số tài khoản" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PaymentAccountNumber}" FontWeight="Black" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Nội dung CK & Số tiền chuyển -->
                                    <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="8" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nội dung chuyển khoản" FontSize="9" FontWeight="Bold" Foreground="#1E40AF"/>
                                                <TextBlock Text="{Binding PaymentTransferContent}" FontWeight="Black" FontSize="12" Foreground="#005BAA" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Số tiền cần chuyển" FontSize="9" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding SplitQrAmount, StringFormat='{}{0:N0} đ'}" FontWeight="Black" FontSize="14" Foreground="#16A34A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- A2. If MoMo is in Split -> Display MoMo Standee + Separate MoMo Details Card -->
                        <StackPanel Visibility="{Binding IsSplitMoMo, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                            <!-- Standee MoMo Chính Hãng -->
                            <Grid Width="340" Height="240" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Border CornerRadius="18" ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="26" Color="#0F172A" Opacity="0.25" ShadowDepth="6" Direction="270"/>
                                    </Border.Effect>
                                    <Image Source="/Resources/Assets/momo_standee_bg.png" 
                                           Stretch="Uniform" 
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Scanner Frame MoMo Pink -->
                                <Border Width="135" 
                                        Height="135" 
                                        Background="#FFFFFF"
                                        BorderBrush="#FCE7F3"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Top" 
                                        Margin="0,68,0,0">
                                    <Grid>
                                        <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                BorderBrush="#A50064" BorderThickness="3,3,0,0" CornerRadius="4,0,0,0"/>
                                        <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                BorderBrush="#A50064" BorderThickness="0,3,3,0" CornerRadius="0,4,0,0"/>
                                        <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                                BorderBrush="#A50064" BorderThickness="3,0,0,3" CornerRadius="0,0,0,4"/>
                                        <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                                BorderBrush="#A50064" BorderThickness="0,0,3,3" CornerRadius="0,0,4,0"/>

                                        <Image Source="{Binding PaymentQrImage}" 
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" 
                                               Stretch="Uniform" 
                                               Margin="6"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- MoMo Details Card (Dedicated White Box Below QR) -->
                            <Border Width="340"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="14"
                                    Padding="12,9"
                                    Margin="0,0,0,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#0F172A" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Cổng thanh toán & SĐT Ví -->
                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cổng thanh toán" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="Ví MoMo Merchant" FontWeight="Black" FontSize="11.5" Foreground="#A50064" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Số điện thoại ví" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PaymentAccountNumber}" FontWeight="Black" FontSize="11.5" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Mã đơn hàng & Số tiền thanh toán -->
                                    <Border Grid.Row="1" Background="#FDF2F8" CornerRadius="8" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Mã đơn hàng" FontSize="9" FontWeight="Bold" Foreground="#BE185D"/>
                                                <TextBlock Text="{Binding PaymentTransferContent}" FontWeight="Black" FontSize="12" Foreground="#A50064" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Số tiền thanh toán" FontSize="9" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding SplitQrAmount, StringFormat='{}{0:N0} đ'}" FontWeight="Black" FontSize="14" Foreground="#16A34A" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- B. If Cash is in Split -> Display Compact Cash Summary Card -->
                        <Border Width="340"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasSplitCash, Converter={StaticResource BoolToVis}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" Color="#0F172A" Opacity="0.12" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💵" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="TIỀN MẶT CẦN TRẢ" FontSize="10.5" FontWeight="Black" Foreground="#15803D"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Khách đưa: " FontSize="10.5" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding PaymentTenderedCash, StringFormat='{}{0:N0} đ'}" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Tiền thối lại:" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding PaymentChangeAmount, StringFormat='{}{0:N0} đ'}" FontSize="16" FontWeight="Black" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 👑 Points deduction badge in split mode (if points were used) -->
                        <Border Width="340"
                                Background="#FFFFFF" 
                                BorderBrush="#FDE68A" 
                                BorderThickness="1.5" 
                                CornerRadius="12" 
                                Padding="12,6" 
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👑" FontSize="11.5" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding PointsUsed, StringFormat='Đã trừ {0:#,##0.##} điểm OraClub'}" FontSize="11" FontWeight="Black" Foreground="#92400E"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="13" FontWeight="Black" Foreground="#EA580C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                </Grid>

            </Grid>

            <!-- 3. Bottom Wi-Fi & Hotline (Glass Capsule) -->
            <Border Grid.Row="2" Background="#4D0F172A" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="11" Foreground="#FDBA74" Margin="0,0,4,0"/>
                        <TextBlock Text="Wi-Fi: " FontSize="9.5" Foreground="#FFEDD5"/>
                        <TextBlock Text="{Binding WifiInfo}" FontSize="9.5" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="Hotline: 1900 8888" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
