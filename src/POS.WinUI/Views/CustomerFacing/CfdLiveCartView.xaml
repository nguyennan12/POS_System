<UserControl x:Class="POS.WinUI.Views.CustomerFacing.CfdLiveCartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:POS.WinUI.ViewModels.CustomerFacing"
             xmlns:comp="clr-namespace:POS.WinUI.Views.CustomerFacing.Components"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920"
             d:DataContext="{d:DesignInstance vm:CfdLiveCartViewModel}">

    <UserControl.Resources>
        <!-- Style cho ScrollViewer -->
        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </UserControl.Resources>

    <!-- ════════════════════ 1920x1080 SPLIT SCREEN: LEFT 65% (CART) / RIGHT 35% (INFO) ════════════════════ -->
    <Grid Background="#EA580C">
        <Grid.ColumnDefinitions>
            <!-- Left Side: Live Cart & Bill Summary (60%) -->
            <ColumnDefinition Width="60*"/>
            <!-- Right Side: Store Branding, VIP Loyalty & Payment Hub (40%) -->
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Unified Background -->
        <Image Grid.Column="0" Grid.ColumnSpan="2"
               Source="pack://application:,,,/Resources/Assets/bg_cfd_unified.png" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- ════════════════════ LEFT SIDE: LIVE CART ITEMS & BILL SUMMARY ════════════════════ -->
        <Grid Grid.Column="0" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <!-- 1. Header: Live Cart Title -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Latest Scanned Item Highlight (Banner) -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Cart Items Table Area -->
                <RowDefinition Height="*"/>
                <!-- 4. Grand Total Summary Footer (White Card) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Border HorizontalAlignment="Left" 
                        Background="#FFFFFF" 
                        BorderBrush="#FED7AA" 
                        BorderThickness="1.5" 
                        CornerRadius="14" 
                        Padding="14,7">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.08" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#10B981" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="🛒 GIỎ HÀNG THANH TOÁN" FontSize="12.5" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="8,2.5" Margin="10,0,0,0">
                            <TextBlock Text="{Binding TotalItems, StringFormat='{}{0} món'}" FontSize="11.5" FontWeight="Black" Foreground="#B45309"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Latest Scanned Item Highlight Bar -->
            <Border Grid.Row="1" 
                    Background="#FFFFFF" 
                    BorderBrush="#FDE68A" 
                    BorderThickness="1.5" 
                    CornerRadius="14" 
                    Padding="14,9" 
                    Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.08" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="6,3" Margin="0,0,8,0">
                            <TextBlock Text="⚡ Mới quét" FontSize="11" FontWeight="Black" Foreground="#B45309"/>
                        </Border>

                        <!-- Mini Thumbnail món vừa quét -->
                        <Border Width="28" Height="28" 
                                CornerRadius="6" 
                                Background="#F8FAFC" 
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Margin="0,0,8,0" 
                                ClipToBounds="True"
                                Visibility="{Binding LatestItem.ImageUrl, Converter={StaticResource NullOrEmptyToVis}}">
                            <Image Source="{Binding LatestItem.ImageUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Text="{Binding LatestItem.Name, TargetNullValue='Đang chờ quét sản phẩm...'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LatestItem.Unit, StringFormat='({0})', TargetNullValue=''}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding LatestItem.Price, StringFormat='{}{0:N0} đ', TargetNullValue=''}" FontSize="12.5" FontWeight="Black" Foreground="#EA580C" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LatestItem.Quantity, StringFormat='x{0}', TargetNullValue=''}" FontSize="13" FontWeight="Black" Foreground="#B45309" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Cart Table Card -->
            <Border Grid.Row="2" 
                    Background="#FFFFFF" 
                    BorderBrush="#F1F5F9" 
                    BorderThickness="1.5" 
                    CornerRadius="20" 
                    Padding="16,14" 
                    Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#0F172A" Opacity="0.08" ShadowDepth="3" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Table Column Headers -->
                        <RowDefinition Height="Auto"/>
                        <!-- Table Rows -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SẢN PHẨM" FontSize="11" FontWeight="Black" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="ĐVT" FontSize="11" FontWeight="Black" Foreground="#475569" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="ĐƠN GIÁ" FontSize="11" FontWeight="Black" Foreground="#475569" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="SL" FontSize="11" FontWeight="Black" Foreground="#475569" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="THÀNH TIỀN" FontSize="11" FontWeight="Black" Foreground="#475569" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,11" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Product Info with Thumbnail Image -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Image Frame -->
                                                <Border Grid.Column="0" 
                                                        Width="48" Height="48" 
                                                        CornerRadius="10" 
                                                        Background="#F8FAFC" 
                                                        BorderBrush="#E2E8F0" 
                                                        BorderThickness="1" 
                                                        Margin="0,0,12,0" 
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ImageUrl}" 
                                                           Stretch="Uniform" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding ImageUrl, Converter={StaticResource NullOrEmptyToVis}}"/>
                                                </Border>

                                                <!-- Product Name & SKU -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sku, StringFormat='Mã: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- ĐVT (Unit) -->
                                            <Border Grid.Column="1" 
                                                    Background="#F1F5F9" 
                                                    CornerRadius="6" 
                                                    Padding="6,2.5" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Unit}" FontSize="11.5" FontWeight="Bold" Foreground="#475569"/>
                                            </Border>

                                            <!-- Unit Price -->
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Price, StringFormat='{}{0:N0} đ'}" 
                                                       FontSize="13" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#334155" 
                                                       TextAlignment="Right" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Quantity Capsule -->
                                            <Border Grid.Column="3" 
                                                    Background="#FEF3C7" 
                                                    CornerRadius="7" 
                                                    Padding="7,3" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="12" FontWeight="Black" Foreground="#92400E"/>
                                            </Border>

                                            <!-- Total Amount -->
                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding TotalAmount, StringFormat='{}{0:N0} đ'}" 
                                                       FontSize="14.5" 
                                                       FontWeight="Black" 
                                                       Foreground="#EA580C" 
                                                       TextAlignment="Right" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. Grand Total Summary Footer Card (Modern White Theme) -->
            <Border Grid.Row="3" 
                    Background="#FFFFFF" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1.5" 
                    CornerRadius="20" 
                    Padding="22,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#0F172A" Opacity="0.09" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Sub-details (Subtotal, Discount) -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Tạm tính: " FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>

                            <!-- Voucher Discount (if any) -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasVoucherDiscount, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0">
                                <TextBlock Text="• Voucher: " FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                                <TextBlock Text="{Binding VoucherDiscount, StringFormat='-{0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>

                            <!-- Loyalty Points Discount (if any) -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0">
                                <TextBlock Text="• Trừ điểm: " FontSize="12.5" Foreground="#64748B" FontWeight="Medium"/>
                                <TextBlock Text="{Binding PointsDiscount, StringFormat='-{0:N0} đ'}" FontSize="13" FontWeight="Bold" Foreground="#EA580C"/>
                                <TextBlock Text="{Binding PointsUsed, StringFormat=' ({0:#,##0.##} điểm)'}" FontSize="11" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="✨ Quét mã QR bên phải để tích điểm thành viên OraClub" 
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#EA580C"
                                   Visibility="{Binding HasCustomerInfo, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBlock Text="{Binding CustomerName, StringFormat='👑 Thành viên OraClub: {0}'}" 
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#16A34A"
                                   Visibility="{Binding HasCustomerInfo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Big Grand Total -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="TỔNG TIỀN THANH TOÁN" FontSize="11" FontWeight="Black" Foreground="#64748B" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} đ'}" 
                                   FontSize="32" 
                                   FontWeight="Black" 
                                   Foreground="#EA580C" 
                                   HorizontalAlignment="Right" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════ RIGHT SIDE: BRAND, ORACLUB & MEMBERSHIP HUB (When NOT in Payment Mode) ════════════════════ -->
        <comp:CfdLoyaltyHubControl Grid.Column="1" Visibility="{Binding IsPaymentMode, Converter={StaticResource InverseBoolToVis}}"/>

        <!-- ════════════════════ RIGHT SIDE: ACTIVE PAYMENT METHOD HUB (When IN Payment Mode) ════════════════════ -->
        <comp:CfdPaymentHubControl Grid.Column="1" Visibility="{Binding IsPaymentMode, Converter={StaticResource BoolToVis}}"/>

        <!-- Ambient Soft Diagonal Light Sweep (Topmost Layer) -->
        <comp:CfdAmbientSweepOverlay Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="999"/>
    </Grid>
</UserControl>
