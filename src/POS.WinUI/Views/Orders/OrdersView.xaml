<UserControl x:Class="POS.WinUI.Views.Orders.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shared="clr-namespace:POS.WinUI.Views.Shared"
             Loaded="OnLoaded" SizeChanged="OnSizeChanged" PreviewKeyDown="OnPreviewKeyDown"
             Foreground="{StaticResource TextPrimaryBrush}" Focusable="True">
    <UserControl.Resources>
        <Style x:Key="InvoiceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InvoiceSecondaryButton" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="InvoicePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="18,0"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource InputBorderBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="InvoiceColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,14"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        </Style>
        <Style x:Key="InvoiceCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InvoiceRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="MinHeight" Value="63"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource InputBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsReprintOpen, Converter={StaticResource InverseBoolConverter}}">
            <StackPanel Margin="24,20,24,24">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Receipt24" FontSize="26" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/><TextBlock Text="Hóa đơn &amp; In lại" FontSize="28" FontWeight="Bold"/></StackPanel>
                        <TextBlock Text="Tra cứu giao dịch đã hoàn tất, xem chi tiết và in lại bản sao." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="38,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="12,7" VerticalAlignment="Top" Margin="12,4,0,0"><TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/></Border>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Hóa đơn phù hợp -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="HÓA ĐƠN PHÙ HỢP" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalCountText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2: Tổng tiền trang này -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TỔNG DOANH THU TRANG" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding PageTotalText}" FontSize="22" FontWeight="Bold" Foreground="#EB7F0E" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#FFF7ED" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Money24" FontSize="16" Foreground="#EB7F0E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 3: Đang hiển thị -->
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ĐANG HIỂN THỊ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding VisibleCountText}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="#ECFDF5" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Eye24" FontSize="16" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                    <TextBlock Text="{Binding BannerText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Hàng 1: Ô tìm kiếm + Nút hành động -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <shared:TextInputField Height="38" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Icon="Search24" PlaceholderText="Nhập mã hóa đơn hoặc số điện thoại khách hàng..." EnterCommand="{Binding ApplyFiltersCommand}" ShowClearButton="True"/>
                            <Button Grid.Column="1" Command="{Binding ApplyFiltersCommand}" Background="#EB7F0E" Foreground="#FFFFFF" FontWeight="Bold" Height="38" Padding="16,0" Cursor="Hand" Margin="8,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Search24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                                <TextBlock Text="Tìm kiếm" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ClearFiltersCommand}" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" Height="38" Padding="14,0" Cursor="Hand" Margin="8,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Đặt lại" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Hàng 2: Bộ lọc ngày + Phương thức thanh toán + Phím tắt -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Từ ngày" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding FromDate}" SelectedDateFormat="Short" Height="34" FontSize="11.5" AutomationProperties.Name="Từ ngày"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Đến ngày" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding ToDate}" SelectedDateFormat="Short" Height="34" FontSize="11.5" AutomationProperties.Name="Đến ngày"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Phương thức thanh toán" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentFilter}" Height="34" FontSize="11.5" AutomationProperties.Name="Phương thức thanh toán"/>
                            </StackPanel>

                            <Button Grid.Column="6" Content="Hôm nay" Command="{Binding FilterTodayCommand}" Height="34" Padding="12,0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Bottom" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="8" Content="7 ngày qua" Command="{Binding FilterWeekCommand}" Height="34" Padding="12,0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Bottom" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding FilterError}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding FilterError, Converter={StaticResource NullOrEmptyToVis}}"/>
                    </StackPanel>
                </Border>
                <Grid x:Name="Body" MinHeight="560">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="1.35*"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="ListCard" Style="{StaticResource InvoiceCard}" Margin="0,0,16,0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="16,16,16,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Lịch sử hóa đơn" FontSize="16" FontWeight="Bold"/><TextBlock Text="Chọn một hóa đơn để xem chi tiết" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource InputBackgroundBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Top"><TextBlock Text="{Binding ResultCountText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/></Border>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Visibility="{Binding HasInvoices, Converter={StaticResource BoolToVis}}"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                                      Background="{StaticResource CardBackgroundBrush}" RowStyle="{StaticResource InvoiceRow}" CellStyle="{StaticResource InvoiceCell}"
                                      ColumnHeaderStyle="{StaticResource InvoiceColumnHeader}" FontSize="12" AutomationProperties.Name="Danh sách hóa đơn">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="HÓA ĐƠN &amp; KHÁCH HÀNG" Width="*" MinWidth="230">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding InvoiceNo}" FontWeight="SemiBold" FontSize="11.5"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding BuyerName}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text=" · " Foreground="{StaticResource TextPlaceholderBrush}"/><TextBlock Text="{Binding BuyerPhone}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="NGÀY LẬP" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DateText}"/><TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="TỔNG TIỀN" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding GrandTotalText}" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="Đã thanh toán" FontSize="10" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="Đang tải hóa đơn…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            <Border Grid.Row="1" Margin="20" Padding="20" Background="{StaticResource CardBackgroundBrush}" Visibility="{Binding ListError, Converter={StaticResource NullOrEmptyToVis}}">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Không tải được danh sách hóa đơn" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding ListError}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DangerTextBrush}" Margin="0,12"/><Button Content="Thử lại" Command="{Binding RefreshCommand}" Style="{StaticResource InvoiceSecondaryButton}" HorizontalAlignment="Center"/></StackPanel>
                            </Border>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Margin="24">
                                <Border Width="52" Height="52" CornerRadius="26" Background="#F1F5F9" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Receipt24" FontSize="24" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Không tìm thấy hóa đơn phù hợp" FontSize="15" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <TextBlock Text="Thử tìm kiếm với mã hóa đơn khác, số điện thoại hoặc mở rộng khoảng ngày lọc." TextWrapping="Wrap" TextAlignment="Center" Foreground="#64748B" FontSize="12" Margin="0,4,0,16" MaxWidth="320"/>
                                <Button Command="{Binding ClearFiltersCommand}"
                                        Background="#FFFFFF" BorderBrush="#EB7F0E" BorderThickness="1" Foreground="#EB7F0E"
                                        FontWeight="SemiBold" Height="36" Padding="16,0" Cursor="Hand" HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Xóa bộ lọc tìm kiếm" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource InputBorderBrush}" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Width="36" Command="{Binding PreviousPageCommand}" Style="{StaticResource InvoiceSecondaryButton}" ToolTip="Trang trước"/><TextBlock Text="{Binding PageText}" VerticalAlignment="Center" FontSize="11" Margin="8,0"/><Button Content="›" Width="36" Command="{Binding NextPageCommand}" Style="{StaticResource InvoiceSecondaryButton}" ToolTip="Trang sau"/></StackPanel>
                                    <TextBlock Text="{Binding RangeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource InvoiceCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="20">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="● Đã thanh toán" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="Chi tiết hóa đơn" FontSize="16" FontWeight="Bold"/></DockPanel>
                                    <TextBlock Text="{Binding SelectedDetail.InvoiceNo}" FontSize="16" FontWeight="Bold" Margin="0,20,0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedDetail.IssuedAtText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <Border Background="{StaticResource InputBackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,16,0,16">
                                        <StackPanel>
                                            <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedDetail.BuyerName}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedDetail.BuyerPhone}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Thu ngân" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedDetail.CashierName}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="Thanh toán" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedDetail.PaymentMethod}" FontSize="12"/></StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel Margin="0,0,0,10"><TextBlock Text="{Binding SelectedDetail.ItemCountText}" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBlock Text="Sản phẩm" FontWeight="SemiBold" FontSize="13"/></DockPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedDetail.Items}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource InputBorderBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###} × }" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding UnitPriceText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid></Border>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                        <TextBlock Text="Tạm tính" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding SelectedDetail.SubtotalText}" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="Giảm giá" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDetail.DiscountText}" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Text="Thuế" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDetail.TaxText}" FontSize="12" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="3" Text="Tổng thanh toán" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDetail.GrandTotalText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedDetail.ReprintText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVis}}" Margin="24"><ui:SymbolIcon Symbol="Receipt24" FontSize="42" Foreground="{StaticResource TextPlaceholderBrush}"/><TextBlock Text="Chọn hóa đơn để xem chi tiết" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel>
                            <TextBlock Text="Đang tải chi tiết…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Margin="24" VerticalAlignment="Center" Visibility="{Binding DetailError, Converter={StaticResource NullOrEmptyToVis}}"><TextBlock Text="{Binding DetailError}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DangerTextBrush}"/><Button Content="Tải lại chi tiết" Command="{Binding RetryDetailCommand}" Style="{StaticResource InvoiceSecondaryButton}" Margin="0,16,0,0" HorizontalAlignment="Center"/></StackPanel>
                            <Border Grid.Row="1" Padding="16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource InputBorderBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Xuất PDF" Command="{Binding PreviewPdfCommand}" Style="{StaticResource InvoiceSecondaryButton}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Command="{Binding OpenReprintCommand}" Style="{StaticResource InvoicePrimaryButton}" ToolTip="In lại hóa đơn (Ctrl+P)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Print24" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="In lại hóa đơn" VerticalAlignment="Center"/></StackPanel></Button>
                            </Grid></Border>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Text="Mọi bản in lại đều được đánh dấu BẢN SAO / REPRINT để phân biệt với hóa đơn gốc." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Visibility="{Binding IsReprintOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
            <Border Background="{StaticResource TextPrimaryBrush}" Opacity="0.4"/>
            <Border x:Name="ReprintDialog" Style="{StaticResource InvoiceCard}" Margin="24" MaxWidth="900" MaxHeight="760" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="24,20"><Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseReprintCommand}" Style="{StaticResource InvoiceSecondaryButton}" Width="44" ToolTip="Đóng (Esc)"/><StackPanel><TextBlock Text="{Binding DialogTitle}" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding OutputInvoice.InvoiceNo}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsOutputBusy, Converter={StaticResource InverseBoolConverter}}">
                        <Grid Margin="24,0,24,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="TÙY CHỌN BẢN SAO" Style="{StaticResource Caption}" FontWeight="Bold"/>
                                <TextBlock Text="PDF A4 · Có dấu BẢN SAO / REPRINT" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="{Binding IsPdfPreview, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Visibility="{Binding IsPdfPreview, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Máy in" Style="{StaticResource Caption}" Margin="0,18,0,6"/><ComboBox ItemsSource="{Binding PrinterOptions}" SelectedItem="{Binding SelectedPrinter}" Height="44" AutomationProperties.Name="Máy in"/>
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Khổ giấy (mm)" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding PaperWidths}" SelectedItem="{Binding PaperWidth}" Height="44" AutomationProperties.Name="Khổ giấy"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Số bản" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding CopyOptions}" SelectedItem="{Binding Copies}" Height="44" AutomationProperties.Name="Số bản in"/></StackPanel>
                                </Grid>
                                </StackPanel>
                                <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,22,0,0"><StackPanel><TextBlock Text="BẢN SAO / REPRINT" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="13"/><TextBlock Text="Nhãn bản sao luôn xuất hiện trên hóa đơn in lại và bản PDF." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
                                <TextBlock Text="{Binding OutputHint}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding OutputError}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding OutputError, Converter={StaticResource NullOrEmptyToVis}}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SegmentedBackgroundBrush}" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="XEM TRƯỚC PHIẾU IN" Style="{StaticResource Caption}" HorizontalAlignment="Center" FontSize="10"/>
                                    <Border Background="{StaticResource CardBackgroundBrush}" Padding="18" Width="{Binding ReceiptWidth}" HorizontalAlignment="Center" MaxWidth="320">
                                        <StackPanel TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource TextPrimaryBrush}">
                                            <TextBlock Text="OraPOS" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding OutputInvoice.StoreName}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding OutputInvoice.StoreAddress}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="HÓA ĐƠN BÁN LẺ" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,8"/>
                                            <Border BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="1" Padding="8,6"><TextBlock Text="BẢN SAO / REPRINT" FontWeight="Bold" TextAlignment="Center"/></Border>
                                            <TextBlock Text="{Binding OutputInvoice.InvoiceNo}" TextAlignment="Center" FontSize="10" Margin="0,12,0,4" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding OutputInvoice.IssuedAtText}" TextAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="{Binding OutputInvoice.BuyerName, StringFormat=Khách: {0}}" Margin="0,12,0,4" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding OutputInvoice.CashierName, StringFormat=Thu ngân: {0}}" TextWrapping="Wrap"/>
                                            <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
                                            <ItemsControl ItemsSource="{Binding OutputInvoice.Items}"><ItemsControl.ItemTemplate><DataTemplate>
                                                <StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding ProductName}" TextWrapping="Wrap" FontSize="10"/><DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontSize="10"/><TextBlock Text="{Binding Quantity, StringFormat=SL: {0:0.###}}" FontSize="10"/></DockPanel></StackPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                                            <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" Text="{Binding OutputInvoice.SubtotalText}"/><TextBlock Text="Tạm tính"/></DockPanel>
                                            <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" Text="{Binding OutputInvoice.DiscountText}"/><TextBlock Text="Giảm giá"/></DockPanel>
                                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding OutputInvoice.TaxText}"/><TextBlock Text="Thuế"/></DockPanel>
                                            <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding OutputInvoice.GrandTotalText}" FontWeight="Bold"/><TextBlock Text="TỔNG CỘNG" FontWeight="Bold"/></DockPanel>
                                            <TextBlock Text="{Binding OutputInvoice.PaymentMethod}" TextAlignment="Center" Margin="0,4,0,12"/><TextBlock Text="Cảm ơn và hẹn gặp lại!" TextAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="{Binding ModeLabel}" TextAlignment="Center" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource InputBorderBrush}" Padding="24,16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Command="{Binding CloseReprintCommand}" Style="{StaticResource InvoiceSecondaryButton}" MinWidth="84" Margin="0,0,10,0"/><Button Content="{Binding DialogActionText}" Command="{Binding ConfirmOutputCommand}" Style="{StaticResource InvoicePrimaryButton}"/></StackPanel></Border>
                </Grid>
            </Border>
        </Grid>
        <shared:ToastNotification Message="{Binding ToastMessage}" ToastType="{Binding ToastType}" VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="20"/>
    </Grid>
</UserControl>
