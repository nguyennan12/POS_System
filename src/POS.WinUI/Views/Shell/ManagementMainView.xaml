<UserControl x:Class="POS.WinUI.Views.Shell.ManagementMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:components="clr-namespace:POS.WinUI.Views.Shell.Components"
             xmlns:sharedComp="clr-namespace:POS.WinUI.Views.Shared.Components"
             xmlns:dashboard="clr-namespace:POS.WinUI.Views.Dashboard"
             xmlns:dashVm="clr-namespace:POS.WinUI.ViewModels.Dashboard"
             xmlns:orders="clr-namespace:POS.WinUI.Views.Orders"
             xmlns:ordersVm="clr-namespace:POS.WinUI.ViewModels.Orders"
             xmlns:products="clr-namespace:POS.WinUI.Views.Products"
             xmlns:productsVm="clr-namespace:POS.WinUI.ViewModels.Products"
             xmlns:inventory="clr-namespace:POS.WinUI.Views.Inventory"
             xmlns:inventoryVm="clr-namespace:POS.WinUI.ViewModels.Inventory"
             xmlns:customers="clr-namespace:POS.WinUI.Views.Customers"
             xmlns:customersVm="clr-namespace:POS.WinUI.ViewModels.Customers"
             xmlns:promotions="clr-namespace:POS.WinUI.Views.Promotions"
             xmlns:promotionsVm="clr-namespace:POS.WinUI.ViewModels.Promotions"
             xmlns:employees="clr-namespace:POS.WinUI.Views.Employees"
             xmlns:employeesVm="clr-namespace:POS.WinUI.ViewModels.Employees"
             xmlns:reports="clr-namespace:POS.WinUI.Views.Reports"
             xmlns:reportsVm="clr-namespace:POS.WinUI.ViewModels.Reports"
             xmlns:settings="clr-namespace:POS.WinUI.Views.Settings"
             xmlns:settingsVm="clr-namespace:POS.WinUI.ViewModels.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Focusable="True">

    <UserControl.Resources>
        <!-- Mapping 1-1 giữa ViewModel và View của 9 phân hệ quản lý -->
        <DataTemplate DataType="{x:Type dashVm:DashboardViewModel}">
            <dashboard:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ordersVm:OrdersViewModel}">
            <orders:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type productsVm:ProductsViewModel}">
            <products:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type inventoryVm:InventoryViewModel}">
            <inventory:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customersVm:CustomersViewModel}">
            <customers:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type promotionsVm:PromotionsViewModel}">
            <promotions:PromotionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type employeesVm:EmployeesViewModel}">
            <employees:EmployeesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type reportsVm:ReportsViewModel}">
            <reports:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
            <settings:SettingsView/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenPosCashierCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleSidebarCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="{StaticResource InputBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Body (Sidebar + Dynamic Sub-View Content) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ 1. TOP HEADER ════════════════════ -->
        <sharedComp:AppHeaderBar Grid.Row="0" IsPosMode="False" ShowSidebarToggle="True"/>

        <!-- ════════════════════ 2. MAIN BODY ═════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột 0: Sidebar Navbar (Thu/Phóng linh hoạt) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Cột 1: Vùng làm việc chính hiển thị Sub-View -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <components:ManagementSidebar Grid.Column="0"/>

            <!-- Main Work Area -->
            <Grid Grid.Column="1" Background="{StaticResource InputBackgroundBrush}">
                <Grid.RowDefinitions>
                    <!-- Row 0: Breadcrumb -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Sub-view Container động chuyển đổi theo SelectedTab -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Breadcrumb navigation -->
                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            Margin="28,16,28,0"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Home24" 
                                   FontSize="15" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   Margin="0,0,8,0" 
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="Trang chủ" 
                               FontSize="13" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="/" 
                               FontSize="13" 
                               Foreground="{StaticResource TextPlaceholderBrush}" 
                               Margin="8,0" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveTabTitle}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Vùng hiển thị Sub-View của Tab được chọn -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentTabViewModel}" 
                                    HorizontalContentAlignment="Stretch" 
                                    VerticalContentAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ════════════════════ 3. BOTTOM FOOTER ════════════════════ -->
        <sharedComp:AppFooterBar Grid.Row="2" IsPosMode="False"/>
    </Grid>
</UserControl>
