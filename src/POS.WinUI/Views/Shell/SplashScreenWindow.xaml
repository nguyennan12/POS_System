<Window x:Class="POS.WinUI.Views.Shell.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OraPOS"
        Width="460"
        Height="290"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <!-- Card nổi bo góc 28px chuẩn OraPOS Design System -->
    <Border Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="28"
            BorderBrush="{StaticResource InputBorderBrush}"
            BorderThickness="1"
            Margin="16"
            Padding="32,28">
        <Border.Effect>
            <!-- DropShadow soft tông ấm #1E0A02 -->
            <DropShadowEffect BlurRadius="36" Color="#1E0A02" Opacity="0.18" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cụm Logo + Thương hiệu trung tâm -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="100" Height="100" HorizontalAlignment="Center">
                    <!-- Vùng sáng Ambient Glow khuếch tán phía sau -->
                    <Ellipse Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#45ED7A1C" Offset="0.0"/>
                                <GradientStop Color="#18ED7A1C" Offset="0.55"/>
                                <GradientStop Color="#00ED7A1C" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Logo với hiệu ứng Breathing (nhịp thở 60fps tinh tế) -->
                    <Image Source="/Resources/Assets/logo.png" Width="76" Height="76"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0.96" To="1.04"
                                                         Duration="0:0:1.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.96" To="1.04"
                                                         Duration="0:0:1.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Grid>

                <TextBlock Text="OraPOS" FontSize="28" FontWeight="Black"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                
                <TextBlock Text="Quầy Thu Ngân • Retail POS" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Thanh Loading vô tận màu cam ở đáy card -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <!-- Thanh Progress mỏng chạy sóng mượt mà -->
                <ProgressBar IsIndeterminate="True" Height="4"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="{StaticResource SegmentedBackgroundBrush}"
                             BorderThickness="0"/>
                
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="TxtStatus" Text="Đang khởi động..." FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextPlaceholderBrush}"/>
                    <TextBlock Text="v1.0.0" HorizontalAlignment="Right" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource TextPlaceholderBrush}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
