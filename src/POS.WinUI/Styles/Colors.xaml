<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. BẢNG MÃ MÀU GỐC TẬP TRUNG (BRAND BASE COLORS)          -->
    <Color x:Key="BrandPrimaryColor">#ED7A1C</Color>
    <Color x:Key="BrandHoverColor">#D6680D</Color>
    <Color x:Key="BrandPressedColor">#B75304</Color>
    <Color x:Key="BrandLightColor">#FFF7ED</Color>
    <Color x:Key="BrandBorderColor">#FDD8B3</Color>
    <Color x:Key="BrandGlowColor">#F38D38</Color>

    <!-- Trạng thái (Status Colors) -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessGlowColor">#34D399</Color>
    <Color x:Key="GoldAccentColor">#FDE047</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerTextColor">#B91C1C</Color>
    <Color x:Key="DangerBgColor">#FEF2F2</Color>
    <Color x:Key="DangerBorderColor">#FECACA</Color>

    <!-- 2. CỌ VẼ THƯƠNG HIỆU (SOLID COLOR BRUSHES)                -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource BrandPressedColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource BrandLightColor}" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource BrandBorderColor}" />

    <!-- Cọ Trạng thái -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessGlowBrush" Color="{StaticResource SuccessGlowColor}" />
    <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldAccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />

    <!-- Cọ Nền & Khung (Surfaces & Borders) -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SegmentedBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="GlassOverlayBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#4DFFFFFF" />

    <!-- Cọ Chữ & Văn bản (Typography) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextWhiteSoftBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextWhiteMutedBrush" Color="#E2E8F0" />

</ResourceDictionary>
