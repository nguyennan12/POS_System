<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:POS.WinUI.Converters">

    <converters:BoolToVisibilityConverter    x:Key="BoolToVis" />
    <converters:BoolToVisibilityConverter    x:Key="InverseBoolToVis"          Invert="True" />
    <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis" />
    <converters:NullOrEmptyToVisibilityConverter x:Key="InverseNullOrEmptyToVis" Invert="True" />
    <converters:RoleToVisibilityConverter        x:Key="RoleToVis" />
    <converters:RoleToVisibilityConverter        x:Key="InverseRoleToVis"          Invert="True" />
    <converters:PermissionToVisibilityConverter  x:Key="PermissionToVis" />
    <converters:PermissionToVisibilityConverter  x:Key="InversePermissionToVis"    Invert="True" />

</ResourceDictionary>
